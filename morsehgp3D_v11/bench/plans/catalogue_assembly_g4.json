{
  "schema": "ehgp.v11.session_plan.v1",
  "note": "G4 gardee3600s : qualification puis ablation36K5 entiers, assemblage serie/parallele avec front fixe/adaptatif. Matrice850+ASan18 180+banc530=1560s ; reemploi facultatif de resumes apres SHA256 complet, aucun chrono FULL ou GPU. Archive plafonnee a16MiB ; aucun tronquage rendu conforme.",
  "default_build": false,
  "python_packages": "none",
  "results_cap_bytes": 16777216,
  "commands": [
    {
      "name": "matrice",
      "timeout_seconds": 850,
      "argv": [
        "python3",
        "{src}/morsehgp3D_v11/tools/g4_matrix.py",
        "--src",
        "{src}",
        "--out",
        "{out}",
        "--data",
        "{data}",
        "--work",
        "{build}/matrix",
        "--budget-seconds",
        "800"
      ]
    },
    {
      "name": "asan18",
      "timeout_seconds": 180,
      "argv": [
        "python3",
        "{src}/morsehgp3D_v11/tools/g4_matrix.py",
        "--src",
        "{src}",
        "--out",
        "{out}",
        "--data",
        "{data}",
        "--work",
        "{build}/asan18_matrix",
        "--matrix",
        "{src}/morsehgp3D_v11/bench/meb_asan18_matrix.json",
        "--budget-seconds",
        "160"
      ]
    },
    {
      "name": "assembly",
      "timeout_seconds": 530,
      "argv": [
        "python3",
        "{src}/morsehgp3D_v11/bench/catalogue_assembly.py",
        "--builds",
        "{build}/matrix",
        "--data",
        "{data}",
        "--out",
        "{out}",
        "--work",
        "{build}/assembly_measurements",
        "--qualification",
        "{out}/../../000_matrice/files/matrix/summary.json",
        "--supplement",
        "{out}/../../001_asan18/files/matrix/summary.json",
        "--budget-seconds",
        "450",
        "--reuse-semantic"
      ]
    }
  ]
}
