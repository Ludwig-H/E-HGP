{
  "schema": "ehgp.v11.g4_matrix.v1",
  "note": "Complement ASan/UBSan18 de num ET index : portes numeriques/bornes et index, dependances cloud/core compilees ; aucune mesure de performance.",
  "source_dir": "morsehgp3D_v11",
  "budget_seconds": 360,
  "thread_budget": 12,
  "limits": {
    "log_bytes": 1048576,
    "excerpt_lines": 40,
    "excerpt_line_chars": 400,
    "failures_listed": 100
  },
  "configurations": [
    {
      "name": "gcc_asan_ubsan18",
      "description": "Index exact18 bits sous ASan/UBSan, oracles Fraction et portes transactionnelles natives.",
      "compiler": "g++",
      "sanitizer": "address,undefined",
      "cmake_options": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DMHGP11_SANITIZE=ON",
        "-DMHGP11_COORD_BITS=18",
        "-DMHGP11_MODULES=num;index"
      ],
      "ctest_args": [
        "-LE",
        "^mutant$",
        "-E",
        "^mhgp11_reference_"
      ],
      "threads": 12,
      "timeout_seconds": 360,
      "test_timeout_seconds": 120,
      "require_labels": [
        "unit"
      ],
      "env": {
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      },
      "min_tests": 36
    }
  ]
}
