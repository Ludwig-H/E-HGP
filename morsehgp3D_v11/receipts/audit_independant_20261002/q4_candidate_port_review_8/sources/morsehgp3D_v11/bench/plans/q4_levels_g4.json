{
  "schema": "ehgp.v11.session_plan.v1",
  "note": "Session G4 gardee de 3600 s : matrice 400 s, complement num ASan18 100 s, profils 1100 s, soit 1600 s de commandes. Au plus 36 unites natives de 30 s ; collecte et normalisation distinctes. Ce budget ne garantit pas tout le calendrier : un checkpoint interrompu est conserve sans faux succes. Trois commandes ferment leurs groupes. CPU catalogue, aucun FULL/GPU.",
  "default_build": false,
  "python_packages": "none",
  "results_cap_bytes": 67108864,
  "commands": [
    {
      "name": "matrice",
      "timeout_seconds": 400,
      "argv": [
        "python3",
        "{src}/morsehgp3D_v11/tools/g4_matrix.py",
        "--src",
        "{src}",
        "--out",
        "{out}",
        "--data",
        "{data}",
        "--work",
        "{build}/matrix",
        "--budget-seconds",
        "360"
      ]
    },
    {
      "name": "asan18",
      "timeout_seconds": 100,
      "argv": [
        "python3",
        "{src}/morsehgp3D_v11/tools/g4_matrix.py",
        "--src",
        "{src}",
        "--out",
        "{out}",
        "--data",
        "{data}",
        "--work",
        "{build}/asan18_matrix",
        "--matrix",
        "{src}/morsehgp3D_v11/bench/power_asan18_matrix.json",
        "--budget-seconds",
        "90"
      ]
    },
    {
      "name": "profiles",
      "timeout_seconds": 1100,
      "argv": [
        "python3",
        "{src}/morsehgp3D_v11/bench/catalogue_profiles.py",
        "--builds",
        "{build}/matrix",
        "--data",
        "{data}",
        "--out",
        "{out}",
        "--work",
        "{build}/profile_measurements",
        "--qualification",
        "{out}/../../000_matrice/files/matrix/summary.json",
        "--supplement",
        "{out}/../../001_asan18/files/matrix/summary.json"
      ]
    }
  ]
}
