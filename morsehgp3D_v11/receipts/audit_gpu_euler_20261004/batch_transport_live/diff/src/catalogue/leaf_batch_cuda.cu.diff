 template <class T>
 struct DeviceArray {
   T* data = nullptr;
+  BudgetReservation reservation;
+  DeviceArray() = default;
+  DeviceArray(const DeviceArray&) = delete;
+  DeviceArray& operator=(const DeviceArray&) = delete;
