diff --git a/morsehgp3D_v11/src/catalogue/leaf_device_split.hpp b/morsehgp3D_v11/src/catalogue/leaf_device_split.hpp
new file mode 100644
index 000000000..9c384229c
--- /dev/null
+++ b/morsehgp3D_v11/src/catalogue/leaf_device_split.hpp
@@ -0,0 +1,184 @@
+// Feuilles lourdes decoupees en taches de paires (voie GPU, levier D, 6 octobre 2026). Une feuille par fil laisse une
+// queue au noyau de comptage : la feuille la plus lourde de ng00 a K = 5 coute environ 13 fois la moyenne, sur un
+// seul fil. Ici, seules les feuilles dont le poids (paires de la profondeur 1) depasse un seuil sont differees
+// (kDeferred, rien publie) ; la profondeur 0 est jouee une fois par la preparation, qui range les tables de la feuille
+// et la liste de ses paires (i, j) dans l'ordre du parcours ; chaque paire est ensuite une tache independante, jouee par
+// un fil quelconque (corps d'extend<1> pour j seul, puis extend<2> et extend<3>, la boucle en ligne de leaf_device.hpp).
+// Preuve d'egalite (note aux auditeurs, section O, et run_leaf_split ci-dessous, juge par la porte leaf_split) :
+// - aucune emission a la profondeur 0 (q = 1) ; les emissions du sous-arbre d'une paire sont contigues dans l'ordre du
+//   parcours, donc la suite des emissions de la feuille est la concatenation de celles des paires dans l'ordre des
+//   paires, et des comptes par tache suivis d'un prefixe placent chaque emission a sa place exacte ;
+// - tous les compteurs sont des sommes sur les prefixes, sauf le cache J2 simule : evaluations = rangs distincts testes
+//   dans la feuille (union des memoires de toutes ses taches), succes = tests - evaluations, quel que soit l'ordre ;
+//   sans l'option cache, evaluations = tests ; dominance_tests est compte une fois, par la preparation ;
+// - un refus (kUnresolved) d'une tache rend toute la feuille non resolue : compteurs et emissions jetes, repli CPU.
+// La memoire J2 d'une tache (decisions) est la sienne : le predicat ne depend que du triplet et de la boite.
+#pragma once
+
+#include "catalogue/leaf_device.hpp"
+
+namespace mhgp11::leaf_device {
+
+using u16 = std::uint16_t;
+inline constexpr u32 kDeferred = 2;  // statut de comptage d'une feuille differee (jamais un statut final)
+inline constexpr u32 kMaxPairs = kMaxSites * (kMaxSites - 1) / 2;
+
+// Tables d'une feuille decoupee : ecrites par split_prepare, lues seulement par ses taches.
+struct SplitTables {
+  u32 m = 0, pairs = 0;
+  u32 P[kMaxSites][3];
+  u64 dom[kMaxSites], domby[kMaxSites], nbr[kMaxSites];
+  u64 live[3][kMaxSites];
+  u64 next[kMaxSites], logical[kMaxSites];  // candidats et ensemble logique de la profondeur 1 sous i
+  u16 pair[kMaxPairs];                      // (i << 8) | j, dans l'ordre du parcours
+};
+
+// Poids de la feuille : nombre de paires que la profondeur 0 rendrait (memes coupes qu'extend<0>, sans compteur).
+template <class Sink>
+MHGP11_LEAF_HD u32 pair_weight(const Leaf<Sink>& leaf) {
+  const u64 initial = leaf.m >= 64 ? ~u64(0) : (u64(1) << leaf.m) - 1;
+  u32 weight = 0;
+  for (u64 rest = initial; rest != 0; rest &= rest - 1) {
+    const u32 i = ctz(rest);
+    if (popc(leaf.dom[i]) > static_cast<u32>(leaf.in.kmax - 1)) continue;  // G3 ou arret avant la profondeur 1
+    weight += popc((rest & (rest - 1)) & leaf.live[0][i]);
+  }
+  return weight;
+}
+
+// run_leaf du comptage, avec report : une feuille de poids > split (split != 0) rend kDeferred avant tout parcours,
+// sans emission ni compteur publie. split = 0 : exactement run_leaf.
+template <class Sink>
+MHGP11_LEAF_HD u32 run_leaf_or_defer(const Input& in, Counts& counts, Sink& sink, u32 split) {
+  if (in.m == 0 || in.m > kMaxSites || in.kmax < 1) return kUnresolved;
+  Leaf<Sink> leaf(in, counts, sink);
+  leaf.prepare();
+  leaf.live_rows();
+  if (split != 0 && pair_weight(leaf) > split) return kDeferred;
+  const u64 initial = in.m >= 64 ? ~u64(0) : (u64(1) << in.m) - 1;
+  leaf.template extend<0>(initial, initial);
+  return leaf.unresolved ? kUnresolved : kOk;
+}
+
+struct NullSink {
+  MHGP11_LEAF_HD void emit(const Ball&, const u32*, const u32*, const u32*, const u32*) {}
+};
+
+// Preparation d'une feuille differee : tables (prepare, live_rows), puis profondeur 0 avec les memes coupes et les
+// memes compteurs qu'extend<0>, qui range les paires au lieu de descendre. counts recoit dominance_tests et les
+// prefixes de la profondeur 0. Faux si l'entree est hors domaine (la feuille est alors non resolue).
+MHGP11_LEAF_HD bool split_prepare(const Input& in, Counts& counts, SplitTables& t) {
+  if (in.m == 0 || in.m > kMaxSites || in.kmax < 1) return false;
+  NullSink none;
+  Leaf<NullSink> leaf(in, counts, none);
+  leaf.prepare();
+  leaf.live_rows();
+  t.m = leaf.m;
+  for (u32 i = 0; i < leaf.m; ++i) {
+    for (int a = 0; a < 3; ++a) t.P[i][a] = leaf.P[i][a];
+    t.dom[i] = leaf.dom[i]; t.domby[i] = leaf.domby[i]; t.nbr[i] = leaf.nbr[i];
+    for (int q = 0; q < 3; ++q) t.live[q][i] = leaf.live[q][i];
+    t.next[i] = t.logical[i] = 0;
+  }
+  const u64 initial = in.m >= 64 ? ~u64(0) : (u64(1) << in.m) - 1;
+  u32 n = 0;
+  u64 candidates = initial;
+  while (candidates != 0) {  // extend<0> : q = 1, seuil kmax >= 1, aucun appel q, profondeur 1 toujours admise
+    const u32 i = ctz(candidates);
+    candidates &= candidates - 1;
+    ++counts.prefixes;
+    const u32 count = popc(leaf.dom[i]);
+    if (count > static_cast<u32>(in.kmax)) continue;  // G3
+    const u64 next_logical = initial & (~u64(0) << (i + 1)) & leaf.nbr[i];
+    if (count > static_cast<u32>(in.kmax - 1)) {
+      counts.prefixes += popc(next_logical);
+      continue;
+    }
+    const u64 next = candidates & leaf.live[0][i];
+    counts.prefixes += popc(next_logical) - popc(next);
+    t.next[i] = next; t.logical[i] = next_logical;
+    for (u64 rest = next; rest != 0; rest &= rest - 1) t.pair[n++] = static_cast<u16>((i << 8) | ctz(rest));
+  }
+  t.pairs = n;
+  return true;
+}
+
+// Tache k de la feuille decoupee : tables relues (memoire J2 vierge), prefixe (i), puis le corps d'extend<1> pour j
+// seul avec les candidats restants apres j, et sa recursion. Rend kOk ou kUnresolved ; leaf.seen porte ensuite les
+// rangs J2 testes par la tache (option cache).
+template <class Sink>
+MHGP11_LEAF_HD void run_pair(Leaf<Sink>& leaf, const SplitTables& t, u32 k) {
+  leaf.m = t.m;
+  for (u32 i = 0; i < t.m; ++i) {
+    for (int a = 0; a < 3; ++a) leaf.P[i][a] = t.P[i][a];
+    leaf.dom[i] = t.dom[i]; leaf.domby[i] = t.domby[i]; leaf.nbr[i] = t.nbr[i];
+    for (int q = 0; q < 3; ++q) leaf.live[q][i] = t.live[q][i];
+  }
+  for (u32 w = 0; w < kSeenWords; ++w) leaf.seen[w] = leaf.meets[w] = 0;
+  const u32 i = t.pair[k] >> 8, j = t.pair[k] & 0xFFu;
+  leaf.prefix[0] = i;
+  leaf.masks[0] = 0;
+  leaf.masks[1] = leaf.dom[i];
+  const u64 remaining = t.next[i] & (~u64(0) << (j + 1));
+  leaf.template extend<1, true>((u64(1) << j) | remaining, t.logical[i]);
+}
+
+MHGP11_LEAF_HD void add_counts(Counts& total, const Counts& c) {
+  total.dominance_tests += c.dominance_tests; total.prefixes += c.prefixes; total.judged += c.judged;
+  total.census_tests += c.census_tests; total.emitted += c.emitted; total.incidences += c.incidences;
+  total.q4_candidates += c.q4_candidates; total.q4_levels += c.q4_levels;
+  total.region_pair_tests += c.region_pair_tests; total.region_pair_rejects += c.region_pair_rejects;
+  total.region_line_tests += c.region_line_tests; total.region_line_rejects += c.region_line_rejects;
+  total.region_line_evaluations += c.region_line_evaluations;
+  total.region_line_cache_hits += c.region_line_cache_hits;
+  total.region_line_fallbacks += c.region_line_fallbacks;
+}
+
+// Compteurs J2 de la feuille decoupee : rangs distincts de l'union des memoires des taches (option cache), ou tous les
+// tests sans elle. distinct = popc de l'union.
+MHGP11_LEAF_HD void split_line_counts(Counts& c, bool cache, u64 distinct) {
+  c.region_line_evaluations = cache ? distinct : c.region_line_tests;
+  c.region_line_cache_hits = c.region_line_tests - c.region_line_evaluations;
+}
+
+// Emulation hote complete d'une feuille decoupee (porte leaf_split) : preparation, taches comptees dans un ordre
+// permute (order premier avec le nombre de paires, sinon l'ordre inverse), union J2, puis emissions des taches dans
+// l'ordre des paires (compteurs de cette seconde passe jetes). Memes statut, compteurs et emissions que run_leaf.
+MHGP11_LEAF_HD u32 gcd(u32 a, u32 b) {
+  while (b != 0) {
+    const u32 r = a % b;
+    a = b; b = r;
+  }
+  return a;
+}
+template <class Sink>
+MHGP11_LEAF_HD u32 run_leaf_split(const Input& in, Counts& counts, Sink& sink, SplitTables& t, u32 order) {
+  Counts leaf_counts;
+  if (!split_prepare(in, leaf_counts, t)) return kUnresolved;
+  const u32 n = t.pairs;
+  if (order != 0 && gcd(order, n) != 1) order = 0;
+  u32 seen[kSeenWords] = {};
+  for (u32 step = 0; step < n; ++step) {
+    const u32 k = order == 0 ? n - 1 - step : static_cast<u32>((u64(order) * step + order) % n);
+    Counts task;
+    NullSink none;
+    Leaf<NullSink> lane(in, task, none);
+    run_pair(lane, t, k);
+    if (lane.unresolved) return kUnresolved;
+    add_counts(leaf_counts, task);
+    for (u32 w = 0; w < kSeenWords; ++w) seen[w] |= lane.seen[w];
+  }
+  u64 distinct = 0;
+  for (u32 w = 0; w < kSeenWords; ++w) distinct += popc(seen[w]);
+  split_line_counts(leaf_counts, in.cache, distinct);
+  for (u32 k = 0; k < n; ++k) {
+    Counts discarded;
+    Leaf<Sink> lane(in, discarded, sink);
+    run_pair(lane, t, k);
+    if (lane.unresolved) return kUnresolved;
+  }
+  add_counts(counts, leaf_counts);
+  return kOk;
+}
+
+}  // namespace mhgp11::leaf_device
