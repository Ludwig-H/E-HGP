+// Travail predit d'une feuille : couples vivants (live[0], i < j) plus triplets vivants (i < j < k, k dans live[1] de
+// i et de j) apres prepare et live_rows de la feuille source unique. Heuristique d'ordonnancement (voie hybride, ordre
+// des fils) : aucune decision du catalogue n'en depend. Sur lidar_ng00 K = 5, feuilles de 16 : rang de Spearman 0,93
+// contre les prefixes et tests de recensement reels (m seul : 0,67). Au plus C(32,2) + C(32,3) < 2^13.
+inline u32 predicted_work(const leaf_device::Input& in) noexcept {
+  leaf_device::Counts counts;
+  leaf_device::CountSink sink;
+  leaf_device::Leaf<leaf_device::CountSink> leaf(in, counts, sink);
+  leaf.prepare();
+  leaf.live_rows();
+  u32 work = 0;
+  for (u32 i = 0; i < leaf.m; ++i)
+    for (u64 pairs = leaf.live[0][i] & (~u64(0) << i << 1); pairs != 0; pairs &= pairs - 1) {
+      const u32 j = leaf_device::ctz(pairs);
+      work += 1 + leaf_device::popc(leaf.live[1][i] & leaf.live[1][j] & (~u64(0) << j << 1));
+    }
+  return work;
+}
