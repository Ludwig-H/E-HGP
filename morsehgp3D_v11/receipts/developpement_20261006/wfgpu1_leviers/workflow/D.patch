+// Puits sans effet : leaf_weight ne parcourt pas la feuille, seules ses tables servent.
+struct NoSink {
+  void emit(const leaf_device::Ball&, const u32*, const u32*, const u32*, const u32*) noexcept {}
+};
+
+struct Weigh {
+  const LeafBatchView& view;
+  std::span<u64> weights;
+  static Outcome body(void* context, u64 begin, u64 end, u32) noexcept {
+    const auto& self = *static_cast<const Weigh*>(context);
+    for (u64 j = begin; j < end; ++j) self.weights[j] = leaf_weight(input_of(self.view, self.view.jobs[j]));
+    return {};
+  }
+};
+
+// Feuilles par m decroissant, stable (tri par comptage sur 1..kMaxSites) : chaque warp recoit des feuilles de meme
+// taille. count < 2^32 (garde de thread_order).
+Outcome size_order(const LeafBatchView& view, std::span<u32> order) noexcept {
+  u64 start[leaf_device::kMaxSites + 2] = {};
+  for (u64 j = 0; j < view.count; ++j) {
+    if (view.jobs[j].m > leaf_device::kMaxSites) return fail(Reason::catalogue_invariant);
+    ++start[leaf_device::kMaxSites - view.jobs[j].m + 1];
+  }
+  for (u32 b = 1; b <= leaf_device::kMaxSites + 1; ++b) start[b] += start[b - 1];
+  for (u64 j = 0; j < view.count; ++j) order[start[leaf_device::kMaxSites - view.jobs[j].m]++] = static_cast<u32>(j);
+  return {};
+}
+
+// Warps complets de l'ordre par m, ranges par somme des poids decroissante (puis rang du warp) ; le dernier warp,
+// incomplet, reste en queue pour que la composition des autres ne glisse pas. out recoit l'ordre range.
+void warp_weight_order(std::span<const u32> order, std::span<const u64> weights, std::span<u64> sums,
+                       std::span<u32> ranks, std::span<u32> out) noexcept {
+  const u64 full = order.size() / kOrderWarp;
+  for (u64 w = 0; w < full; ++w) {
+    sums[w] = 0;
+    for (u64 p = w * kOrderWarp; p < (w + 1) * kOrderWarp; ++p) sums[w] += weights[order[p]];  // <= 32 * C(32, 3)
+    ranks[w] = static_cast<u32>(w);
+  }
+  std::sort(ranks.begin(), ranks.begin() + static_cast<std::ptrdiff_t>(full),
+            [&](u32 a, u32 b) { return sums[a] != sums[b] ? sums[a] > sums[b] : a < b; });
+  u64 at = 0;
+  for (u64 r = 0; r < full; ++r)
+    for (u64 p = ranks[r] * kOrderWarp; p < (ranks[r] + 1) * kOrderWarp; ++p) out[at++] = order[p];
+  for (u64 p = full * kOrderWarp; p < order.size(); ++p) out[at++] = order[p];
+}
+
+// Ordre diagnostique : poids sur le Pool, puis tri par poids ou par warps ; resultat controle (permutation).
+Outcome weighted_order(const LeafBatchView& view, sched::Pool& pool, MemoryBudget& budget, Buffer<u32>& order) noexcept {
+  const u64 warps = view.count / kOrderWarp;
+  Buffer<u64> weights, sums;
+  Buffer<u32> ranks, arranged;
+  Buffer<u8> seen;
+  MHGP11_TRY(weights.allocate(view.count, budget));
+  MHGP11_TRY(sums.allocate(warps, budget));
+  MHGP11_TRY(ranks.allocate(warps, budget));
+  MHGP11_TRY(arranged.allocate(view.count, budget));
+  MHGP11_TRY(seen.allocate(view.count, budget));
+  Weigh weigh{view, weights.span()};
+  if (view.count != 0) MHGP11_TRY(pool.parallel_for(view.count, 256, &weigh, Weigh::body));
+  if (view.order == kOrderWeight) {
+    std::sort(order.begin(), order.end(),
+              [&](u32 a, u32 b) { return weights[a] != weights[b] ? weights[a] > weights[b] : a < b; });
+  } else {
+    warp_weight_order(order.span(), weights.span(), sums.span(), ranks.span(), arranged.span());
+    order.swap(arranged);
+  }
+  for (auto& flag : seen.span()) flag = 0;
+  for (const u32 j : order.span()) {
+    if (j >= view.count || seen[j] != 0) return fail(Reason::catalogue_invariant);
+    seen[j] = 1;
+  }
+  return {};
+}
+
 }  // namespace
 
+u64 leaf_weight(const leaf_device::Input& in) noexcept {
+  using leaf_device::ctz;
+  using leaf_device::popc;
+  if (in.m == 0 || in.m > leaf_device::kMaxSites || in.kmax < 2) return 0;  // kmax < 2 : aucune profondeur 2
+  leaf_device::Counts counts;
+  NoSink none;
+  leaf_device::Leaf<NoSink> leaf(in, counts, none);
+  leaf.prepare();
+  leaf.live_rows();
+  const u32 first = static_cast<u32>(in.kmax - 1), second = static_cast<u32>(in.kmax - 2);
+  const u64 all = (u64(1) << in.m) - 1;  // m <= 32
+  u64 weight = 0;
+  for (u64 rest = all; rest != 0; rest &= rest - 1) {
+    const u32 i = ctz(rest);
+    if (popc(leaf.dom[i]) > first) continue;  // G3 de la profondeur 0, ou arret avant la profondeur 1
+    for (u64 next = (rest & (rest - 1)) & leaf.live[0][i]; next != 0; next &= next - 1) {
+      const u32 j = ctz(next);
+      if (popc(leaf.dom[i] | leaf.dom[j]) > second) continue;  // G3 de la profondeur 1, ou arret avant la 2
+      weight += popc((next & (next - 1)) & leaf.live[1][i] & leaf.live[1][j]);
+    }
+  }
+  return weight;
+}
+
+Outcome thread_order(const LeafBatchView& view, sched::Pool& pool, MemoryBudget& budget, Buffer<u32>& order) noexcept {
+  if (view.order > kOrderWarpWeight) return fail(Reason::parameter_out_of_range);
+  if (view.count >= kNoChunk) return fail(Reason::index_overflow_u32);  // rangs des feuilles en u32
+  u64 bytes = 0;
+  MHGP11_TRY(add_bytes<u32>(bytes, view.count));
+  if (view.order != kOrderSize) {
+    MHGP11_TRY(add_bytes<u64>(bytes, view.count));               // poids
+    MHGP11_TRY(add_bytes<u64>(bytes, view.count / kOrderWarp));  // sommes par warp
+    MHGP11_TRY(add_bytes<u32>(bytes, view.count / kOrderWarp));  // rangs des warps
+    MHGP11_TRY(add_bytes<u32>(bytes, view.count));               // ordre range
+    MHGP11_TRY(add_bytes<u8>(bytes, view.count));                // controle de permutation
+  }
+  MHGP11_TRY(budget.admit(bytes));
+  MHGP11_TRY(order.allocate(view.count, budget));
+  MHGP11_TRY(size_order(view, order.span()));
+  if (view.order == kOrderSize) return {};
+  return weighted_order(view, pool, budget, order);
+}
