+// Ordre des fils du lot de feuilles (leaf_batch.hpp, thread_order ; diagnostic du levier D du 6 octobre 2026) : poids
+// d'une feuille contre un decompte direct des triplets, puis les trois ordres (par m, par poids, warps par poids)
+// juges par leurs proprietes (permutation, cle monotone, departage par rang, warps entiers gardes), et les refus.
+#include <algorithm>
+#include <array>
+#include <random>
+#include <vector>
+
+#include "catalogue/leaf_batch.hpp"
+#include "sched/sched.hpp"
+#include "test.hpp"
+
+using namespace mhgp11;
+using namespace mhgp11::catalogue_detail;
+
+namespace {
+// Lot synthetique : 400 sites du cube 2^12, 1 000 feuilles (31 warps entiers et un warp de 8) de 1 a 32 sites
+// croissants, boite T0 tiree dans le cube ; graine fixe.
+struct Batch {
+  std::vector<u32> x, y, z, sites;
+  std::vector<LeafJob> jobs;
+  LeafBatchView view(int kmax, u8 order) const {
+    LeafBatchView v;
+    v.x = x.data(); v.y = y.data(); v.z = z.data(); v.cloud_sites = static_cast<u32>(x.size());
+    v.jobs = jobs.data(); v.count = jobs.size(); v.sites = sites.data(); v.site_count = sites.size();
+    v.kmax = kmax; v.cache = true; v.order = order;
+    return v;
+  }
+};
+
+Batch make_batch() {
+  std::mt19937 rng(20261006);
+  Batch b;
+  for (int i = 0; i < 400; ++i) {
+    b.x.push_back(rng() % 4096); b.y.push_back(rng() % 4096); b.z.push_back(rng() % 4096);
+  }
+  for (int j = 0; j < 1000; ++j) {
+    const u32 m = 1 + rng() % 32;
+    std::vector<u32> chosen;
+    while (chosen.size() < m) {
+      const u32 s = rng() % 400;
+      if (std::find(chosen.begin(), chosen.end(), s) == chosen.end()) chosen.push_back(s);
+    }
+    std::sort(chosen.begin(), chosen.end());
+    LeafJob job;
+    job.begin = b.sites.size(); job.m = m;
+    for (int a = 0; a < 3; ++a) {
+      job.lo[a] = rng() % 3072;
+      job.hi[a] = job.lo[a] + 1 + rng() % 1024;
+    }
+    b.sites.insert(b.sites.end(), chosen.begin(), chosen.end());
+    b.jobs.push_back(job);
+  }
+  return b;
+}
+
+leaf_device::Input input(const LeafBatchView& v, u64 j) {
+  leaf_device::Input in;
+  in.x = v.x; in.y = v.y; in.z = v.z; in.sites = v.sites + v.jobs[j].begin; in.m = v.jobs[j].m;
+  for (int a = 0; a < 3; ++a) { in.lo[a] = v.jobs[j].lo[a]; in.hi[a] = v.jobs[j].hi[a]; }
+  in.kmax = v.kmax; in.cache = v.cache;
+  return in;
+}
+
+// Decompte direct : triplets i < j < k ou i passe la profondeur 0 (popc dom <= kmax - 1), j est vivant pour i a la
+// profondeur 1, (i, j) passe la profondeur 1 (popc(dom i | dom j) <= kmax - 2), et k est vivant pour i a la profondeur 1
+// et pour i et j a la profondeur 2.
+struct Silent {
+  void emit(const leaf_device::Ball&, const u32*, const u32*, const u32*, const u32*) {}
+};
+u64 direct_weight(const leaf_device::Input& in) {
+  if (in.kmax < 2) return 0;
+  leaf_device::Counts counts;
+  Silent sink;
+  leaf_device::Leaf<Silent> leaf(in, counts, sink);
+  leaf.prepare();
+  leaf.live_rows();
+  const auto bit = [](u64 row, u32 k) { return ((row >> k) & 1u) != 0; };
+  u64 total = 0;
+  for (u32 i = 0; i < in.m; ++i)
+    for (u32 j = i + 1; j < in.m; ++j)
+      for (u32 k = j + 1; k < in.m; ++k) {
+        if (__builtin_popcountll(leaf.dom[i]) > in.kmax - 1 || !bit(leaf.live[0][i], j)) continue;
+        if (__builtin_popcountll(leaf.dom[i] | leaf.dom[j]) > in.kmax - 2) continue;
+        if (bit(leaf.live[0][i], k) && bit(leaf.live[1][i], k) && bit(leaf.live[1][j], k)) ++total;
+      }
+  return total;
+}
+}  // namespace
+
+MHGP11_TEST(weight_direct, 4000) {
+  const Batch b = make_batch();
+  u64 heavy = 0;
+  for (const int kmax : {1, 2, 5, 10}) {
+    const LeafBatchView v = b.view(kmax, kOrderSize);
+    for (u64 j = 0; j < v.count; ++j) {
+      const auto in = input(v, j);
+      const u64 w = leaf_weight(in);
+      CHECK_EQ(w, direct_weight(in));
+      heavy += w > 100;
+    }
+  }
+  CHECK(heavy >= 50);  // plancher : des feuilles lourdes, pas un vert par poids nuls
+}
+
+MHGP11_TEST(orders, 6000) {
+  const Batch b = make_batch();
+  auto made = sched::make_pool({4});
+  REQUIRE(made.ok());
+  MemoryBudget budget(MemoryBudget::kUnlimited);
+  for (const int kmax : {5, 10}) {
+    std::array<Buffer<u32>, 3> got;
+    for (u8 mode = 0; mode < 3; ++mode) {
+      const LeafBatchView v = b.view(kmax, mode);
+      REQUIRE(thread_order(v, *made.value(), budget, got[mode]).ok());
+      REQUIRE(got[mode].size() == v.count);
+      std::vector<u8> seen(v.count, 0);
+      for (const u32 j : got[mode].span()) {
+        REQUIRE(j < v.count && seen[j] == 0);
+        seen[j] = 1;
+      }
+    }
+    const LeafBatchView v = b.view(kmax, kOrderSize);
+    std::vector<u64> weight(v.count);
+    for (u64 j = 0; j < v.count; ++j) weight[j] = leaf_weight(input(v, j));
+    for (u64 p = 1; p < v.count; ++p) {
+      const u32 a = got[0][p - 1], c = got[0][p];  // par m decroissant, stable
+      CHECK(b.jobs[a].m > b.jobs[c].m || (b.jobs[a].m == b.jobs[c].m && a < c));
+      const u32 e = got[1][p - 1], f = got[1][p];  // par poids decroissant, puis rang
+      CHECK(weight[e] > weight[f] || (weight[e] == weight[f] && e < f));
+    }
+    // Warps entiers de l'ordre par m, par somme decroissante puis rang ; le warp incomplet reste en queue.
+    const u64 full = v.count / kOrderWarp;
+    u64 previous_sum = ~u64(0), previous_warp = 0;
+    std::vector<u8> used(full, 0);
+    for (u64 r = 0; r < full; ++r) {
+      const u32 first = got[2][r * kOrderWarp];
+      const auto at = std::find(got[0].begin(), got[0].end(), first) - got[0].begin();
+      REQUIRE(at % kOrderWarp == 0 && static_cast<u64>(at) / kOrderWarp < full);
+      const u64 w = static_cast<u64>(at) / kOrderWarp;
+      CHECK(used[w] == 0);
+      used[w] = 1;
+      u64 sum = 0;
+      for (u64 p = 0; p < kOrderWarp; ++p) {
+        CHECK_EQ(got[2][r * kOrderWarp + p], got[0][w * kOrderWarp + p]);
+        sum += weight[got[0][w * kOrderWarp + p]];
+      }
+      CHECK(r == 0 || sum < previous_sum || (sum == previous_sum && w > previous_warp));
+      previous_sum = sum; previous_warp = w;
+    }
+    for (u64 p = full * kOrderWarp; p < v.count; ++p) CHECK_EQ(got[2][p], got[0][p]);
+  }
+  CHECK(budget.released().ok());
+}
+
+MHGP11_TEST(refusals, 4) {
+  const Batch b = make_batch();
+  auto made = sched::make_pool({2});
+  REQUIRE(made.ok());
+  MemoryBudget budget(MemoryBudget::kUnlimited);
+  Buffer<u32> order;
+  const auto unknown = thread_order(b.view(5, 3), *made.value(), budget, order);
+  CHECK(!unknown.ok() && unknown.reason == Reason::parameter_out_of_range);
+  // Budget juste suffisant pour l'ordre par m, pas pour les tampons de l'ordre par poids : refus avant allocation.
+  MemoryBudget tight(4 * b.jobs.size());
+  CHECK(thread_order(b.view(5, kOrderSize), *made.value(), tight, order).ok());
+  order.reset();
+  const auto refused = thread_order(b.view(5, kOrderWeight), *made.value(), tight, order);
+  CHECK(!refused.ok() && refused.reason == Reason::memory_budget);
+  CHECK_EQ(tight.used(), 0u);
+}
+
+MHGP11_TEST_MAIN()
