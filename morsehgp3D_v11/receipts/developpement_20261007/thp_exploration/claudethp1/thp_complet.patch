@@ -1,6 +1,10 @@
 // Portes de core : budget memoire honnete (seul, puis sous concurrence), Buffer et ses refus, Csr bien forme.
 #include <array>
+#include <cstdint>
+#include <cstdio>
+#include <fstream>
 #include <memory>
+#include <string>
 #include <thread>
 #include <utility>
 #include <vector>
@@ -331,3 +335,56 @@ MHGP11_TEST(csr, 25) {
   CHECK(!well_formed({0, u64{1} << 32}, 0, budget));
   CHECK(!well_formed({0, (u64{1} << 32) + 2}, 2, budget));
 }
+
+namespace {
+// Pages enormes anonymes (Kio) de la projection qui contient `address`, lues dans /proc/self/smaps ; 0 si illisible.
+u64 anon_huge_kib(const void* address) {
+  std::ifstream smaps("/proc/self/smaps");
+  const auto at = reinterpret_cast<std::uintptr_t>(address);
+  bool inside = false;
+  std::string line;
+  while (std::getline(smaps, line)) {
+    unsigned long long lo = 0, hi = 0;
+    if (std::sscanf(line.c_str(), "%llx-%llx", &lo, &hi) == 2 && line.find(':') > line.find('-')) {
+      inside = lo <= at && at < hi;
+      continue;
+    }
+    unsigned long long kib = 0;
+    if (inside && std::sscanf(line.c_str(), "AnonHugePages: %llu kB", &kib) == 1) return kib;
+  }
+  return 0;
+}
+}  // namespace
+
+// Pages de 2 Mio (buffer.cpp, 7 octobre 2026) : sous Linux, tout tampon d'au moins 2 Mio est aligne sur 2 Mio, le
+// budget compte ses octets exacts et son contenu est intact ; sous le seuil, la voie ordinaire. Les pages enormes
+// obtenues dependent de la politique THP de la machine : relevees, jamais exigees.
+MHGP11_TEST(huge_pages, 14) {
+  constexpr u64 kHuge = u64{1} << 21;
+  MemoryBudget budget(MemoryBudget::kUnlimited);
+  u64 observed = 0;
+  for (const u64 bytes : {kHuge, kHuge + 123, 3 * kHuge + 4097, 8 * kHuge}) {
+    Buffer<u8> b;
+    REQUIRE(b.allocate(bytes, budget).ok());
+    CHECK_EQ(budget.used(), bytes);
+#if defined(__linux__)
+    CHECK_EQ(reinterpret_cast<std::uintptr_t>(b.data()) % kHuge, 0u);
+#else
+    CHECK(true);
+#endif
+    for (u64 i = 0; i < bytes; i += 4096) b[i] = static_cast<u8>(i / 4096);
+    b[bytes - 1] = 0x5A;
+    bool intact = b[bytes - 1] == 0x5A;
+    for (u64 i = 0; i + 1 < bytes; i += 4096) intact = intact && b[i] == static_cast<u8>(i / 4096);
+    CHECK(intact);
+    if (bytes == 8 * kHuge) observed = anon_huge_kib(b.data());
+  }
+  CHECK_EQ(budget.used(), 0u);
+  Buffer<u64> small;  // 2 Mio - 8 octets : voie ordinaire
+  REQUIRE(small.allocate(kHuge / 8 - 1, budget).ok());
+  CHECK_EQ(budget.used(), kHuge - 8);
+  small.reset();
+  CHECK_EQ(budget.used(), 0u);
+  std::printf("huge_pages anon_huge_kib=%llu (tampon de 16 Mio touche ; depend de la politique THP)\n",
+              static_cast<unsigned long long>(observed));
+}
