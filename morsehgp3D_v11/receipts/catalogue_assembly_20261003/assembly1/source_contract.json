{
  "matrix": {
    "budget_seconds": 1380,
    "configurations": [
      {
        "cmake_options": [
          "-DCMAKE_BUILD_TYPE=Release",
          "-DMHGP11_COORD_BITS=18"
        ],
        "compiler": "g++",
        "ctest_args": [
          "-LE",
          "^mutant$"
        ],
        "description": "GCC Release, profil 18 bits : toutes les portes sauf les mutants (dont la suite complete de la reference, en tranches paralleles).",
        "name": "gcc_release",
        "probes": [
          {
            "executable": "mhgp11_sched_probe",
            "name": "sched_probe",
            "timeout_seconds": 180
          }
        ],
        "require_labels": [
          "unit",
          "fast"
        ],
        "require_labels_if_data": [
          "lidar"
        ],
        "test_timeout_seconds": 600,
        "threads": 16,
        "timeout_seconds": 1200
      },
      {
        "cmake_options": [
          "-DCMAKE_BUILD_TYPE=Release",
          "-DMHGP11_MUTANT_JOBS={threads}",
          "-DMHGP11_COORD_BITS=18"
        ],
        "compiler": "g++",
        "ctest_args": [
          "-L",
          "^mutant$"
        ],
        "ctest_parallel": 1,
        "description": "Portes de label mutant : manifestes, puis une campagne par manifeste ; le lanceur se parallelise lui-meme (MHGP11_MUTANT_JOBS = fils alloues).",
        "name": "mutants",
        "require_labels": [
          "mutant"
        ],
        "test_timeout_seconds": 1200,
        "threads": 32,
        "timeout_seconds": 1300
      },
      {
        "cmake_options": [
          "-DCMAKE_BUILD_TYPE=Release",
          "-DMHGP11_SANITIZE=ON",
          "-DMHGP11_COORD_BITS=24"
        ],
        "compiler": "g++",
        "ctest_args": [
          "-LE",
          "^mutant$",
          "-E",
          "^mhgp11_reference_"
        ],
        "description": "GCC, AddressSanitizer + UndefinedBehaviorSanitizer (MHGP11_SANITIZE) ; un rapport UBSan arrete la porte. Profil explicite 24 bits.",
        "env": {
          "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
        },
        "name": "gcc_asan_ubsan",
        "require_labels": [
          "unit"
        ],
        "sanitizer": "address,undefined",
        "test_timeout_seconds": 900,
        "threads": 8,
        "timeout_seconds": 1300
      },
      {
        "cmake_options": [
          "-DCMAKE_BUILD_TYPE=Release",
          "-DMHGP11_TSAN=ON",
          "-DMHGP11_COORD_BITS=21"
        ],
        "compiler": "g++",
        "ctest_args": [
          "-LE",
          "^mutant$",
          "-E",
          "^mhgp11_reference_"
        ],
        "description": "GCC, ThreadSanitizer (MHGP11_TSAN) : portes de sched et de core au moins ; ctest tourne sous setarch -R des que cela fonctionne (un binaire TSan echoue aleatoirement sous forte randomisation d'adresses). Profil explicite 21 bits.",
        "name": "gcc_tsan",
        "require_labels": [
          "unit"
        ],
        "sanitizer": "thread",
        "test_timeout_seconds": 900,
        "threads": 8,
        "timeout_seconds": 1300
      },
      {
        "cmake_options": [
          "-DCMAKE_BUILD_TYPE=Release",
