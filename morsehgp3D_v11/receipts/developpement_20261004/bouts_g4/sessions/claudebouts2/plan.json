{
 "schema": "ehgp.v11.session_plan.v1",
 "note": "Demos (Claude, 4 octobre) : exemples de Zoltan/demos reorganises par issue (HGP reussit ou echoue, HDBSCAN reussit ou echoue) : 31 bouts de scene et les 5 demos de scene entiere ; meilleur bloc de chaque objet publie pour H^r_{k+1} et pour HDBSCAN (--members-all), k = 2, 3, 5, 10 ; porte stricte d'abord.",
 "python_packages": "pinned",
 "default_build": true,
 "build_targets": [
  "mhgp11_points_export"
 ],
 "build_timeout_seconds": 600,
 "results_cap_bytes": 536870912,
 "commands": [
  {
   "name": "unpack",
   "timeout_seconds": 300,
   "argv": [
    "python3",
    "{src}/morsehgp3D_v11/bench/points_unpack.py",
    "--archive",
    "{data}/bouts.tar",
    "--out",
    "{build}/bouts_data"
   ]
  },
  {
   "name": "gate",
   "timeout_seconds": 900,
   "argv": [
    "python3",
    "{src}/morsehgp3D_v11/bench/points_gate.py",
    "--export",
    "{build}/mhgp11_points_export",
    "--work",
    "{build}/gate",
    "--out",
    "{build}/gate.json",
    "--mirror",
    "{out}/gate.json",
    "--seconds",
    "300"
   ]
  },
  {
   "name": "bouts",
   "timeout_seconds": 1700,
   "argv": [
    "python3",
    "{src}/morsehgp3D_v11/bench/points_campaign.py",
    "--mode",
    "lidar",
    "--data",
    "{build}/bouts_data",
    "--export",
    "{build}/mhgp11_points_export",
    "--gate",
    "{build}/gate.json",
    "--work",
    "{build}/bouts",
    "--out",
    "{out}/lidar",
    "--jobs",
    "24",
    "--native-workers",
    "2",
    "--roles",
    "bout,demo",
    "--members-all"
   ]
  }
 ]
}
