+// Passe de comptage : un fil par feuille, ou un warp par feuille (feuille cooperative).
+void launch_count(const DeviceView& dv, u8* status, u64* balls, u64* incidences, unsigned long long* totals,
+                  LeafRecord* scratch_records, u8* scratch_population, u8* stored, unsigned* errors) {
+  if (dv.count == 0) return;
+  if (dv.coop) {
+    count_coop_kernel<<<static_cast<unsigned>(dv.count), kThreads>>>(dv, status, balls, incidences, totals,
+                                                                     scratch_records, scratch_population, stored,
+                                                                     errors);
+    return;
+  }
+  const unsigned grid = static_cast<unsigned>((dv.count + kThreads - 1) / kThreads);
+  count_kernel<<<grid, kThreads>>>(dv, status, balls, incidences, totals, scratch_records, scratch_population, stored);
+}
