+#ifdef L09_MOM
+// L09 (instrumentation, aucune decision) : certificat de moments de groupe sur une boite fermee [lo, hi].
+// Groupe Z (W sites de poids 1, M = somme des z', V = somme des |z'|^2, repere local z' = Z - lo), ancre a'.
+// sigma = max_c S(c) = V - W |a'|^2 + sum_i max(0, -2 (M_i - W a'_i) h_i) ; R2 = sum_i max(a'_i^2, (a'_i - h_i)^2).
+// Rejet pour le seuil theta ssi sigma + theta R2 < 0 (au moins theta + 1 sites de Z strictement plus proches que a
+// de tout centre de la boite fermee). Rend le plus grand theta certifie + 1 (nombre certifie), 0 si rien.
+struct L09Group {
+  i128 W = 0, M[3] = {0, 0, 0}, V = 0;
+};
+inline bool l09_rejects(const L09Group& g, const i64 a[3], const i64 h[3], i64 theta) {
+  if (theta < 0) return false;
+  i128 a2 = 0, sig = g.V, r2 = 0;
+  for (int i = 0; i < 3; ++i) {
+    a2 += i128(a[i]) * a[i];
+    const i128 coef = -2 * (g.M[i] - g.W * a[i]);
+    if (coef > 0) sig += coef * h[i];
+    const i128 d0 = i128(a[i]) * a[i], d1 = i128(a[i] - h[i]) * (a[i] - h[i]);
+    r2 += d0 > d1 ? d0 : d1;
+  }
+  sig -= g.W * a2;
+  if (r2 == 0) return false;
+  return sig + i128(theta) * r2 < 0;
+}
+inline void l09_moments_leaf(const Ctx&, Local& L, const P3* lx, u32 m, const Box& Q, const u64* Dm, u32 nw, i64 th2,
