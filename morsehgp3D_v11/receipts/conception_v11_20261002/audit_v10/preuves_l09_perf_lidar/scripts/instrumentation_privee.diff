+      full.V += i128(loc[i][k]) * loc[i][k];
+      if (loc[i][k] < loc[ext[2 * k]][k]) ext[2 * k] = int(i);
+      if (loc[i][k] > loc[ext[2 * k + 1]][k]) ext[2 * k + 1] = int(i);
+    }
+  }
+  L09Group grp[7];
+  grp[0] = full;
+  for (int e = 0; e < 6; ++e) {
