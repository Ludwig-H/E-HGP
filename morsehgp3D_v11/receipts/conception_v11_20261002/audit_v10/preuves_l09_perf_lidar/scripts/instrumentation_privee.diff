+      const bool dom = static_cast<i64>(d) > th[q];
+      if (dom) ++L.led.x[35 + q];
+      if (!outside) continue;
+      const bool r0 = l09_rejects(grp[0], a, h, th[q]);
+      bool r7 = r0;
+      for (int e = 1; e < 7 && !r7; ++e) r7 = l09_rejects(grp[e], a, h, th[q]);
+      if (r0) ++L.led.x[32 + q];
+      if (r0 && !dom) ++L.led.x[38 + q];
+      if (r7 && !dom) ++L.led.x[41 + q];
