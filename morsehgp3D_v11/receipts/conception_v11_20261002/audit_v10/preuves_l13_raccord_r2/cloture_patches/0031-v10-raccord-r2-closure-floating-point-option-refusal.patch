+         'C : aucune constante flottante dans la sonde')
+    # contraction posee une fois pour le repertoire, jugement differe
+    cml = code_lines(raw.get(CML) or '')
+    for needle in ('set(MHGP10_FP_OPTIONS -ffp-contract=off)', 'add_compile_options(${MHGP10_FP_OPTIONS})',
+                   'cmake_language(DEFER CALL mhgp10_fp_check)'):
+        n = cml.count(needle)
+        j.ok('C', n == 1, 'C : CMakeLists.txt porte une fois %s (%d)' % (needle, n))
