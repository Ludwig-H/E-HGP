+def judge_accepted(ctx, src, prefix, only=None, echo=True):
+    """Famille A : chaque canal hors contrat passe la configuration, et l'option arrive sur les commandes ecrites."""
+    j = Judge()
+    channels = {}
+    played = 0
+    for name, channel, how, on_compile, on_link in accepted_cases(ctx):
+        if only is not None and name not in only:
+            continue
+        before = len(j.failures)
+        code, output, build = configure(ctx, src, prefix + name, **how)
+        refused = sorted(set(re.findall(r'mhgp10_fp_[a-z_]+', output)))
+        j.ok('A', code == 0 and not refused,
+             'A : canal %s, cas %s : configuration code %s%s ; le contrat declare ce canal hors contrat (admis) : '
+             'mettre a jour cmake/fp_flags.cmake, README.md, PASSATION.md et cette porte'
+             % (channel, name, code, ', refus %s' % ' '.join(refused) if refused else ''))
+        commands = compile_commands(build) if code == 0 else []
+        carried = [all(tok in args for tok in on_compile) for _file, _dir, args in commands]
+        j.ok('A', len(commands) >= FLOOR_UNITS and all(carried),
+             'A : cas %s : %d commande(s) sur %d portent %s'
+             % (name, sum(carried), len(commands), ' '.join(on_compile)))
+        if on_link:
+            link = link_command(build, 'mhgp10_tower').split()
+            j.ok('A', all(tok in link for tok in on_link),
+                 'A : cas %s : l\'edition de liens de mhgp10_tower porte %s' % (name, ' '.join(on_link)))
+        channels[channel] = channels.get(channel, True) and len(j.failures) == before
+        played += 1
+        if echo:
+            print('admis %s canal=%s code=%s commandes=%d' % (name, channel, code, len(commands)))
+    return j, sorted(c for c, ok in channels.items() if ok), played
+
+
+def judge_refused(ctx, src, prefix, only=None, echo=True):
+    """Famille R : refus graves, par les jetons."""
+    j = Judge()
+    played = 0
+    for name, where, token, how in refused_cases(ctx):
+        if only is not None and name not in only:
+            continue
+        code, output, _build = configure(ctx, src, prefix + name, **how)
+        flat = ' '.join(output.split())
+        j.ok('R', isinstance(code, int) and code != 0,
+             'R : cas %s : configuration code %s, refus attendu' % (name, code))
+        j.ok('R', REFUSAL_TOKEN in flat, 'R : cas %s : refus sans le jeton grave %s' % (name, REFUSAL_TOKEN))
+        j.ok('R', '%s contient %s ' % (where, token) in flat,
+             'R : cas %s : refus sans << %s contient %s >>' % (name, where, token))
+        played += 1
+        if echo:
+            print('refus %s ensemble=[%s] jeton=%s code=%s' % (name, where, token, code))
+    return j, played
+
+
+def preprocess_args(args):
+    """Commande de compilation sans -o <objet>, sans -c et sans sortie de dependances (-MD, -MT, -MF, -MQ)."""
+    out, skip = [], False
+    for tok in args:
+        if skip:
+            skip = False
+        elif tok in ('-o', '-MT', '-MF', '-MQ'):
+            skip = True
+        elif tok not in ('-c', '-MD', '-MMD'):
+            out.append(tok)
+    return out
+
+
+def judge_units(ctx, src, prefix, echo=True):
+    """Famille U : contraction coupee sur chaque commande, garde de compilation dans toute unite sauf une."""
+    j = Judge()
+    code, _output, build = configure(ctx, src, prefix + 'defaut')
+    j.ok('U', code == 0, 'U : configuration par defaut code %s' % code)
+    commands = compile_commands(build) if code == 0 else []
+    contract = sum('-ffp-contract=off' in args for _file, _dir, args in commands)
+    j.ok('U', len(commands) >= FLOOR_UNITS and contract == len(commands),
+         'U : %d commande(s) sur %d portent -ffp-contract=off (plancher %d unites)'
+         % (contract, len(commands), FLOOR_UNITS))
+    root = os.path.realpath(src)
+
+    def preprocess(entry):
+        path, directory, args = entry
+        rc, _out, err = run(preprocess_args(args) + ['-E', '-o', os.devnull, '-ffast-math'], cwd=directory,
+                            env=ctx.env, timeout=UNIT_TIMEOUT)
+        return os.path.relpath(os.path.realpath(path), root), rc, STRICT_TOKEN in err
+
+    with concurrent.futures.ThreadPoolExecutor(max_workers=ctx.jobs) as pool:
+        results = list(pool.map(preprocess, commands))
+    guarded = sorted(rel for rel, rc, tok in results if isinstance(rc, int) and rc != 0 and tok)
+    admitted = sorted(rel for rel, rc, _tok in results if rc == 0)
+    other = sorted(rel for rel, rc, tok in results if rel not in guarded and rel not in admitted)
+    j.ok('U', admitted == [PRELOAD] and not other and len(guarded) == len(commands) - 1,
+         'U : sous -ffast-math, unites admises au pretraitement %s (declaree : %s seule), sans le jeton %s : %s'
+         % (admitted, PRELOAD, STRICT_TOKEN, other))
+    exempt = [e for e in commands if os.path.relpath(os.path.realpath(e[0]), root) == PRELOAD]
+    rc = None
+    if len(exempt) == 1:
+        rc, _out, _err = run(preprocess_args(exempt[0][2]) + ['-fsyntax-only', '-ffast-math'], cwd=exempt[0][1],
+                             env=ctx.env, timeout=UNIT_TIMEOUT)
+    j.ok('U', rc == 0, 'U : %s compile sous -ffast-math (-fsyntax-only, code %s)' % (PRELOAD, rc))
+    try:
+        with open(os.path.join(src, PRELOAD), encoding='utf-8') as f:
+            body = '\n'.join(line.split('//')[0] for line in f.read().split('\n'))
+    except (OSError, UnicodeDecodeError):
+        body = None
+    j.ok('U', body is not None and re.search(r'#\s*include\s*"', body) is None,
+         'U : %s n\'inclut aucun en-tete du projet' % PRELOAD)
+    j.ok('U', body is not None and re.search(r'\b(double|float)\b', body) is None,
+         'U : %s ne porte aucun type flottant' % PRELOAD)
+    if echo:
+        print('unites %d contraction_coupee=%d gardees=%d exemptee=%s'
+              % (len(commands), contract, len(guarded), ' '.join(admitted) or '-'))
+    return j, len(guarded), len(commands)
+
