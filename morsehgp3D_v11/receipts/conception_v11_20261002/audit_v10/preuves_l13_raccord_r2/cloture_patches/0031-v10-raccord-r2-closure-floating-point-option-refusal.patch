+# ---------------------------------------------------------------- configurations
+def run(argv, cwd=None, env=None, timeout=CONFIGURE_TIMEOUT):
+    """Code (entier, 'signalN', 'delai' ou 'oserror'), sortie standard, sortie d'erreur."""
+    try:
+        r = subprocess.run(argv, cwd=cwd, env=env, capture_output=True, text=True, errors='replace', timeout=timeout)
+    except subprocess.TimeoutExpired:
+        return 'delai', '', ''
+    except OSError as e:
+        return 'oserror', '', str(e)
+    code = r.returncode if r.returncode >= 0 else 'signal%d' % -r.returncode
+    return code, r.stdout, r.stderr
+
+
+class Context:
+    def __init__(self, src, work, cxx, cid, jobs, crt):
+        self.src, self.work, self.cxx, self.cid, self.jobs, self.crt = src, work, cxx, cid, jobs, crt
+        self.cmake = shutil.which('cmake') or 'cmake'
+        self.env = {k: v for k, v in os.environ.items() if k not in ('CXX', 'CXXFLAGS', 'LDFLAGS')}
+
+
+def configure(ctx, src, tag, args=(), inject=None, parent=None):
+    """Configuration neuve de src dans <work>/<tag>/b. inject : texte d'un CMAKE_PROJECT_INCLUDE ; parent : drapeau
+    pose par add_definitions dans un projet parent qui fait add_subdirectory. Rend (code, sorties, dossier de build)."""
+    case = os.path.join(ctx.work, tag)
+    os.makedirs(case)
+    build = os.path.join(case, 'b')
+    top = src
+    if parent is not None:
+        top = os.path.join(case, 'parent')
+        os.makedirs(top)
+        with open(os.path.join(top, 'CMakeLists.txt'), 'w') as f:
+            f.write('cmake_minimum_required(VERSION 3.22)\nproject(mhgp10_parent LANGUAGES CXX)\n'
+                    'add_definitions(%s)\nadd_subdirectory("%s" produit)\n' % (parent, src))
+    argv = [ctx.cmake, '-S', top, '-B', build, '-DCMAKE_BUILD_TYPE=Release', '-DCMAKE_CXX_COMPILER=' + ctx.cxx]
+    argv += list(args)
+    if inject is not None:
+        path = os.path.join(case, 'inject.cmake')
+        with open(path, 'w') as f:
+            f.write(inject)
+        argv.append('-DCMAKE_PROJECT_INCLUDE=' + path)
+    code, out, err = run(argv, env=ctx.env)
+    return code, out + err, build
+
+
+def compile_commands(build):
+    """Entrees de compile_commands.json : (fichier, dossier, arguments) ; liste vide si illisible."""
+    try:
+        with open(os.path.join(build, 'compile_commands.json')) as f:
+            entries = json.load(f)
+    except (OSError, ValueError):
+        return []
+    out = []
+    for e in entries if isinstance(entries, list) else []:
+        if isinstance(e, dict) and 'file' in e:
+            args = e['arguments'] if 'arguments' in e else shlex.split(e.get('command', ''))
+            out.append((e['file'], e.get('directory', build), list(args)))
+    return out
+
+
+def link_command(build, target):
+    """Commande d'edition de liens ecrite pour une cible : link.txt (Makefile) ou build.ninja ; '' si absente."""
+    for root, _dirs, files in os.walk(build):
+        if 'link.txt' in files and os.path.basename(root) == target + '.dir':
+            with open(os.path.join(root, 'link.txt'), errors='replace') as f:
+                return f.read()
+    ninja = os.path.join(build, 'build.ninja')
+    if os.path.isfile(ninja):
+        with open(ninja, errors='replace') as f:
+            return f.read()
+    return ''
+
+
+def response_file(ctx, tag, content):
+    path = os.path.join(ctx.work, tag + '.options')
+    with open(path, 'w') as f:
+        f.write(content)
+    return path
+
