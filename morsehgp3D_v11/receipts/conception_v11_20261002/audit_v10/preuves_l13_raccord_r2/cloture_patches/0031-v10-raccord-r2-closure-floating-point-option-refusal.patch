+DIR_LOOP = ('  foreach(prop COMPILE_OPTIONS LINK_OPTIONS)\n    get_directory_property(value ${prop})\n'
+            '    mhgp10_fp_judge("repertoire ${prop}" liste ${value})\n  endforeach()\n')
+VARS_FILTER = ('  list(FILTER vars INCLUDE REGEX\n       "^CMAKE_(CXX_FLAGS|CXX_COMPILER_ARG1|CXX_LINK_FLAGS|'
+               'CXX_STANDARD_LIBRARIES|(EXE|SHARED|MODULE)_LINKER_FLAGS)")')
+IN_LIST = '  if(s IN_LIST MHGP10_FP_FORBIDDEN OR s MATCHES "^-cl-")\n'
+TARGET_STATES = 'set(MHGP10_FP_GNU_TARGET_STATES "-mieee-fp|enabled")'
+DEFINITIONS_JUDGED = (DIR_LOOP + '  cmake_policy(PUSH)\n  cmake_policy(SET CMP0059 OLD)\n'
+                      '  get_directory_property(value DEFINITIONS)\n  cmake_policy(POP)\n'
+                      '  mhgp10_fp_judge("repertoire DEFINITIONS" chaine "${value}")\n')
+CONTRACT_OPTION = 'add_compile_options(${MHGP10_FP_OPTIONS})\n'
+
+# (nom, mutation du dictionnaire des textes bruts) : chacun doit etre tue par C
+CODE_MUTANTS = (
+    ('code_repertoire_definitions_juge',
+     lambda r: replace_once(r, FLAGS, '  foreach(prop COMPILE_OPTIONS LINK_OPTIONS)\n    get_directory_property',
+                            '  foreach(prop COMPILE_OPTIONS LINK_OPTIONS DEFINITIONS)\n    get_directory_property')),
+    ('code_appel_de_jugement_ajoute', lambda r: replace_once(r, FLAGS, DIR_LOOP, DEFINITIONS_JUDGED)),
+    ('code_variable_non_jugee',
+     lambda r: replace_once(r, FLAGS, VARS_FILTER, VARS_FILTER.replace('CXX_STANDARD_LIBRARIES|', ''))),
+    ('code_bibliotheques_liees_non_jugees',
+     lambda r: replace_once(r, FLAGS, 'INTERFACE_LINK_OPTIONS LINK_LIBRARIES\n                 '
+                            'INTERFACE_LINK_LIBRARIES)', 'INTERFACE_LINK_OPTIONS)')),
+    ('code_etat_daz_ftz_lu',
+     lambda r: replace_once(r, FLAGS, TARGET_STATES, TARGET_STATES[:-1] + ' "-mdaz-ftz|disabled")')),
+    ('code_interface_sondee',
+     lambda r: replace_once(r, FLAGS, '    get_target_property(value ${t} COMPILE_FLAGS)\n    if(value)\n'
+                            '      mhgp10_fp_string_tokens(tokens "${value}")\n'
+                            '      list(APPEND target_options ${tokens})',
+                            '    get_target_property(value ${t} INTERFACE_COMPILE_OPTIONS)\n'
+                            '    get_target_property(value ${t} COMPILE_FLAGS)\n    if(value)\n'
+                            '      mhgp10_fp_string_tokens(tokens "${value}")\n'
+                            '      list(APPEND target_options ${tokens})')),
+    ('code_constante_dans_la_sonde',
+     lambda r: replace_once(r, PROBE, 'return a / b + a * c - b; }', 'return a / b + a * c - b * 1.0000000001; }')),
+    ('code_contraction_non_posee', lambda r: replace_once(r, CML, CONTRACT_OPTION, '')),
+)
+
+
+def tree_mutants(cid):
+    """(nom, famille qui doit le tuer, remplacements (fichier, ancien, nouveau), cas rejoues) : arbres mutes."""
+    first = 'constat_cl_unsafe_math' if cid == 'Clang' else 'constat_finite_math_only'
+    out = []
+    if cid == 'Clang':
+        out.append(('canal_A_ferme', 'A',
+                    [(FLAGS, IN_LIST, IN_LIST.replace(')\n', ' OR s MATCHES "plugin-opt")\n'))],
+                    ['A_lto_plugin_opt']))
+    out.append(('canal_B_ferme', 'A', [(FLAGS, DIR_LOOP, DEFINITIONS_JUDGED)], ['B_add_definitions']))
+    if cid == 'Clang':
+        out.append(('canal_C_ferme', 'A',
+                    [(FLAGS, IN_LIST, IN_LIST.replace(')\n', ' OR s MATCHES "^(@|-fconfig=)")\n'))],
+                    ['C_fichier_de_reponse', 'C_fichier_config']))
+    else:
+        out.append(('canal_D_ferme', 'A',
+                    [(FLAGS, IN_LIST, IN_LIST.replace(')\n', ' OR s MATCHES "^@" OR s MATCHES "crtfastmath")\n'))],
+                    ['D_fichier_de_reponse', 'D_chemin_de_crtfastmath']))
+    out.append(('refus_laisse_a_la_sonde', 'R',
+                [(FLAGS, VARS_FILTER, '  list(FILTER vars INCLUDE REGEX "^CMAKE_JAMAIS$")')], [first]))
+    out.append(('garde_dans_l_unite_exemptee', 'U',
+                [(PRELOAD, '#include <dlfcn.h>\n', '#include "../../src/core/fp_strict.hpp"\n#include <dlfcn.h>\n')],
+                None))
+    out.append(('garde_non_incluse', 'U',
+                [(TYPES, '#include "core/fp_strict.hpp"', '// #include "core/fp_strict.hpp"')], None))
+    out.append(('contraction_non_posee', 'U', [(CML, CONTRACT_OPTION, '')], None))
+    return out
+
+
+TREE_COPY = ('CMakeLists.txt', 'cmake', 'src', 'cli', 'tests')
+
+
+def mutated_tree(ctx, name, edits):
+    """Copie du projet sous <work>/mutant_<nom>/arbre, mutee ; ValueError si un motif n'est pas unique."""
+    root = os.path.join(ctx.work, 'mutant_' + name, 'arbre')
+    os.makedirs(root)
+    for item in TREE_COPY:
+        source = os.path.join(ctx.src, item)
+        if os.path.isdir(source):
+            shutil.copytree(source, os.path.join(root, item))
+        else:
+            shutil.copy2(source, os.path.join(root, item))
+    for rel, old, new in edits:
+        path = os.path.join(root, rel)
+        with open(path, encoding='utf-8') as f:
+            text = f.read()
+        if text.count(old) != 1:
+            raise ValueError('motif absent ou non unique dans %s : %r' % (rel, old[:60]))
+        with open(path, 'w', encoding='utf-8') as f:
+            f.write(text.replace(old, new))
+    return root
+
+
+def eq_rewrapped(raw):
+    """Equivalent : README.md et PASSATION.md recoupes a un mot par ligne (la normalisation reduit les blancs)."""
+    for rel in (README, PASSATION):
+        raw[rel] = raw[rel].replace(' ', '\n')
+
+
+def eq_uppercase(raw):
+    """Equivalent : README.md et PASSATION.md en capitales (la normalisation ignore la casse)."""
+    for rel in (README, PASSATION):
+        raw[rel] = raw[rel].upper()
+
+
+EQUIVALENTS = (('documents_recoupes', eq_rewrapped), ('casse_changee', eq_uppercase))
+
+
+# ---------------------------------------------------------------- principal
+def prepare_work(work):
+    """Dossier de travail vide et marque ; False s'il existe sans la marque de cette porte."""
+    if os.path.lexists(work):
+        if not os.path.isdir(work) or os.path.islink(work):
+            return False
+        entries = os.listdir(work)
+        if entries and MARK not in entries:
+            return False
+        for entry in entries:
+            path = os.path.join(work, entry)
+            if os.path.isdir(path) and not os.path.islink(path):
+                shutil.rmtree(path)
+            else:
+                os.unlink(path)
+    else:
+        os.makedirs(work)
+    with open(os.path.join(work, MARK), 'w') as f:
+        f.write('dossier de travail de test_fp_contract.py\n')
+    return True
+
+
+def main():
+    positional = [a for a in sys.argv[1:] if not a.startswith('--')]
+    options = [a for a in sys.argv[1:] if a.startswith('--')]
+    jobs, keep = 2, False
+    usage = len(positional) != 3
+    for opt in options:
+        if opt == '--keep':
+            keep = True
+        elif re.fullmatch(r'--jobs=[1-9][0-9]?', opt):
+            jobs = int(opt[7:])
+        else:
+            usage = True
+    if usage:
+        print(__doc__)
+        return 2
+    src, work, cxx = os.path.abspath(positional[0]), os.path.abspath(positional[1]), positional[2]
+    raw = {}
+    for rel in DOCUMENTS:
+        try:
+            with open(os.path.join(src, rel), encoding='utf-8') as f:
+                raw[rel] = f.read()
+        except (OSError, UnicodeDecodeError):
+            raw[rel] = None
+    missing = [rel for rel in DOCUMENTS if raw[rel] is None]
+    if missing:
+        print('REFUS documents ou sources absents sous %s : %s' % (src, ' '.join(missing)))
+        return 2
+    code, out, err = run([cxx, '--version'], timeout=60)
+    if code != 0:
+        print('REFUS compilateur inutilisable (%s --version : %s)' % (cxx, code))
+        return 2
+    version = (out + err).lower()
+    if 'clang' in version:
+        cid = 'Clang'
+    elif 'free software foundation' in version or 'gcc' in version or 'g++' in version:
+        cid = 'GNU'
+    else:
+        print('REFUS compilateur hors de la paire GCC / Clang : %s' % (out + err).split('\n')[0])
+        return 2
+    crt = ''
+    if cid == 'GNU':
+        code, out, _err = run([cxx, '-print-file-name=crtfastmath.o'], timeout=60)
+        crt = out.strip()
+        if code != 0 or not os.path.isabs(crt) or not os.path.isfile(crt):
+            print('REFUS crtfastmath.o introuvable chez %s (canal D non rejouable) : %r' % (cxx, crt))
+            return 2
+    if run([shutil.which('cmake') or 'cmake', '--version'], timeout=60)[0] != 0:
+        print('REFUS cmake inutilisable')
+        return 2
+    if not prepare_work(work):
+        print('REFUS dossier de travail non reconnu (ni vide, ni marque %s) : %s' % (MARK, work))
+        return 2
+    ctx = Context(src, work, cxx, cid, jobs, crt)
+
+    norm = {rel: normalize(text) for rel, text in raw.items()}
+    j = judge_documents(norm)
+    j.merge(judge_code(raw))
+    ja, channels, admitted = judge_accepted(ctx, src, 'admis_')
+    ja.ok('A', channels == sorted(CHANNELS[cid]),
+          'A : canaux hors contrat rejoues et admis %s, declares %s' % (channels, sorted(CHANNELS[cid])))
+    j.merge(ja)
+    jr, refused = judge_refused(ctx, src, 'refus_')
+    j.merge(jr)
+    ju, guarded, units = judge_units(ctx, src, 'unites_')
+    j.merge(ju)
+    failures = [what for _f, what in j.failures]
+    families_ok = sum(1 for fam in FAMILIES if not j.dead(fam))
+
+    killed = total = 0
+
+    def verdict(name, family, mj):
+        nonlocal killed, total
+        total += 1
+        if mj is None:
+            return
+        ok = mj.dead(family)
+        killed += ok
+        why = next((w for f, w in mj.failures if f == family), '')
+        print('mutant %s : %s' % (name, 'tue par %s (%s)' % (family, why[4:100]) if ok else 'SURVIVANT (%s)' % family))
+        if not ok:
+            failures.append('mutant %s survivant' % name)
+
+    def applied(name, mutate, texts):
+        """Copie des textes, mutee ; None (echec nomme) si le mutant ne s'applique pas."""
+        copy = dict(texts)
+        try:
+            mutate(copy)
+        except Exception as e:  # motif absent ou texte d'une forme inattendue : echec nomme, jamais un succes
+            print('mutant %s : INAPPLICABLE (%s : %s)' % (name, type(e).__name__, e))
+            failures.append('mutant %s inapplicable' % name)
+            return None
+        return copy
+
+    for name, mutate in document_mutants():
+        copy = applied(name, mutate, norm)
+        verdict(name, 'D', judge_documents(copy) if copy is not None else None)
+    for name, mutate in CODE_MUTANTS:
+        copy = applied(name, mutate, raw)
+        verdict(name, 'C', judge_code(copy) if copy is not None else None)
+    for name, family, edits, only in tree_mutants(cid):
+        try:
+            tree = mutated_tree(ctx, name, edits)
+        except (OSError, ValueError) as e:
+            print('mutant %s : INAPPLICABLE (%s : %s)' % (name, type(e).__name__, e))
+            failures.append('mutant %s inapplicable' % name)
+            total += 1
+            continue
+        prefix = 'mutant_%s/' % name
+        if family == 'A':
+            mj = judge_accepted(ctx, tree, prefix, only, echo=False)[0]
+        elif family == 'R':
+            mj = judge_refused(ctx, tree, prefix, only, echo=False)[0]
+        else:
+            mj = judge_units(ctx, tree, prefix, echo=False)[0]
+        verdict(name, family, mj)
+    accepted = 0
+    for name, mutate in EQUIVALENTS:
+        copy = applied(name, mutate, raw)
+        if copy is None:
+            continue
+        mj = judge_documents({rel: normalize(text) for rel, text in copy.items()})
+        accepted += not mj.failures
+        print('equivalent %s : %s' % (name, 'accepte' if not mj.failures else 'REJETE : %s' % mj.failures[0][1]))
+        if mj.failures:
+            failures.append('equivalent %s rejete' % name)
+
+    if not keep:
+        for entry in os.listdir(work):
+            path = os.path.join(work, entry)
+            if entry != MARK:
+                if os.path.isdir(path) and not os.path.islink(path):
+                    shutil.rmtree(path, ignore_errors=True)
+                else:
+                    os.unlink(path)
+    floors = {f: (FLOORS[f][cid] if isinstance(FLOORS[f], dict) else FLOORS[f]) for f in FAMILIES}
+    print('controles %s (planchers %s)' % (' '.join('%s=%d' % (f, j.count[f]) for f in FAMILIES),
+                                           ' '.join('%s=%d' % (f, floors[f]) for f in FAMILIES)))
+    for f in failures:
+        print('ECHEC', f)
+    if failures:
+        return 1
+    short = [f for f in FAMILIES if j.count[f] < floors[f]]
+    if short:
+        print('PLANCHER familles sous leur plancher : %s' % ' '.join(short))
+        return 3
+    print('fp_contract_ok compilateur=%s familles=%d/%d enonces=%d canaux=%d/%d admis=%d refus=%d unites=%d/%d '
+          'mutants_tues=%d/%d equivalents_acceptes=%d/%d'
+          % (cid, families_ok, len(FAMILIES), len(STATEMENTS), len(channels), len(CHANNELS[cid]), admitted, refused,
+             guarded, units, killed, total, accepted, len(EQUIVALENTS)))
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
