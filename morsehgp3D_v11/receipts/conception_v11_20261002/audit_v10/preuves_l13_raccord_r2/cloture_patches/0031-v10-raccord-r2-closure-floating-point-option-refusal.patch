+# ---------------------------------------------------------------- famille C : code contre contrat
+def code_lines(text):
+    """Lignes de code d'un fichier CMake : lignes de commentaire retirees."""
+    return '\n'.join(line for line in text.split('\n') if not line.lstrip().startswith('#'))
+
