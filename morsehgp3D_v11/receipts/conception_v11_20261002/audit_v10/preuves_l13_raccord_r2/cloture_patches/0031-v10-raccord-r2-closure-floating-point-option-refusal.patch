+def loop_properties(text, getter):
+    """Listes de proprietes des boucles foreach(prop ...) dont le corps commence par l'appel `getter`."""
+    found = re.findall(r'foreach\(prop ([A-Z_\s]+)\)\s*' + re.escape(getter), text)
+    return [tuple(group.split()) for group in found]
+
