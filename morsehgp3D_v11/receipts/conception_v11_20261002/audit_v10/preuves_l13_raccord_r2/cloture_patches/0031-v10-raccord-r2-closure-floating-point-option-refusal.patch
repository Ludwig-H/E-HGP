+class Judge:
+    def __init__(self):
+        self.count = {f: 0 for f in FAMILIES}
+        self.failures = []
+
+    def ok(self, family, cond, what):
+        self.count[family] += 1
+        if not cond:
+            self.failures.append((family, what))
+        return bool(cond)
+
+    def dead(self, family):
+        return any(f == family for f, _w in self.failures)
+
+    def merge(self, other):
+        for f in FAMILIES:
+            self.count[f] += other.count[f]
+        self.failures += other.failures
+
