+    j.ok('C', source == JUDGED_SOURCE, 'C : proprietes jugees des sources = E2 (%s)' % (source,))
+    imported = loop_properties(after, 'get_target_property(value ${t} ${prop})')
+    j.ok('C', bool(_sep) and imported == [JUDGED_IMPORTED],
+         'C : proprietes jugees des cibles importees = E2 (%s)' % imported)
+    calls = check.count('mhgp10_fp_judge(')
+    j.ok('C', calls == JUDGE_CALLS, 'C : %d appels de mhgp10_fp_judge dans mhgp10_fp_check, %d declares'
+         % (calls, JUDGE_CALLS))
+    named = set(re.findall(r'\b[A-Z][A-Z0-9_]{5,}\b', E['E2']))
+    declared = set(JUDGED_VARIABLES + JUDGED_DIRECTORY + JUDGED_TARGET + JUDGED_SOURCE + JUDGED_IMPORTED)
+    j.ok('C', named == declared, 'C : E2 nomme exactement les ensembles declares (%s)' % sorted(named ^ declared))
+    # ensembles sondes
+    j.ok('C', 'if(NOT CMAKE_CXX_COMPILER_ID MATCHES "^(GNU|Clang|AppleClang)$")' in probe,
+         'C : sonde sous GCC et Clang seulement')
+    m = re.search(r'mhgp10_fp_string_tokens\(base "([^"]*)"\)', probe)
+    base = tuple(re.findall(r'\$\{([A-Z0-9_]+)\}', m.group(1))) if m else None
+    j.ok('C', base == PROBED_BASE, 'C : base de la sonde = E3 (%s)' % (base,))
+    j.ok('C', 'get_directory_property(dir_options COMPILE_OPTIONS)' in probe
+         and 'list(FILTER vars INCLUDE REGEX "%s")' % PROBED_VARIANTS in probe,
+         'C : variantes CMAKE_CXX_FLAGS_<CFG> et options du repertoire sondees')
+    target = tuple(re.findall(r'get_target_property\(value \$\{t\} ([A-Z_]+)\)', probe))
+    j.ok('C', target == PROBED_TARGET, 'C : proprietes sondees des cibles = E3 (%s)' % (target,))
+    source = tuple(re.findall(r'get_source_file_property\(value "\$\{s\}" ([A-Z_]+)\)', probe))
+    j.ok('C', source == PROBED_SOURCE, 'C : proprietes sondees des sources = E3 (%s)' % (source,))
+    calls = probe.count('mhgp10_fp_probe_once(')  # la definition « macro(mhgp10_fp_probe_once where) » n'en est pas un
+    j.ok('C', calls == PROBE_CALLS, 'C : %d appels de mhgp10_fp_probe_once, %d declares' % (calls, PROBE_CALLS))
+    named = set(re.findall(r'\b[A-Z][A-Z0-9_]{5,}\b', E['E3'].replace('CMAKE_CXX_FLAGS_<CFG>', '')))
+    declared = set(PROBED_BASE + PROBED_TARGET + PROBED_SOURCE)
+    j.ok('C', named == declared, 'C : E3 nomme exactement les ensembles sondes (%s)' % sorted(named ^ declared))
+    for needle, what in (('-fsyntax-only "${source}"', 'macros'), ('-Q --help=optimizers', 'etats de GCC'),
+                         ('-Q --help=target', 'etats de la cible'), ('-S -emit-llvm', 'IR de Clang')):
+        j.ok('C', needle in probe_set, 'C : la sonde lit %s (%s)' % (what, needle))
+    # etats lus chez GCC
+    m = re.search(r'set\(MHGP10_FP_GNU_STATES\s+([^)]*)\)', code)
+    states = tuple(s.split('|')[0] for s in re.findall(r'"([^"]+)"', m.group(1))) if m else None
+    j.ok('C', states is not None and sorted(states) == sorted(GNU_STATES),
+         'C : etats lus dans -Q --help=optimizers (%s)' % (states,))
+    m = re.search(r'set\(MHGP10_FP_GNU_TARGET_STATES\s*([^)]*)\)', code)
+    states = tuple(re.findall(r'"([^"]+)"', m.group(1))) if m else None
+    j.ok('C', states == GNU_TARGET_STATES, 'C : etat lu dans -Q --help=target = -mieee-fp seul (%s)' % (states,))
+    # sonde : quatre operations, aucune constante flottante
+    lines = [line for line in (raw.get(PROBE) or '').split('\n')
