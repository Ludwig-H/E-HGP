+def function_body(code, name):
+    """Texte de function(name ...) jusqu'a son endfunction() ; chaine vide si absente."""
+    m = re.search(r'(?m)^function\(%s[ )]' % re.escape(name), code)
+    if m is None:
+        return ''
+    end = code.find('\nendfunction()', m.start())
+    return code[m.start():end] if end != -1 else ''
+
+
+def expand_prefixes(alternation):
+    """Alternatives de tete d'une expression CMAKE_(A|B|(C|D)_E) -> noms complets ; None si la forme est autre."""
+    parts, depth, cur = [], 0, ''
+    for ch in alternation:
+        if ch == '(':
+            depth += 1
+        elif ch == ')':
+            depth -= 1
+        if ch == '|' and depth == 0:
+            parts.append(cur)
+            cur = ''
+        else:
+            cur += ch
+    parts.append(cur)
+    out = []
+    for part in parts:
+        m = re.fullmatch(r'\(([A-Z_|]+)\)([A-Z0-9_]+)', part)
+        if m:
+            out += ['CMAKE_%s%s' % (head, m.group(2)) for head in m.group(1).split('|')]
+        elif re.fullmatch(r'[A-Z0-9_]+', part):
+            out.append('CMAKE_' + part)
+        else:
+            return None
+    return out
+
