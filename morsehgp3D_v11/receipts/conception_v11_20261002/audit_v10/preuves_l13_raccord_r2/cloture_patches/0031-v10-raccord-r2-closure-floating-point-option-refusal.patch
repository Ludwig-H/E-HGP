+def normalize(text):
+    """Minuscules sans accents, apostrophes droites, marqueurs de commentaire (# ou //) et titres de debut de ligne
+    retires, accents graves et asterisques de Markdown retires, blancs reduits."""
+    text = text.replace('’', "'").replace('œ', 'oe').replace('Œ', 'oe')
+    text = unicodedata.normalize('NFKD', text)
+    text = ''.join(ch for ch in text if not unicodedata.combining(ch))
+    text = re.sub(r'(?m)^[ \t]*(?:#+|//+)', ' ', text)
+    text = text.replace('`', '').replace('*', '')
+    return ' '.join(text.lower().split())
+
