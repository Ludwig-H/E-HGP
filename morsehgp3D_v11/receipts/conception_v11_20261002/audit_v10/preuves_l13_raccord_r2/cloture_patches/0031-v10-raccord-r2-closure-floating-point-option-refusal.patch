+# ---------------------------------------------------------------- mutants
+def replace_once(texts, rel, old, new):
+    """Remplacement exact d'une occurrence unique ; ValueError sinon (mutant inapplicable, jamais silencieux)."""
+    if texts.get(rel) is None or texts[rel].count(old) != 1:
+        raise ValueError('motif absent ou non unique dans %s : %r' % (rel, old[:60]))
+    texts[rel] = texts[rel].replace(old, new)
+
+
+def document_mutants():
+    """(nom, mutation du dictionnaire des textes normalises) : chacun doit etre tue par D."""
+    out = []
+    for rel in FULL:
+        short = os.path.basename(rel).split('.')[0]
+        for key, text in STATEMENTS:
+            words = normalize(text).split()
+            out.append(('enonce_%s_tronque_%s' % (key, short),
+                        lambda n, rel=rel, old=normalize(text), new=' '.join(words[:-1]):
+                        replace_once(n, rel, old, new)))
+    out.append(('enonce_E4_en_double_PASSATION',
+                lambda n: replace_once(n, PASSATION, normalize(E['E4']), 2 * (normalize(E['E4']) + ' '))))
+    for rel in FULL:
+        short = os.path.basename(rel).split('.')[0]
+        def measure(n, rel=rel):
+            if n.get(rel) is None or '64 instructions fma' not in n[rel]:
+                raise ValueError('mesure absente de %s' % rel)
+            n[rel] = n[rel].replace('64 instructions fma', '46 instructions fma')
+        out.append(('mesure_changee_%s' % short, measure))
+    for i, (rel, text) in enumerate(REFERENCES):
+        def drop(n, rel=rel, text=text):
+            if n.get(rel) is None or normalize(text) not in n[rel]:
+                raise ValueError('renvoi absent de %s' % rel)
+            n[rel] = n[rel].replace(normalize(text), '')
+        out.append(('renvoi_retire_%d_%s' % (i, os.path.basename(rel).split('.')[0]), drop))
+    for i, (rel, phrase) in enumerate(RETRACTED):
+        def back(n, rel=rel, phrase=phrase):
+            if n.get(rel) is None:
+                raise ValueError('document absent : %s' % rel)
+            n[rel] = n[rel] + ' ' + phrase
+        out.append(('surpromesse_revenue_%d_%s' % (i, os.path.basename(rel).split('.')[0]), back))
+    return out
