+def accepted_cases(ctx):
+    """(nom, canal, arguments de configure(), jetons exiges sur chaque compilation, jetons exiges a l'edition de
+    liens de mhgp10_tower)."""
+    if ctx.cid == 'Clang':
+        spc = response_file(ctx, 'canal_c', '-cl-single-precision-constant\n')
+        return [
+            ('A_lto_plugin_opt', 'A',
+             dict(args=['-DMHGP10_MARCH=x86-64-v3', '-DCMAKE_CXX_FLAGS=-flto',
+                        '-DCMAKE_EXE_LINKER_FLAGS=-Wl,-plugin-opt=-fp-contract=fast']),
+             ['-flto', '-march=x86-64-v3', '-ffp-contract=off'], ['-flto', '-Wl,-plugin-opt=-fp-contract=fast']),
+            ('B_add_definitions', 'B', dict(inject='add_definitions(-freciprocal-math)\n'),
+             ['-freciprocal-math', '-ffp-contract=off'], []),
+            ('B_projet_parent', 'B', dict(parent='-freciprocal-math'), ['-freciprocal-math', '-ffp-contract=off'], []),
+            ('C_fichier_de_reponse', 'C', dict(args=['-DCMAKE_CXX_FLAGS=@' + spc]),
+             ['@' + spc, '-ffp-contract=off'], []),
+            ('C_fichier_config', 'C', dict(args=['-DCMAKE_CXX_FLAGS=--config=' + spc]),
+             ['--config=' + spc, '-ffp-contract=off'], []),
+        ]
+    daz = response_file(ctx, 'canal_d', '-mdaz-ftz\n')
+    return [
+        ('B_add_definitions', 'B', dict(inject='add_definitions(-mno-ieee-fp)\n'),
+         ['-mno-ieee-fp', '-ffp-contract=off'], []),
+        ('B_projet_parent', 'B', dict(parent='-mno-ieee-fp'), ['-mno-ieee-fp', '-ffp-contract=off'], []),
+        ('D_fichier_de_reponse', 'D', dict(args=['-DCMAKE_CXX_FLAGS=@' + daz]),
+         ['@' + daz, '-ffp-contract=off'], ['@' + daz]),
+        ('D_chemin_de_crtfastmath', 'D', dict(args=['-DCMAKE_EXE_LINKER_FLAGS=' + ctx.crt]),
+         ['-ffp-contract=off'], [ctx.crt]),
+    ]
+
+
+def refused_cases(ctx):
+    """(nom, ensemble fautif attendu, jeton attendu, arguments de configure())."""
+    if ctx.cid == 'Clang':
+        return [
+            ('constat_cl_unsafe_math', 'CMAKE_CXX_FLAGS', '-cl-unsafe-math-optimizations',
+             dict(args=['-DCMAKE_CXX_FLAGS=-cl-unsafe-math-optimizations'])),
+            ('A_en_clair', 'CMAKE_EXE_LINKER_FLAGS', '-ffp-contract=fast',
+             dict(args=['-DMHGP10_MARCH=x86-64-v3', '-DCMAKE_CXX_FLAGS=-flto',
+                        '-DCMAKE_EXE_LINKER_FLAGS=-ffp-contract=fast'])),
+            ('B_en_clair', 'repertoire COMPILE_OPTIONS', '-freciprocal-math',
+             dict(inject='add_compile_options(-freciprocal-math)\n')),
+            ('C_en_clair', 'CMAKE_CXX_FLAGS', '-cl-single-precision-constant',
+             dict(args=['-DCMAKE_CXX_FLAGS=-cl-single-precision-constant'])),
+        ]
+    cases = [('constat_' + alias[2:].replace('-', '_'), 'CMAKE_CXX_FLAGS', alias,
+              dict(args=['-DCMAKE_CXX_FLAGS=' + alias]))
+             for alias in ('--finite-math-only', '--no-signed-zeros', '--no-trapping-math', '--fast-math',
+                           '--reciprocal-math', '--unsafe-math-optimizations')]
+    cases += [
+        ('B_en_clair', 'repertoire COMPILE_OPTIONS', '-mno-ieee-fp',
+         dict(inject='add_compile_options(-mno-ieee-fp)\n')),
+        ('D_en_clair', 'CMAKE_CXX_FLAGS', '-mdaz-ftz', dict(args=['-DCMAKE_CXX_FLAGS=-mdaz-ftz'])),
+        ('D_lien_en_clair', 'CMAKE_EXE_LINKER_FLAGS', '-mdaz-ftz', dict(args=['-DCMAKE_EXE_LINKER_FLAGS=-mdaz-ftz'])),
+    ]
+    return cases
+
