// Raisons stables : MHGP10_REASON(nom, statut). Le statut de chaque raison est fixe ici ; une porte
// refuse une raison emise sous un autre statut. invalid_input n'est emis que par la validation
// d'entree de api/ ; une precondition interne violee est invariant_violated.
MHGP10_REASON(none, ok)
MHGP10_REASON(empty_input, invalid_input)
MHGP10_REASON(size_mismatch, invalid_input)
MHGP10_REASON(coordinate_out_of_domain, invalid_input)
MHGP10_REASON(duplicate_point_id, invalid_input)
MHGP10_REASON(kmax_out_of_range, invalid_input)
MHGP10_REASON(k_out_of_range, invalid_input)
MHGP10_REASON(parameter_out_of_range, invalid_input)
MHGP10_REASON(shell_quotient_budget, unsupported_degeneracy)
MHGP10_REASON(memory_budget, resource_exhausted)
MHGP10_REASON(index_overflow_u32, resource_exhausted)
MHGP10_REASON(device_unavailable, resource_exhausted)
MHGP10_REASON(arith_guard, invariant_violated)
MHGP10_REASON(window_empty, invariant_violated)
MHGP10_REASON(descent_no_terminal, invariant_violated)
MHGP10_REASON(root_count, invariant_violated)
MHGP10_REASON(csr_bounds, invariant_violated)
MHGP10_REASON(rank_order, invariant_violated)
MHGP10_REASON(vertical_naturality, invariant_violated)
MHGP10_REASON(census_mismatch, invariant_violated)
MHGP10_REASON(nested_parallelism, invariant_violated)
MHGP10_REASON(leaf_unsplittable, invariant_violated)
