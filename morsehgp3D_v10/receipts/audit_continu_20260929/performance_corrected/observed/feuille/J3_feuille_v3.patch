+void enumerate_leaf_v3(const Ctx& C, Local& L, const std::vector<u32>& c, const Box& Q) {
+  const u32 m = static_cast<u32>(c.size());
+  L.memo.clear();
+  leaf::Sites& S = L.sites;
+  S.m = m;
+  bool tight = true;
+  for (u32 i = 0; i < m; ++i) {
+    const u32 s = c[i];
+    S.p[0][i] = C.P[s].x;
+    S.p[1][i] = C.P[s].y;
+    S.p[2][i] = C.P[s].z;
+    S.x[0][i] = C.X[s].x;
+    S.x[1][i] = C.X[s].y;
+    S.x[2][i] = C.X[s].z;
+    S.x2[i] = C.X2[s];
+    S.w[i] = C.w[s];
+    tight = tight && S.w[i] == 1;
+  }
+  S.tight = tight;
+  const i64 K = C.K;
+  const i64 th2 = K - 1, th3 = tight ? K - 2 : K - 1, th4 = tight ? K - 3 : K - 1;
+  const leaf::Box QB{{Q.lo[0], Q.lo[1], Q.lo[2]}, {Q.hi[0], Q.hi[1], Q.hi[2]}};
+  S.small = leaf::small_extent(S, QB);
+  leaf::Masks& M = L.masks;
+  leaf::dominance(S, QB, M);
+  L.led.leaf_dominance_tests += u64(m) * (m - 1) / 2;
+  leaf::Counters cn;
+  LeafSink sink{C, L, c, S, M, QB, th2};
+  leaf::pairs(S, QB, M, th2, th3, sink, cn);
+  if (th3 >= 0) {
+    L.live3.assign(size_t(m) * (m - 1) / 2, 0);
+    leaf::triples(S, QB, M, L.live3.data(), th3, th4, sink, cn);
+    if (th4 >= 0) leaf::quads(S, QB, M, L.live3.data(), th4, sink, cn);
+  }
+  L.led.pair_tests += cn.pair_tests;
+  L.led.triple_tests += cn.triple_tests;
+  L.led.line_hits += cn.line_hits;
+  L.led.quad_tests += cn.quad_tests;
+}
