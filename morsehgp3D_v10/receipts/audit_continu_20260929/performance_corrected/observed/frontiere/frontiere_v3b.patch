+  u64 l[2] = {0, 0};
+  child_loads(C, f, cand.data(), m, l);
+  auto shared = std::make_shared<const List>(std::move(cand));
+  for (int o = 0; o < 2; ++o) (l[o] > cap ? dev : kept).push_back(Task{child_box(f, o), shared, f.stag, l[o]});
 }
 
+// Tete. Une tache de tete (a developper, liste parente d'au moins theta sites) est developpee avec son filtre decoupe
+// en tranches de grain sites de sa liste parente ; les tranches sont des elements de travail comme les autres (voir
+// frontier). Phases d'une tache de tete :
+//   0. (racine seulement) reservoir de chaque tranche ; fusion dans l'ordre des tranches = reservoir serie (Reservoir) ;
+//   1. tri des sites de chaque tranche (dans une copie de travail, a la place de la tranche), enveloppe des gardes ;
+//      etape serie : decision (O(tranches)) ;
+//   2. copie compacte (tranches concatenees dans leur ordre : meme liste qu'en serie), charges des filles et, si les
+//      filles restent en tete, leurs reservoirs sur les gardes de la tranche (rang = place dans la liste compacte) ;
+//      etape serie : classement des filles, feuille eventuelle (rare : une grande liste reduite a M sites au plus).
+// L'etape serie d'une phase est faite par l'ouvrier qui termine la derniere tranche (compteur atomique : chaque
+// tranche ecrit ses resultats avant de decrementer, en liberation ; le dernier lit en acquisition).
+struct Piece {
+  u32 t0, t1;
+  u32 kept = 0, at = 0;  // sites gardes, et place du premier dans la liste compacte
+  u64 tests = 0, l[2] = {0, 0};
+  Box env;
+  Reservoir R[2];  // phase 0 : R[0] reservoir de la tranche ; phase 2 : reservoirs des filles
+};
+
+struct Big {
+  Task t;
+  Reservoir R;  // reservoir de la liste parente
+  Dominators Y;
+  List scratch;
+  std::vector<Piece> pc;
+  std::vector<u32> todo;  // tranches de la phase en cours
+  std::atomic<u32> remaining{0};
+  int phase = 0;
+  Fit fit;
+  u8 state = 0;  // 1 : feuille, 2 : deux filles
+  std::shared_ptr<List> list;
+};
+
+// Element de travail : tache de noeud (big nul) ou tranche d'une tache de tete.
+struct Work {
+  Task t;
+  Big* big = nullptr;
+  u32 piece = 0;
+};
+
+// Pile d'un ouvrier : le proprietaire prend au bout (profondeur d'abord), un voleur prend l'element le plus ancien.
+struct alignas(64) Stack {
+  std::mutex m;
+  std::vector<Work> q;
+  size_t head = 0;             // q[head, size) : elements presents
+  std::atomic<u64> count{0};  // q.size() - head, lu sans verrou par les voleurs
+};
+
+struct Frontier {
+  const Ctx& C;
+  std::vector<Local>& locals;
+  u64 cap, theta;
+  u32 grain;
+  std::vector<Stack> st;
+  std::vector<std::vector<Task>> kept_w;
+  std::atomic<u64> pending{0};  // elements publies non termines (en pile ou en cours)
+  // Ouvrier sans travail : kIdleSpins essais (yield), puis sommeil borne sur idle_cv (compteur d'evenements epoch) :
+  // chaque publication et la fin (pending == 0) incrementent epoch puis lisent sleepers ; le dormeur lit epoch, s'inscrit
+  // dans sleepers, reteste le travail, puis attend que epoch change. Operations seq_cst des deux cotes : soit le dormeur
+  // voit le travail (ou le nouvel epoch), soit le publieur le voit inscrit et le reveille ; aucun reveil perdu. Le sommeil
+  // reste borne a kIdleSleepUs. Sur une machine dediee, les attentes courtes (transitions de phase) restent actives.
+  std::mutex idle_m;
+  std::condition_variable idle_cv;
+  std::atomic<u32> sleepers{0};
+  std::atomic<u64> epoch{0};
+
+  Frontier(const Ctx& c, std::vector<Local>& l, unsigned P, u64 cp, u64 th, u32 g)
+      : C(c), locals(l), cap(cp), theta(th), grain(g), st(P), kept_w(P) {}
+
+  void wake() {
+    epoch.fetch_add(1, std::memory_order_seq_cst);
+    if (sleepers.load(std::memory_order_seq_cst) == 0) return;
+    std::lock_guard<std::mutex> lk(idle_m);
+    idle_cv.notify_all();
+  }
+
+  bool has_work() const {
+    for (const Stack& s : st)
+      if (s.count.load(std::memory_order_relaxed) > 0) return true;
+    return false;
+  }
+
+  void sleep() {
+    const u64 e = epoch.load(std::memory_order_seq_cst);
+    sleepers.fetch_add(1, std::memory_order_seq_cst);
+    if (pending.load(std::memory_order_seq_cst) != 0 && !has_work()) {
+      std::unique_lock<std::mutex> lk(idle_m);
+      idle_cv.wait_for(lk, std::chrono::microseconds(kIdleSleepUs),
+                       [&] { return epoch.load(std::memory_order_seq_cst) != e; });
+    }
+    sleepers.fetch_sub(1, std::memory_order_relaxed);
+  }
+
+  // Publie des elements sur la pile de wk : comptes avant d'etre visibles, donc avant que leur createur ne se retire.
+  void push(unsigned wk, std::vector<Work>& items) {
+    if (items.empty()) return;
+    pending.fetch_add(items.size(), std::memory_order_relaxed);
+    {
+      Stack& s = st[wk];
+      std::lock_guard<std::mutex> lk(s.m);
+      for (Work& w : items) s.q.push_back(std::move(w));
+      s.count.store(s.q.size() - s.head, std::memory_order_relaxed);
+    }
+    items.clear();
+    wake();
+  }
+
+  bool pop(unsigned wk, Work& w) {
+    Stack& own = st[wk];
+    if (own.count.load(std::memory_order_relaxed) > 0) {
+      std::lock_guard<std::mutex> lk(own.m);
+      if (own.q.size() > own.head) {
+        w = std::move(own.q.back());
+        own.q.pop_back();
+        if (own.q.size() == own.head) {
+          own.q.clear();
+          own.head = 0;
+        }
+        own.count.store(own.q.size() - own.head, std::memory_order_relaxed);
+        return true;
+      }
+    }
+    const unsigned P = static_cast<unsigned>(st.size());
+    for (unsigned j = 1; j < P; ++j) {
+      Stack& v = st[(wk + j) % P];
+      if (v.count.load(std::memory_order_relaxed) == 0) continue;
+      std::lock_guard<std::mutex> lk(v.m);
+      if (v.q.size() > v.head) {
+        w = std::move(v.q[v.head++]);
+        if (v.q.size() == v.head) {
+          v.q.clear();
+          v.head = 0;
+        }
+        v.count.store(v.q.size() - v.head, std::memory_order_relaxed);
+        return true;
+      }
+    }
+    return false;
+  }
+
+  // Nouvelle tache de tete (reservoir R de sa liste deja calcule, sauf phase 0) : tranches de la phase publiees.
+  Big* make_big(Task&& t) {
+    Big* b = new Big;
+    b->t = std::move(t);
+    const u32 np = static_cast<u32>(b->t.parent->size());
+    const u32 nch = std::max<u32>(1, (np + grain - 1) / grain);
+    b->pc.resize(nch);
+    for (u32 c = 0; c < nch; ++c) {
+      b->pc[c].t0 = static_cast<u32>(u64(np) * c / nch);
+      b->pc[c].t1 = static_cast<u32>(u64(np) * (c + 1) / nch);
+    }
+    return b;
+  }
+
+  void publish_phase(Big* b, int phase, unsigned wk, std::vector<Work>& out) {
+    b->phase = phase;
+    b->todo.clear();
+    for (u32 c = 0; c < b->pc.size(); ++c)
+      if (phase != 2 || b->pc[c].kept > 0) b->todo.push_back(c);
+    b->remaining.store(static_cast<u32>(b->todo.size()), std::memory_order_relaxed);
+    for (u32 c : b->todo) {
+      Work w;
+      w.big = b;
+      w.piece = c;
+      out.push_back(std::move(w));
+    }
+    push(wk, out);
+  }
+
+  void start_keep(Big* b, unsigned wk, std::vector<Work>& out) {
+    dominators(C, b->t.box, b->t.parent->data(), b->R, b->Y);
+    b->scratch.resize(b->t.parent->size());
+    publish_phase(b, 1, wk, out);
+  }
+
+  void run_piece(Big* b, u32 c) {
+    Piece& p = b->pc[c];
+    const Task& t = b->t;
+    if (b->phase == 0) {
+      reserve(C, t.box, t.parent->data() + p.t0, p.t1 - p.t0, p.t0, pool_cap(C, static_cast<u32>(t.parent->size())),
+              p.R[0]);
+    } else if (b->phase == 1) {
+      u32* out = b->scratch.data() + p.t0;
+      p.kept = keep(C, t.box, t.parent->data(), p.t0, p.t1, b->Y, out, p.tests);
+      if (p.kept > 0) p.env = envelope(C, out, p.kept);
+    } else {
+      const u32* src = b->scratch.data() + p.t0;
+      std::copy(src, src + p.kept, b->list->data() + p.at);
+      if (b->state != 2) return;
+      child_loads(C, b->fit, src, p.kept, p.l);
+      const u32 m = static_cast<u32>(b->list->size());
+      if (m < theta) return;
+      for (int o = 0; o < 2; ++o) reserve(C, child_box(b->fit, o), src, p.kept, p.at, pool_cap(C, m), p.R[o]);
+    }
+  }
+
+  // Etape serie apres la derniere tranche d'une phase ; rend vrai si b est termine (a liberer).
+  bool finish_phase(Big* b, unsigned wk, std::vector<Work>& out) {
+    Local& L = locals[wk];
+    const Task& t = b->t;
+    if (b->phase == 0) {
+      const u32 cp = pool_cap(C, static_cast<u32>(t.parent->size()));
+      for (const Piece& p : b->pc) merge_into(b->R, p.R[0], cp);
+      for (Piece& p : b->pc) p.R[0].nb = 0;
+      start_keep(b, wk, out);
+      return false;
+    }
+    if (b->phase == 1) {
+      ++L.led.nodes;
+      u64 m = 0;
+      Box E = {{INT64_MAX, INT64_MAX, INT64_MAX}, {INT64_MIN, INT64_MIN, INT64_MIN}};
+      for (Piece& p : b->pc) {
+        p.at = static_cast<u32>(m);
+        m += p.kept;
+        L.led.filter_tests += p.tests;
+        if (p.kept > 0) envelope_merge(E, p.env);
+      }
+      if (m == 0) {
+        ++L.led.skipped_bbox;
+        return true;
+      }
+      if (!decide(C, L, t.box, E, m, t.parent->size(), t.parent_stag, b->fit)) return true;
+      b->state = b->fit.split ? 2 : 1;
+      b->list = std::make_shared<List>();
+      b->list->resize(m);
+      publish_phase(b, 2, wk, out);
+      return false;
+    }
+    b->scratch = List();
+    if (b->state == 1) {
+      leaf(C, L, *b->list, b->fit);
+      return true;
+    }
+    u64 l[2] = {0, 0};
+    for (const Piece& p : b->pc) {
+      l[0] += p.l[0];
+      l[1] += p.l[1];
+    }
+    const u32 m = static_cast<u32>(b->list->size());
+    std::shared_ptr<const List> shared = std::move(b->list);
+    for (int o = 0; o < 2; ++o) {
+      Task ch{child_box(b->fit, o), shared, b->fit.stag, l[o]};
+      if (m >= theta) {
+        Big* nb = make_big(std::move(ch));
+        for (const Piece& p : b->pc) merge_into(nb->R, p.R[o], pool_cap(C, m));
+        start_keep(nb, wk, out);
+      } else if (l[o] > cap) {
