+//
+// Charge d'une tache : sites de sa liste parente dans sa boite (demi-ouverte), comme la frontiere J1 ; cap = n / (64 P).
+// Regle locale : une tache est developpee dans la frontiere (filtre, ajustement, puis feuille ou deux filles) si sa
+// charge est > cap ou si sa liste parente a au moins theta sites ; sinon elle est gardee pour l'etage des boites. La
+// decision ne depend que de la tache : l'ensemble des taches gardees est une fonction de l'entree, de cap et de theta,
+// jamais de l'ordre de traitement. Une tache gardee a donc au plus cap sites dans sa boite et moins de theta sites dans
+// sa liste parente (a plusieurs fils ; la frontiere J1 pouvait garder une petite boite a tres grande liste). Les
+// taches gardees partent par charge decroissante, puis par coin bas de la boite (unique : les boites gardees sont
+// deux a deux disjointes et non vides) : ordre total, le meme quels que soient le nombre de fils et l'ordonnancement.
+//
+// Execution : une seule region du pool (Frontier), sans barriere entre niveaux. Les taches a developper de liste
+// parente >= theta (tete : les premiers niveaux n'ont que 1, 2, 4 taches, et leurs listes portent presque tout le
+// nuage : 45 845, 45 845, 45 346, 44 466 sites sur la trame 02) ont leur filtre decoupe en tranches ; les autres (corps)
+// sont developpees d'un bloc. Tranches et taches de corps sont des elements de travail des memes piles, pris par vol de
+// taches : la tete et le corps se recouvrent.
+struct Task {
+  Box box{};
+  std::shared_ptr<const List> parent;
+  int parent_stag = 0;
+  u64 load = 0;
+};
+
+// Charges des deux filles de f (sites de c[0, m) dans chacune) : c dans la fille basse si et seulement si c est dans
+// S et sa coordonnee sur l'axe de coupe est < mid.
+inline void child_loads(const Ctx& C, const Fit& f, const u32* c, u32 m, u64 l[2]) {
+  const Box& S = f.S;
+  const int ax = f.ax;
+  u64 a = 0, b = 0;
+  for (u32 t = 0; t < m; ++t) {
+    const P3& x = C.X[c[t]];
+    const bool in = x.x >= S.lo[0] && x.x < S.hi[0] && x.y >= S.lo[1] && x.y < S.hi[1] && x.z >= S.lo[2] &&
+                    x.z < S.hi[2];
+    const i64 v = ax == 0 ? x.x : (ax == 1 ? x.y : x.z);
+    a += in && v < f.mid;
+    b += in && v >= f.mid;
+  }
+  l[0] += a;
+  l[1] += b;
+}
