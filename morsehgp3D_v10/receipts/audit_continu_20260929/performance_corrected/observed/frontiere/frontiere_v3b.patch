+// Developpe une tache sur un ouvrier : filtre, ajustement, puis feuille (enumeree ici) ou deux filles ; une fille de
+// charge > cap est a developper (dev), les autres sont gardees (kept).
+void expand(const Ctx& C, Local& L, const Task& t, u64 cap, std::vector<Task>& dev, std::vector<Task>& kept) {
+  ++L.led.nodes;
+  List cand;
+  filter_node(C, L, t.box, *t.parent, cand);
+  if (cand.empty()) {
+    ++L.led.skipped_bbox;
+    return;
+  }
+  const u32 m = static_cast<u32>(cand.size());
+  Fit f;
+  if (!decide(C, L, t.box, envelope(C, cand.data(), m), m, t.parent->size(), t.parent_stag, f)) return;
+  if (!f.split) {
+    leaf(C, L, cand, f);
