+        w.t = std::move(ch);
+        out.push_back(std::move(w));
+      } else {
+        kept_w[wk].push_back(std::move(ch));
+      }
+    }
+    push(wk, out);
+    return true;
+  }
+
+  void worker(unsigned wk) {
+    std::vector<Task> dev;
+    std::vector<Work> out;
+    u32 misses = 0;
+    for (;;) {
+      Work w;
+      if (!pop(wk, w)) {
+        if (pending.load(std::memory_order_acquire) == 0) return;
+        if (++misses < kIdleSpins) {
+          std::this_thread::yield();
+        } else {
+          sleep();
+          misses = 0;
+        }
+        continue;
+      }
+      misses = 0;
+      if (w.big == nullptr) {
+        dev.clear();
+        expand(C, locals[wk], w.t, cap, dev, kept_w[wk]);
+        w.t.parent.reset();
+        for (Task& d : dev) {
+          Work x;
+          x.t = std::move(d);
+          out.push_back(std::move(x));
+        }
+        push(wk, out);
+      } else {
+        Big* b = w.big;
+        run_piece(b, w.piece);
+        if (b->remaining.fetch_sub(1, std::memory_order_acq_rel) == 1 && finish_phase(b, wk, out)) delete b;
+      }
+      if (pending.fetch_sub(1, std::memory_order_acq_rel) == 1) wake();
+    }
+  }
