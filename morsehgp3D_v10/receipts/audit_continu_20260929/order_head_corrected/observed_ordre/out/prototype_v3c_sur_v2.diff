+// Seaux de la partition des cles : exposant binaire et kBucketBits bits hauts de mantisse de l'approximation. Pour
+// des doubles positifs, l'ordre des motifs de bits est celui des valeurs : la partition est monotone. Domaine u18 :
+// niveau dans [2^-2, 2^38] ; les exposants hors de [kExpLo, kExpHi) vont aux seaux extremes (toujours monotone).
+constexpr int kBucketBits = 6;
+constexpr u64 kExpLo = 1023 - 4, kExpHi = 1023 + 44;
+constexpr u32 kBuckets = u32((kExpHi - kExpLo) << kBucketBits);
+inline u32 bucket_of(double a) {
+  u64 bits;
+  std::memcpy(&bits, &a, sizeof bits);
+  const u64 top = bits >> (52 - kBucketBits);
+  constexpr u64 lo = kExpLo << kBucketBits, hi = kExpHi << kBucketBits;
+  return top < lo ? 0 : (top >= hi ? kBuckets - 1 : u32(top - lo));
+}
