+    if (nbig >= 2) {
+      for (u32 j = j0; j < j1; ++j) {
+        Node& b = N[d.child_val[j]];
+        if (b.mass >= mcs) {
+          tstab[c] += double(u64(b.mass)) * (lam - tbirth[c]);
+          b.cl = new_cluster(c, lam, b.mass) | kWork;
+        } else {
+          for (u32 k = 0; k < b.mass; ++k) tstab[c] += drop;
+          b.cl = c;
+          b.from = v;
+        }
+      }
+    } else {
+      u64 dropped = 0;
+      for (u32 j = j0; j < j1; ++j) {
+        Node& b = N[d.child_val[j]];
+        if (b.mass >= mcs) {
+          b.cl = c | kWork;
+        } else {
+          b.cl = c;
+          b.from = v;
+          dropped += b.mass;
+        }
+      }
+      for (u64 k = 0; k < dropped; ++k) tstab[c] += drop;
+    }
+  }
+  // numeros definitifs : pile LIFO de la reference rejouee sur l'arbre des clusters
+  const u32 m = static_cast<u32>(tparent.size());
+  std::vector<u32> fin(m, kNone), order;
+  order.reserve(m);
+  fin[0] = 0;
+  order.push_back(0);
+  std::vector<u32> stack(1, 0);
+  while (!stack.empty()) {
+    const u32 c = stack.back();
+    stack.pop_back();
+    for (u32 k : tkids[c]) {
+      fin[k] = static_cast<u32>(order.size());
+      order.push_back(k);
+    }
+    for (u32 k : tkids[c]) stack.push_back(k);
+  }
+  t.parent.resize(m);
+  t.birth.resize(m);
+  t.stability.resize(m);
+  t.mass.resize(m);
+  for (u32 k = 0; k < m; ++k) {
+    const u32 o = order[k];
+    t.parent[k] = tparent[o] == kNone ? kNone : fin[tparent[o]];
+    t.birth[k] = tbirth[o];
+    t.stability[k] = tstab[o];
+    t.mass[k] = tmass[o];
+  }
+  for (u32 v = 0; v < n; ++v) t.node_cluster[v] = fin[N[v].cl & ~kWork];
+  for (u32 x = 0; x < np; ++x) t.point_cluster[x] = fin[t.point_cluster[x]];
+  return t;
+}
