+        for (u64 v = chunk_lo(c, n); v < chunk_lo(c + 1, n); ++v) {
+          const u32 j0 = d.child_off[v], j1 = d.child_off[v + 1];
+          if (j0 > j1 || j1 > n - 1) bad.store(1, std::memory_order_relaxed);
