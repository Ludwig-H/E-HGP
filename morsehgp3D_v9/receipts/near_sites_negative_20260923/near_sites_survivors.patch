+namespace mhgp9::gen {
+
+// v9 (23 septembre 2026). The k nearest OTHER sites of every site of an
+// immutable index: exact squared distances, ties broken by original ID, so
+// the lists are a deterministic function of the cloud (any worker count).
+// They only feed the near-site dead-lane certificate (lanes/q34_dead_lanes),
+// for which ANY site subset is sound: a list changes the work, never the
+// emitted stream.
+struct Q34NearSitesWork {
+  u64 queries{}, node_visits{}, point_tests{};
+  bool operator==(const Q34NearSitesWork&) const = default;
+};
+
+class Q34NearSites;
+using Q34NearSitesPtr = std::shared_ptr<const Q34NearSites>;
+
+class Q34NearSites final {
+ public:
+  // k in 1..64; workers >= 1 threads split the sites statically.
+  [[nodiscard]] static Q34NearSitesPtr build(Q2CensusIndexPtr index, unsigned k, std::size_t workers);
+  Q34NearSites(const Q34NearSites&) = delete;
+  Q34NearSites& operator=(const Q34NearSites&) = delete;
+  // The (at most k) nearest other sites of original ID `id`, nearest first.
+  [[nodiscard]] std::span<const std::uint32_t> of(std::size_t id) const noexcept {
+    return {ids_.data() + id * k_, counts_[id]};
+  }
+  [[nodiscard]] unsigned k() const noexcept { return k_; }
+  [[nodiscard]] const Q34NearSitesWork& work() const noexcept { return work_; }
+  [[nodiscard]] std::size_t retained_bytes() const noexcept {
+    return ids_.capacity() * sizeof(std::uint32_t) + counts_.capacity() * sizeof(std::uint8_t);
+  }
+
+ private:
+  Q34NearSites() = default;
+  unsigned k_{};
+  std::vector<std::uint32_t> ids_;   // n * k, row id holds the nearest sites of id
+  std::vector<std::uint8_t> counts_;  // per id, min(k, n - 1)
+  Q34NearSitesWork work_{};
+};
+
+}  // namespace mhgp9::gen
