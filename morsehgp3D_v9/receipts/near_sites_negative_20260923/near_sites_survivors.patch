+#include <exception>
+#include <limits>
+#include <stdexcept>
+#include <thread>
+#include <utility>
+
+namespace mhgp9::gen {
+namespace {
+
+using Candidate = std::pair<i64, std::uint32_t>;  // squared distance, original ID
+
+i64 squared_distance(const Point3& p, const Point3& q) {
+  i64 sum = 0;
+  for (std::size_t axis = 0; axis < 3; ++axis) {
+    const i64 d = static_cast<i64>(p[axis]) - static_cast<i64>(q[axis]);
+    sum += d * d;  // |d| < 2^18: each square < 2^36, the sum < 2^38
+  }
+  return sum;
+}
+
+// Exact lower bound of the squared distance from p to a closed box.
+i64 box_distance(const Point3& p, const Box3& box) {
+  i64 sum = 0;
+  for (std::size_t axis = 0; axis < 3; ++axis) {
+    const i64 x = p[axis], low = box.low[axis], high = box.high[axis];
+    const i64 d = x < low ? low - x : (x > high ? x - high : 0);
+    sum += d * d;
+  }
+  return sum;
+}
+
+// The k nearest other sites of `id`: max-heap on (distance, ID); a node is
+// skipped only when its box lower bound is STRICTLY above the worst kept
+// distance (an equal bound may still hold a smaller ID).
+void nearest(const Q2CensusIndex& index, std::size_t id, unsigned k, std::vector<Candidate>& heap,
+             std::vector<std::size_t>& stack, std::uint32_t* out, std::uint8_t& count, Q34NearSitesWork& work) {
+  const auto nodes = index.spatial_nodes();
+  const auto order = index.spatial_order();
+  const auto points = index.cloud().points();
+  const auto& p = points[id];
+  heap.clear();
+  stack.clear();
+  stack.push_back(0);
+  counter_add(work.queries);
+  while (!stack.empty()) {
+    const auto& node = nodes[stack.back()];
+    stack.pop_back();
+    counter_add(work.node_visits);
+    const i64 bound = box_distance(p, node.box);
+    if (heap.size() == k && bound > heap.front().first) continue;
+    if (node.range.size() == 1) {
+      const auto site = order[node.range.first];
+      if (site == id) continue;
+      counter_add(work.point_tests);
+      const Candidate candidate{squared_distance(p, points[site]), static_cast<std::uint32_t>(site)};
+      if (heap.size() < k) {
+        heap.push_back(candidate);
+        std::push_heap(heap.begin(), heap.end());
+      } else if (candidate < heap.front()) {
+        std::pop_heap(heap.begin(), heap.end());
+        heap.back() = candidate;
+        std::push_heap(heap.begin(), heap.end());
+      }
+      continue;
+    }
+    // Nearer child popped first.
+    const auto& left = nodes[node.left];
+    const auto& right = nodes[node.right];
+    if (box_distance(p, left.box) <= box_distance(p, right.box)) {
+      stack.push_back(node.right);
+      stack.push_back(node.left);
+    } else {
+      stack.push_back(node.left);
+      stack.push_back(node.right);
+    }
+  }
+  std::sort_heap(heap.begin(), heap.end());
+  count = static_cast<std::uint8_t>(heap.size());
+  for (std::size_t j = 0; j < heap.size(); ++j) out[j] = heap[j].second;
+}
+
+}  // namespace
+
+Q34NearSitesPtr Q34NearSites::build(Q2CensusIndexPtr index, unsigned k, std::size_t workers) {
+  if (!index) throw std::invalid_argument("mhgp9 gen near sites require an immutable index");
+  if (k == 0 || k > 64) throw std::invalid_argument("mhgp9 gen near sites require k in 1..64");
+  if (workers == 0) throw std::invalid_argument("mhgp9 gen near sites require at least one worker");
+  const std::size_t n = index->cloud().points().size();
+  if (n > std::numeric_limits<std::uint32_t>::max()) throw std::overflow_error("mhgp9 gen near sites exceed u32 IDs");
+  std::shared_ptr<Q34NearSites> result(new Q34NearSites());
+  result->k_ = k;
+  result->ids_.assign(n * k, 0);
+  result->counts_.assign(n, 0);
+  const std::size_t threads = std::max<std::size_t>(1, std::min(workers, n / 1024 + 1));
+  std::vector<Q34NearSitesWork> parts(threads);
+  std::vector<std::exception_ptr> failures(threads);
+  // Every thread catches its own failure: no exception leaves a std::thread.
+  const auto run = [&](std::size_t t) {
+    try {
+      std::vector<Candidate> heap;
+      std::vector<std::size_t> stack;
+      heap.reserve(k + 1);
+      for (std::size_t id = n * t / threads; id < n * (t + 1) / threads; ++id)
+        nearest(*index, id, k, heap, stack, result->ids_.data() + id * k, result->counts_[id], parts[t]);
+    } catch (...) {
+      failures[t] = std::current_exception();
+    }
+  };
+  {
+    std::vector<std::thread> pool;
+    pool.reserve(threads - 1);
+    std::exception_ptr launch;
+    try {
+      for (std::size_t t = 1; t < threads; ++t) pool.emplace_back(run, t);
+    } catch (...) {
+      launch = std::current_exception();
+    }
+    if (!launch) run(0);
+    for (auto& thread : pool) thread.join();
+    if (launch) std::rethrow_exception(launch);
+    for (const auto& failure : failures) if (failure) std::rethrow_exception(failure);
+  }
+  for (const auto& part : parts) {
+    counter_add(result->work_.queries, part.queries);
+    counter_add(result->work_.node_visits, part.node_visits);
+    counter_add(result->work_.point_tests, part.point_tests);
+  }
+  return result;
+}
+
+}  // namespace mhgp9::gen
