+Q34DeadLaneProver::Bounds Q34DeadLaneProver::node_bounds(const Box3& box, i64 alpha, i64 beta) const {
+  // Q4LocalGeometry::node_bounds_unchecked at ONE center (alpha, beta), with
+  // this prover's basis, midpoint and 2^20 scale. i64 domain (M=262143):
+  // |w|<=2M<2^19, |alpha|,|beta|<=2^21 and |basis|<=M give |T|<=4MQ<2^40;
+  // Q*w^2<2^58 and 2|w||T|<2^60, the three-axis sum with Q*D (<3*2^56) stays
+  // <2^62. Only T^2 (<2^80) needs i128; Q is a power of two, so floor(T^2/Q)
+  // is a shift and the remainder a mask. For fixed center L is separable and
+  // convex in w: interval endpoints give the exact maximum, the clamped
+  // vertex T/Q the minimum, rounded DOWN (a certified lower bound). On a
+  // point box both equal the exact form value (T=Q*w leaves no remainder).
+  i64 minimum = -scale * diameter_squared_, maximum = minimum;
+  for (std::size_t axis = 0; axis < 3; ++axis) {
+    const i64 low = 2 * static_cast<i64>(box.low[axis]) - midpoint_twice_[axis];
+    const i64 high = 2 * static_cast<i64>(box.high[axis]) - midpoint_twice_[axis];
+    const i64 target = a_basis_[axis] * alpha + b_basis_[axis] * beta;
+    const i64 at_low = scale * low * low - 2 * low * target, at_high = scale * high * high - 2 * high * target;
+    maximum += std::max(at_low, at_high);
+    if (target < scale * low) minimum += at_low;
+    else if (target > scale * high) minimum += at_high;
+    else {
+      const i128 square = static_cast<i128>(target) * target;
+      minimum -= static_cast<i64>(square >> scale_bits) + ((square & (scale - 1)) != 0 ? 1 : 0);
+    }
+  }
+  return {minimum, maximum};
+}
+
+Q34DeadLaneProver::Class Q34DeadLaneProver::classify(std::uint32_t& element, const Cell& c, std::size_t& size,
+                                                     Tally& tally) {
+  const auto nodes = index_->spatial_nodes();
+  if ((element & form_bit) == 0) {
+    const auto& node = nodes[element];
+    size = node.range.size();
+    if (size != 1) {
+      // L is affine in the center: box x cell extrema are those of the four
+      // corners; the maximum is exact, the minimum a certified lower bound.
+      ++tally.node;
+      Bounds all = node_bounds(node.box, c.left, c.bottom);
+      for (unsigned corner = 1; corner < 4; ++corner) {
+        const auto b = node_bounds(node.box, (corner & 1U) ? c.right : c.left, (corner & 2U) ? c.top : c.bottom);
+        all.minimum = std::min(all.minimum, b.minimum);
+        all.maximum = std::max(all.maximum, b.maximum);
+      }
+      if (all.maximum < 0) return Class::inside;
+      return all.minimum >= 0 ? Class::dropped : Class::uncertain;
+    }
+    // A singleton becomes its exact form once; the element now names it.
+    if (forms_.size() >= form_bit) throw std::overflow_error("mhgp9 gen dead-lane prover form IDs exceed 2^31");
+    forms_.push_back(form_of(index_->spatial_points()[node.range.first]));
+    ++tally.forms;
+    element = form_bit | static_cast<std::uint32_t>(forms_.size() - 1);
+  }
+  size = 1;
+  ++tally.uniform;
+  const auto& f = forms_[element & ~form_bit];
+  const i64 maximum = f.constant + f.x * (f.x < 0 ? c.left : c.right) + f.y * (f.y < 0 ? c.bottom : c.top);
+  if (maximum < 0) return Class::inside;
+  const i64 minimum = f.constant + f.x * (f.x < 0 ? c.right : c.left) + f.y * (f.y < 0 ? c.top : c.bottom);
+  return minimum < 0 ? Class::partial : Class::dropped;
+}
+
+std::size_t Q34DeadLaneProver::corner_count(std::span<const std::uint32_t> elements, i64 alpha, i64 beta,
+                                            std::size_t needed, Tally& tally) {
+  // Sites strictly inside the ball of center (alpha, beta), up to `needed`.
+  // Forms: exact value. Nodes (never singletons here): exact maximum and
+  // certified minimum at that center; undecided nodes are opened on a local
+  // stack, down to singletons whose point bounds are the exact value.
+  const auto nodes = index_->spatial_nodes();
+  std::size_t count = 0;
+  for (const auto element : elements) {
+    if (count >= needed) break;
+    if ((element & form_bit) != 0) {
+      ++tally.point;
+      const auto& f = forms_[element & ~form_bit];
+      if (f.constant + f.x * alpha + f.y * beta < 0) ++count;
+      continue;
+    }
+    stack_.clear();
+    stack_.push_back(element);
+    while (!stack_.empty() && count < needed) {
+      const auto& node = nodes[stack_.back()];
+      stack_.pop_back();
+      ++tally.node_point;
+      const auto b = node_bounds(node.box, alpha, beta);
+      if (b.maximum < 0) count += node.range.size();
+      else if (b.minimum < 0) {
+        // Not a singleton: on a point box the bounds are equal.
+        stack_.push_back(static_cast<std::uint32_t>(node.right));
+        stack_.push_back(static_cast<std::uint32_t>(node.left));
+      }
+    }
+  }
+  return count;
+}
+
+void Q34DeadLaneProver::flush(const Tally& tally, Q34DeadLaneWork& work) {
+  counter_add(work.uniform_tests, tally.uniform);
+  counter_add(work.point_tests, tally.point);
+  counter_add(work.node_tests, tally.node);
+  counter_add(work.node_point_tests, tally.node_point);
+  counter_add(work.node_splits, tally.splits);
+  counter_add(work.form_sites, tally.forms);
+}
+
+std::uint8_t Q34DeadLaneProver::cell_nodes(const Cell& c, unsigned depth, std::span<std::uint32_t> frontier,
+                                           std::size_t inherited, std::uint8_t lanes, Q34DeadLaneWork& work) {
+  // Same decisions as cell() on the same cover (class comment): only the
+  // elements differ. `inside` counts CREDITED sites; the exact count of the
+  // cell lies in [inside, inside + pending_sites] and each threshold is
+  // settled by splitting pending nodes until that interval excludes it.
+  counter_add(work.cells);
+  std::uint8_t need = 0;
+  if ((lanes & 2U) != 0 && !outside(c, q3_disk_factor)) need = static_cast<std::uint8_t>(need | 2U);
+  if ((lanes & 4U) != 0 && !outside(c, q4_disk_factor)) need = static_cast<std::uint8_t>(need | 4U);
+  if (need == 0) { counter_add(work.outside_cells); return lanes; }
+  std::size_t inside = inherited;
+  if (depth >= min_depth_) {
+    const std::size_t target = (need & 2U) != 0 ? threshold3_ : threshold4_;
+    if (inside >= target) { counter_add(work.deep_cells); return lanes; }
+    auto& next = levels_[depth];
+    next.clear();
+    pending_.clear();
+    std::size_t pending_sites = 0;
+    Tally tally{};
+    // True once the credited count reaches the cell target (cell proved).
+    // A singleton element is rewritten in place to its form (computed once).
+    const auto take = [&](std::uint32_t& element) {
+      std::size_t size = 0;
+      switch (classify(element, c, size, tally)) {
+        case Class::inside: inside += size; return inside >= target;
+        case Class::dropped: return false;
+        case Class::partial: next.push_back(element); return false;
+        case Class::uncertain: pending_.push_back(element); pending_sites += size; return false;
+      }
+      return false;
+    };
+    const auto settle = [&](std::size_t threshold) {
+      while (inside < threshold && inside + pending_sites >= threshold && !pending_.empty()) {
+        const auto& node = index_->spatial_nodes()[pending_.back()];
+        pending_.pop_back();
+        pending_sites -= node.range.size();
+        ++tally.splits;
+        std::uint32_t left = static_cast<std::uint32_t>(node.left), right = static_cast<std::uint32_t>(node.right);
+        if (take(left) || take(right)) return true;
+      }
+      return false;
+    };
+    bool proved = false;
+    for (auto& element : frontier)
+      if (take(element)) { proved = true; break; }
+    if (!proved) proved = settle(target);
+    // q4 may already hold here (T4 <= exact count < T3): only q3 is refined.
+    if (!proved && (need & 6U) == 6U) {
+      proved = settle(threshold4_);  // never reaches T3: inside + pending_sites < T3 already
+      if (inside >= threshold4_) need = static_cast<std::uint8_t>(need & ~4U);
+    }
+    if (proved) {
+      flush(tally, work);
+      counter_add(work.deep_cells);
+      return lanes;
+    }
+    // Exact depth at a lane center of the cell (its corner), capped at T3:
+    // credited sites are negative there, the partial singletons and the
+    // pending nodes hold every other candidate.
+    std::size_t count = inside;
+    bool counted = false, refuted = false;
+    for (const std::uint8_t lane : {std::uint8_t{2}, std::uint8_t{4}}) {
+      if ((need & lane) == 0) continue;
+      const std::size_t lane_target = lane == 2U ? threshold3_ : threshold4_;
+      if (!center_inside(c.left, c.bottom, lane == 2U ? q3_disk_factor : q4_disk_factor)) continue;
+      if (!counted) {
+        const std::size_t needed = threshold3_ - inside;
+        count += corner_count(next, c.left, c.bottom, needed, tally);
+        if (count < threshold3_) count += corner_count(pending_, c.left, c.bottom, threshold3_ - count, tally);
+        counted = true;
+      }
+      if (count < lane_target) {
+        need = static_cast<std::uint8_t>(need & ~lane);
+        lanes = static_cast<std::uint8_t>(lanes & ~lane);
+        refuted = true;
+      }
+    }
+    flush(tally, work);
+    if (refuted) counter_add(work.failed_cells);
+    if (need == 0) return lanes;
+    next.insert(next.end(), pending_.begin(), pending_.end());
+    frontier = next;
+  }
+  if (depth == max_depth_) {
+    counter_add(work.failed_cells);
+    return static_cast<std::uint8_t>(lanes & ~need);
+  }
+  const i64 x = c.left + (c.right - c.left) / 2, y = c.bottom + (c.top - c.bottom) / 2;
+  const Cell children[4] = {{c.left, x, c.bottom, y}, {x, c.right, c.bottom, y},
+                            {c.left, x, y, c.top}, {x, c.right, y, c.top}};
+  for (const auto& child : children) {
+    const std::uint8_t kept = cell_nodes(child, depth + 1, frontier, inside, need, work);
+    lanes = static_cast<std::uint8_t>(lanes & ~(need & ~kept));  // lanes refuted in the child
+    need = static_cast<std::uint8_t>(need & kept);
+    if (need == 0) break;
+  }
+  return lanes;
+}
