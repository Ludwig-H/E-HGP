+void accumulate(Q34WitnessBoundsWork& a, const Q34WitnessBoundsWork& b) {
+  static_assert(sizeof(Q34WitnessBoundsWork) == 12 * sizeof(u64));
+  for (auto field : {&Q34WitnessBoundsWork::queries, &Q34WitnessBoundsWork::pair_preparations,
+       &Q34WitnessBoundsWork::general_preparations, &Q34WitnessBoundsWork::affine_h_tests,
+       &Q34WitnessBoundsWork::affine_xi_tests, &Q34WitnessBoundsWork::xi_on_nonpositive_minimum,
+       &Q34WitnessBoundsWork::q3_exclusion_tests, &Q34WitnessBoundsWork::q4_exclusion_tests,
+       &Q34WitnessBoundsWork::q3_excluded_nodes, &Q34WitnessBoundsWork::q4_excluded_nodes,
+       &Q34WitnessBoundsWork::fully_excluded_nodes, &Q34WitnessBoundsWork::mixed_terminal_nodes})
+    counter_add(a.*field, b.*field);
+}
