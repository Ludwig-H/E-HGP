+void accumulate(Q34WitnessSearchWork& a, const Q34WitnessSearchWork& b) {
+  static_assert(sizeof(Q34WitnessSearchWork) == 25 * sizeof(u64));
+  for (auto field : {&Q34WitnessSearchWork::queries, &Q34WitnessSearchWork::q3_queries,
+       &Q34WitnessSearchWork::q4_queries, &Q34WitnessSearchWork::prepared_bounds,
+       &Q34WitnessSearchWork::node_visits, &Q34WitnessSearchWork::h_bound_tests,
+       &Q34WitnessSearchWork::xi_bound_tests, &Q34WitnessSearchWork::point_tests,
+       &Q34WitnessSearchWork::h_excluded_nodes, &Q34WitnessSearchWork::admitted_nodes,
+       &Q34WitnessSearchWork::fully_admitted_nodes, &Q34WitnessSearchWork::leaf_remainders,
+       &Q34WitnessSearchWork::split_nodes, &Q34WitnessSearchWork::q3_lane_tests,
+       &Q34WitnessSearchWork::q4_lane_tests, &Q34WitnessSearchWork::q3_admitted_nodes,
+       &Q34WitnessSearchWork::q4_admitted_nodes, &Q34WitnessSearchWork::q3_credits,
+       &Q34WitnessSearchWork::q4_credits, &Q34WitnessSearchWork::q3_rejected,
+       &Q34WitnessSearchWork::q4_rejected, &Q34WitnessSearchWork::midpoint_box_tests,
+       &Q34WitnessSearchWork::pending_nodes_skipped})
+    counter_add(a.*field, b.*field);
+  a.peak_stack = std::max(a.peak_stack, b.peak_stack);
+  a.stack_storage_bytes = std::max(a.stack_storage_bytes, b.stack_storage_bytes);
+}
