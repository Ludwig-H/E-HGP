@@ -1,9 +1,12 @@
 #pragma once
 
+#include <array>
+#include <bit>
 #include <cstddef>
 #include <cstdint>
 #include <limits>
 #include <stdexcept>
+#include <type_traits>
 
 namespace mhgp9::gen {
 
@@ -127,7 +130,24 @@
   u64 negative_probes{};
 };
 
-inline void counter_add(u64& value, u64 increment = 1) {
+// One step carries no check and no throw (hot path). It cannot wrap: a
+// ledger that starts from zero never reaches 2^63 in a feasible run, and a
+// public entry that receives a caller's ledger first requires the headroom
+// below (one call makes far fewer than 2^63 steps).
+inline void counter_add(u64& value) noexcept { ++value; }
+
+// Caller-supplied ledger (all-u64 aggregate): any word at or above 2^63 is
+// refused before the call changes it.
+template <class Work>
+void require_ledger_headroom(const Work& work) {
+  static_assert(std::is_trivially_copyable_v<Work> && sizeof(Work) % sizeof(u64) == 0);
+  const auto words = std::bit_cast<std::array<u64, sizeof(Work) / sizeof(u64)>>(work);
+  for (const auto word : words)
+    if ((word >> 63) != 0) throw std::overflow_error("mhgp9 gen work counter overflow");
+}
+
+// Arbitrary increments (masses, sizes) keep the exact overflow refusal.
+inline void counter_add(u64& value, u64 increment) {
   if (increment > std::numeric_limits<u64>::max() - value) {
     throw std::overflow_error("mhgp9 gen work counter overflow");
   }
