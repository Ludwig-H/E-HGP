+  }
+};
+inline Global global;
+struct Local {
+  unsigned long long rows[2][8]{};
+  ~Local() { for (int r = 0; r < 2; ++r) for (int i = 0; i < 8; ++i) global.v[r][i] += rows[r][i]; }
+};
+inline Local& local() { thread_local Local l; return l; }
+struct Scope {
+  bool open = false;
+  unsigned long long t = __rdtsc();
+  ~Scope() { if (open) local().rows[1][7] += __rdtsc() - t; }
+};
