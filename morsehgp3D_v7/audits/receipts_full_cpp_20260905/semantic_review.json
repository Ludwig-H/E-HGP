      "id": "coverage_scheduling_cap",
      "source_lines": "full_certificate.hpp:265-295",
      "argument": "visited+pending.size<=max_nodes is preserved by pop/visit and checked prospective scheduling, preventing unsigned subtraction underflow"
    },
    {
      "id": "transaction_and_move",
      "source_lines": "full_certificate.hpp:49-79,105-116,171-214",
      "argument": "private temporary arenas discarded on refusal; no-copy/noexcept swaps transfer all arenas and invalidate source; readers reject invalid moved-from values"
    },
    {
      "id": "terminal_order",
      "source_lines": "full_certificate.hpp:117-167,179-206",
      "argument": "K=n admits only the single complete-domain facet; unique minima and parent arity >=2 force exactly one leaf and no merges on every successful construction"
    },
    {
      "id": "zero",
      "source_lines": "full_certificate.hpp:156-165,238-239",
      "argument": "K1 all points at level0 with no later births; open0 excludes that lot, closed0 includes it; K>1 zero batches rejected"
    },
