#!/usr/bin/env python3
"""Create-only metadata supplement. No active sources or external state changed."""
import argparse
import difflib
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import time

HERE = Path(__file__).resolve().parent
REPO = HERE.parents[1]
BASE = REPO / "morsehgp3D_v7/receipts/full_t2_census_tower_20260911"
NAMES = ("line12", "shell14", "spatial12")


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--out", required=True)
    parser.add_argument("--mode", choices=("causal", "o2", "san"), required=True)
    args = parser.parse_args()
    out = HERE / args.out
    out.mkdir(exist_ok=False)
    paths = sorted([p for p in (HERE / "source").rglob("*") if p.is_file()] +
                   [p for p in HERE.iterdir() if p.is_file() and p.suffix in (".py", ".json", ".md")])
    before = {str(p.relative_to(HERE)): sha(p) for p in paths}
    snapshot = out / "source_snapshot"
    for path in paths:
        target = snapshot / path.relative_to(HERE)
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(path, target)
    baseline = {name: json.loads((BASE / "runs/o2" / (name + ".stdout")).read_bytes()) for name in NAMES}
    (out / "baseline_results.json").write_text(json.dumps(baseline, indent=2, sort_keys=True) + "\n")
    patch = []
    for name in ("t2_gate.cpp", "source/morsehgp3D_v7/src/forest/full_coverage_certificate.hpp",
                 "source/morsehgp3D_v7/src/forest/full_ball_tower.hpp"):
        patch.extend(difflib.unified_diff((BASE / "source" / name).read_text().splitlines(keepends=True),
            (snapshot / "source" / name).read_text().splitlines(keepends=True), fromfile="closed/" + name,
            tofile="private/" + name))
    (out / "private_patch.diff").write_text("".join(patch))
    receipt = dict(status="running", mode=args.mode, sources_before=before, commands=[], binaries={},
                   GCP_used=False, device_executed=False, public_status="not_claimed", compiler_jobs=1,
                   source_receipt_manifest_sha256=sha(BASE / "manifest.json"),
                   legacy_gate_exact=sha(snapshot / "source/t2_legacy_gate.cpp") == sha(BASE / "source/t2_gate.cpp"))
    environment = dict(os.environ, ASAN_OPTIONS="detect_leaks=1:halt_on_error=1",
                       UBSAN_OPTIONS="halt_on_error=1:print_stacktrace=1")
    receipt["sanitizer_environment"] = {name: environment[name] for name in ("ASAN_OPTIONS", "UBSAN_OPTIONS")}

    def save():
        (out / "receipt.json").write_text(json.dumps(receipt, indent=2, sort_keys=True) + "\n")

    def run(name, command, expected=0, diagnostic=None, marker=None, expected_summary=None):
        intent = dict(argv=command, expected_exit=expected, causal_diagnostic=diagnostic, mutation_marker=marker)
        (out / (name + ".intent.json")).write_text(json.dumps(intent, indent=2) + "\n")
        print("start=" + name, flush=True)
        start = time.time_ns()
        with (out / (name + ".stdout")).open("wb") as stdout, (out / (name + ".stderr")).open("wb") as stderr:
            result = subprocess.run(command, cwd=REPO, env=environment, stdout=stdout, stderr=stderr)
        errors = (out / (name + ".stderr")).read_text()
        row = dict(name=name, argv=command, expected_exit=expected, exit_code=result.returncode,
                   started_ns=start, ended_ns=time.time_ns(), diagnostic=diagnostic, mutation_marker=marker,
                   diagnostic_matched=diagnostic is None or diagnostic in errors,
                   marker_count=errors.count(marker) if marker else None,
                   stdout_sha256=sha(out / (name + ".stdout")), stderr_sha256=sha(out / (name + ".stderr")))
        receipt["commands"].append(row)
        save()
        print(name, result.returncode, flush=True)
        if result.returncode != expected or not row["diagnostic_matched"] or (marker and not row["marker_count"]):
            raise ValueError(name + ": exit, causal diagnostic or mutation occurrence mismatch")
        if expected_summary is not None:
            actual = json.loads((out / (name + ".stdout")).read_bytes())
            if actual != expected_summary:
                raise ValueError(name + ": semantic output differs from pinned baseline plus new guards")

    def compile_gate(name, legacy, mutant):
        flags = ["-O1", "-g", "-fno-omit-frame-pointer", "-fsanitize=address,undefined", "-fno-sanitize-recover=all"] \
                if args.mode == "san" else ["-O2"]
        binary = out / name
        run("compile_" + name, ["g++", "-std=c++20", "-Wall", "-Wextra", "-Wpedantic", "-Werror", "-pthread",
            *flags, f"-DMHGP7_T2_METADATA_MUTANT={mutant}", "-isystem",
            str(REPO / "build/v7_boost_gate/extracted/usr/include"), "-MMD", "-MF", str(binary) + ".d",
            str(snapshot / "source" / ("t2_legacy_gate.cpp" if legacy else "t2_gate.cpp")), "-o", str(binary)])
        receipt["binaries"][name] = dict(before_execution_sha256=sha(binary))
        save()
        return binary

    save()
    try:
        if not receipt["legacy_gate_exact"]:
            raise ValueError("legacy gate not byte-identical")
        if args.mode == "causal":
            for legacy in (True, False):
                for mutant, label, reason, marker in (
                    (1, "order", "T2.metadata.order_identity", "T2_METADATA_MUTANT published_order=8 expected_order=9"),
                    (2, "vertical", "T2.metadata.vertical_node_indexed", "T2_METADATA_MUTANT surplus_vertical_entry=1 order=9")):
                    name = ("legacy_" if legacy else "checked_") + label
                    binary = compile_gate(name, legacy, mutant)
                    run("run_" + name, [str(binary), "--line12"], 0 if legacy else 1,
                        None if legacy else reason, marker, baseline["line12"] if legacy else None)
                    if receipt["commands"][-1]["marker_count"] != (18 if legacy else 1):
                        raise ValueError(name + ": unexpected number of actually mutated K9 outputs")
                    receipt["binaries"][name]["after_execution_sha256"] = sha(binary)
        else:
            binary = compile_gate("gate", False, 0)
            for name in NAMES:
                expected = dict(baseline[name]); expected["checks"] += 40
                run(name, [str(binary), "--" + name], expected_summary=expected)
            run("invalid_args", [str(binary), "--invalid"], 2)
            receipt["binaries"]["gate"]["after_execution_sha256"] = sha(binary)
        receipt["status"] = "passed"
    except Exception as error:
        receipt["status"] = "failed"
        receipt["error"] = str(error)
    finally:
        receipt["sources_after"] = {str(p.relative_to(HERE)): sha(p) for p in paths}
        receipt["sources_stable"] = before == receipt["sources_after"]
        for values in receipt["binaries"].values():
            if values.get("before_execution_sha256") != values.get("after_execution_sha256"):
                receipt["status"] = "failed"
        if not receipt["sources_stable"]:
            receipt["status"] = "failed"
        save()
    return 0 if receipt["status"] == "passed" else 1


if __name__ == "__main__":
    raise SystemExit(main())
