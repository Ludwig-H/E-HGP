#!/usr/bin/env python3
"""Copy the closed T2 source exactly into a new private tree."""
import hashlib
import json
from pathlib import Path
import shutil

HERE = Path(__file__).resolve().parent
REPO = HERE.parents[1]
RECEIPT = REPO / "morsehgp3D_v7/receipts/full_t2_census_tower_20260911"
target = HERE / "source"
shutil.copytree(RECEIPT / "source", target)
shutil.copy2(target / "t2_gate.cpp", target / "t2_legacy_gate.cpp")
files = {str(p.relative_to(RECEIPT / "source")): hashlib.sha256(p.read_bytes()).hexdigest()
         for p in sorted((RECEIPT / "source").rglob("*")) if p.is_file()}
(HERE / "baseline.json").write_text(json.dumps(dict(
    authority="closed T2 source copied unchanged before private patches",
    source_receipt=str(RECEIPT.relative_to(REPO)),
    source_manifest_sha256=hashlib.sha256((RECEIPT / "manifest.json").read_bytes()).hexdigest(), files=files),
    indent=2, sort_keys=True) + "\n")
print("copied", len(files), "sources; legacy gate is byte-identical")
