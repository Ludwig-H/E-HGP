using namespace mhgp7::gpu_intruder_private;
void need(bool condition, const char* reason) { if (!condition) throw std::runtime_error(reason); }
std::array<u64,12> host_layout() {
  return {sizeof(IndexView),alignof(IndexView),offsetof(IndexView,positions3),offsetof(IndexView,snapshot),
      sizeof(Request),alignof(Request),offsetof(Request,key_words),offsetof(Request,selected),
      sizeof(Result),alignof(Result),0,8};
}
#if defined(__CUDACC__)
__global__ void intruder_kernel(const u64* cases, u64* output, u64 count, const i32* left, const i32* right,
    const i32* first, const i32* last, const u16* boxes, const u16* positions, unsigned injection) {
  const u64 index=(u64)blockIdx.x*blockDim.x+threadIdx.x;
  if (index>=count || (injection==1 && index==count/2)) return;
  encode_result(evaluate_case(cases+kCaseWords*index,left,right,first,last,boxes,positions),output+kResultWords*index);
  if (injection==2 && index==0) output[1]^=1;
}
__global__ void layout_kernel(u64* output) {
  output[0]=sizeof(IndexView); output[1]=alignof(IndexView); output[2]=offsetof(IndexView,positions3);
  output[3]=offsetof(IndexView,snapshot); output[4]=sizeof(Request); output[5]=alignof(Request);
  output[6]=offsetof(Request,key_words); output[7]=offsetof(Request,selected);
  output[8]=sizeof(Result); output[9]=alignof(Result);
#if defined(__CUDA_ARCH__)
  output[10]=__CUDA_ARCH__;
#else
  output[10]=0;
#endif
  const u64 sample=0x0102030405060708ull;
  output[11]=*reinterpret_cast<const unsigned char*>(&sample);
}
struct Allocation {
  void* value=nullptr;
  ~Allocation() { if (value && cudaFree(value)!=cudaSuccess) std::fprintf(stderr,"cuda.cleanup_unknown after prior failure\n"); }
  void allocate(size_t bytes) { need(cudaMalloc(&value,bytes)==cudaSuccess,"cuda.allocate"); }
  template<class T> void upload(const std::vector<T>& source) {
    allocate(source.size()*sizeof(T));
    need(cudaMemcpy(value,source.data(),source.size()*sizeof(T),cudaMemcpyHostToDevice)==cudaSuccess,"cuda.upload");
  }
  template<class T> void verify_read_only(const std::vector<T>& source) {
    std::vector<T> restored(source.size());
    need(cudaMemcpy(restored.data(),value,source.size()*sizeof(T),cudaMemcpyDeviceToHost)==cudaSuccess,"cuda.index_readback");
    need(restored==source,"cuda.read_only_input_bytes");
  }
  void release() {
    const auto code=cudaFree(value);
    if (code==cudaSuccess) value=nullptr;
    need(code==cudaSuccess,"cuda.explicit_release_cleanup_unknown");
  }
};
#endif
int execute(int argc, char** argv) {
  if (argc<4 || std::string(argv[1])!="--selftest") return 2;
  const std::string file_name=argv[2], option=argv[3];
  if (!option.starts_with("--expected-sha=") || option.size()!=79) return 2;
  const std::string expected_sha=option.substr(15);
  bool host_only=false; unsigned injection=0;
  for (int i=4; i<argc; ++i) {
    const std::string arg=argv[i];
    if (arg=="--host" && !host_only) host_only=true;
    else if (arg=="--inject=skip-write" && !injection) injection=1;
    else if (arg=="--inject=corrupt-word" && !injection) injection=2;
    else return 2;
  }
  need(std::endian::native==std::endian::little,"host.little_endian");
  std::ifstream file(file_name,std::ios::binary);
  need(file.good(),"vectors.open");
  const std::string text((std::istreambuf_iterator<char>(file)),std::istreambuf_iterator<char>());
  Sha256 hash; hash.update(text.data(),text.size()); need(hash.hex()==expected_sha,"vectors.sha256");
  std::istringstream stream(text); const Fixtures f=read_fixtures(stream);
  const u64 count=f.cases.size()/kCaseWords;
  need(count>=590 && f.left.size()>100 && f.positions.size()>100,"vectors.nonvacuity");
  u64 rejected=0, found=0, missing=0, checked=0, peak49=0;
  std::vector<u64> actual(f.expected.size(),0xa5a5a5a5a5a5a5a5ull);
  for (u64 i=0; i<count; ++i) {
    u64 expected_host[kResultWords]{};
    encode_result(evaluate_case(f.cases.data()+kCaseWords*i,f.left.data(),f.right.data(),f.first.data(),f.last.data(),
        f.boxes.data(),f.positions.data()),expected_host);
    for (u32 j=0; j<kResultWords; ++j) {
      need(expected_host[j]==f.expected[kResultWords*i+j],"host.independent_expected_word"); ++checked;
    }
    const u64* row=f.expected.data()+kResultWords*i;
    if (row[0]) ++rejected;
    else if ((i64)row[1]<0) ++missing;
    else ++found;
    if (row[9]==49) ++peak49;
  }
  need(rejected>=13 && found>200 && missing>100 && peak49>0,"vectors.all_families_nonvacuous");
  bool device_executed=false;
  auto layout=host_layout();
#if defined(__CUDACC__)
  if (!host_only) {
    cudaDeviceProp properties{};
    need(cudaGetDeviceProperties(&properties,0)==cudaSuccess,"cuda.device_properties");
    need(properties.major==12 && properties.minor==0,"cuda.sm120_required");
    Allocation left,right,first,last,boxes,positions,cases,out,meta;
    left.upload(f.left); right.upload(f.right); first.upload(f.first); last.upload(f.last);
    boxes.upload(f.boxes); positions.upload(f.positions); cases.upload(f.cases);
    out.allocate(actual.size()*sizeof(u64)); meta.allocate(layout.size()*sizeof(u64));
    need(cudaMemset(out.value,0xa5,actual.size()*sizeof(u64))==cudaSuccess,"cuda.output_sentinel");
    need(cudaMemset(meta.value,0,layout.size()*sizeof(u64))==cudaSuccess,"cuda.layout_sentinel");
    layout_kernel<<<1,1>>>(static_cast<u64*>(meta.value));
    intruder_kernel<<<(count+127)/128,128>>>(static_cast<const u64*>(cases.value),static_cast<u64*>(out.value),count,
        static_cast<const i32*>(left.value),static_cast<const i32*>(right.value),static_cast<const i32*>(first.value),
        static_cast<const i32*>(last.value),static_cast<const u16*>(boxes.value),static_cast<const u16*>(positions.value),injection);
    need(cudaGetLastError()==cudaSuccess && cudaDeviceSynchronize()==cudaSuccess,"cuda.kernel_completion");
    need(cudaMemcpy(actual.data(),out.value,actual.size()*sizeof(u64),cudaMemcpyDeviceToHost)==cudaSuccess,"cuda.output_D2H");
    need(cudaMemcpy(layout.data(),meta.value,layout.size()*sizeof(u64),cudaMemcpyDeviceToHost)==cudaSuccess,"cuda.layout_D2H");
    auto required=host_layout(); required[10]=1200;
    need(layout==required,"cuda.pod_layout_and_arch");
    left.verify_read_only(f.left); right.verify_read_only(f.right); first.verify_read_only(f.first); last.verify_read_only(f.last);
    boxes.verify_read_only(f.boxes); positions.verify_read_only(f.positions); cases.verify_read_only(f.cases);
    // Success is printed only after all nine releases were explicitly checked.
    meta.release(); out.release(); cases.release(); positions.release(); boxes.release();
    last.release(); first.release(); right.release(); left.release();
    device_executed=true;
  } else
#else
  (void)host_only;
#endif
  {
    for (u64 i=0; i<count; ++i) {
      if (injection==1 && i==count/2) continue;
      encode_result(evaluate_case(f.cases.data()+kCaseWords*i,f.left.data(),f.right.data(),f.first.data(),f.last.data(),
          f.boxes.data(),f.positions.data()),actual.data()+kResultWords*i);
    }
    if (injection==2) actual[1]^=1;
  }
  for (size_t i=0; i<actual.size(); ++i) { need(actual[i]==f.expected[i],"backend.expected_word"); ++checked; }
  need(injection==0,"injection_must_be_refuted");
  std::printf("{\"status\":\"passed\",\"backend\":\"%s\",\"cases\":%llu,\"checked_words\":%llu,\"found\":%llu,\"missing\":%llu,\"rejected\":%llu,\"peak49_cases\":%llu,\"vectors_sha256\":\"%s\",\"device_arch\":%llu,\"device_executed\":%s,\"public_status\":\"not_claimed\"}\n",
      device_executed ? "CUDA" : "host_stub",(unsigned long long)count,(unsigned long long)checked,
      (unsigned long long)found,(unsigned long long)missing,(unsigned long long)rejected,(unsigned long long)peak49,
      expected_sha.c_str(),(unsigned long long)layout[10],device_executed ? "true" : "false");
  return 0;
}
}
int main(int argc, char** argv) {
  try { return execute(argc,argv); }
  catch (const std::exception& error) { std::fprintf(stderr,"FAIL %s\n",error.what()); return 1; }
}
