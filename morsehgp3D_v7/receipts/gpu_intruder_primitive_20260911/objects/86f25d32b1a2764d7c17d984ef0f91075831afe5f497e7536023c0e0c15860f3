#!/usr/bin/env python3
"""Create-only local captures. CUDA mode compiles and links, never launches."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import time

HERE = Path(__file__).resolve().parent
REPO = HERE.parents[1]


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--out", required=True)
    parser.add_argument("--mode", choices=("o2", "san", "mutants", "nvcc", "host", "host-san"), required=True)
    parser.add_argument("--vectors")
    args = parser.parse_args()
    out = HERE / args.out
    out.mkdir(exist_ok=False)
    paths = sorted([p for p in (HERE / "source").rglob("*") if p.is_file()] +
                   [p for p in HERE.iterdir() if p.is_file() and p.suffix in (".hpp", ".cuh", ".cpp", ".cu", ".py", ".json", ".md")])
    before = {str(p.relative_to(HERE)): sha(p) for p in paths}
    snapshot = out / "source_snapshot"
    for path in paths:
        target = snapshot / path.relative_to(HERE)
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(path, target)
    receipt = dict(status="running", mode=args.mode, sources_before=before, commands=[], device_executed=False,
                   GCP_used=False, public_status="not_claimed", measurements="qualification, not benchmark")
    environment = os.environ.copy()
    environment["ASAN_OPTIONS"] = "detect_leaks=1:halt_on_error=1"
    environment["UBSAN_OPTIONS"] = "halt_on_error=1:print_stacktrace=1"

    def save():
        (out / "receipt.json").write_text(json.dumps(receipt, indent=2, sort_keys=True) + "\n")

    def command(name, argv, expected=0):
        started = time.time_ns()
        with (out / (name + ".stdout")).open("wb") as stdout, (out / (name + ".stderr")).open("wb") as stderr:
            result = subprocess.run(argv, cwd=REPO, env=environment, stdout=stdout, stderr=stderr)
        receipt["commands"].append(dict(name=name, argv=argv, started_ns=started, ended_ns=time.time_ns(),
            exit_code=result.returncode, expected_exit_code=expected, stdout_sha256=sha(out / (name + ".stdout")),
            stderr_sha256=sha(out / (name + ".stderr"))))
        save()
        print(name, result.returncode, flush=True)
        if result.returncode != expected:
            raise ValueError(name + ": unexpected exit")

    save()
    try:
        strict = ["-Wall", "-Wextra", "-Wpedantic", "-Werror"]
        san = ["-O1", "-g", "-fno-omit-frame-pointer", "-fsanitize=address,undefined"]
        if args.mode in ("o2", "san", "mutants"):
            for mutant in (range(1, 7) if args.mode == "mutants" else (0,)):
                name = "gate" if not mutant else f"mutant{mutant}"
                binary = out / name
                command("compile_" + name, ["g++", "-std=c++20", *(san if args.mode == "san" else ["-O2"]), *strict,
                    f"-DMHGP7_INTRUDER_MUTANT={mutant}", "-isystem", str(REPO / "build/v7_boost_gate/extracted/usr/include"),
                    "-MMD", "-MF", str(binary) + ".d", str(snapshot / "gate.cpp"), "-o", str(binary)])
                command("run_" + name, [str(binary)], 1 if mutant else 0)
                if mutant:
                    diagnostic = (out / ("run_" + name + ".stderr")).read_text()
                    causal = {1: "axis.brute_integer_minimum", 2: "query.first_geometry_index_boost",
                              3: "query.first_geometry_index_boost", 4: "query.first_geometry_index_boost",
                              5: "query.first_geometry_index_boost", 6: "query.admission"}[mutant]
                    if not diagnostic.startswith("FAIL " + causal + " "):
                        raise ValueError(name + ": missing causal diagnostic: " + diagnostic)
                else:
                    receipt["binary_sha256"] = sha(binary)
                    command("invalid_args", [str(binary), "invalid"], 2)
                    if args.mode == "o2":
                        command("export_vectors", [str(binary), "--export"])
                        receipt["vectors_sha256"] = sha(out / "export_vectors.stdout")
        elif args.mode in ("host", "host-san", "nvcc"):
            binary = out / "device_gate"
            if args.mode == "nvcc":
                toolkit = REPO / "build/v7_nvcc_pedantic_20260910/toolkit"
                command("compile_link", [str(toolkit / "bin/nvcc"), "-std=c++20", "-O2", "--gpu-architecture=sm_120",
                    "-fmad=false", "--expt-relaxed-constexpr", "-Xptxas=-v", "-Xcompiler=-Wall,-Wextra,-Wpedantic,-Werror",
                    "-ccbin", str(snapshot / "nvcc_strict_host.py"), "-L" + str(toolkit / "lib"),
                    "-MMD", "-MF", str(binary) + ".d", str(snapshot / "device_gate.cu"), "-o", str(binary)])
            else:
                command("compile", ["g++", "-x", "c++", "-std=c++20", *(san if args.mode == "host-san" else ["-O2"]),
                    *strict, "-DMHGP7_FAKE_DEVICE", "-MMD", "-MF", str(binary) + ".d",
                    str(snapshot / "device_gate.cu"), "-o", str(binary)])
            receipt["binary_sha256"] = sha(binary)
            if args.vectors:
                vectors = Path(args.vectors).resolve()
                shutil.copy2(vectors, out / "vectors.txt")
                pin = sha(vectors)
                receipt["vectors_sha256"] = pin
                base = [str(binary), "--selftest", str(out / "vectors.txt"), "--expected-sha=" + pin]
                if args.mode == "nvcc":
                    base.append("--host")
                command("nominal", base)
                command("skip_write", [*base, "--inject=skip-write"], 1)
                command("corrupt_word", [*base, "--inject=corrupt-word"], 1)
                for name in ("skip_write", "corrupt_word"):
                    if "FAIL backend.expected_word" not in (out / (name + ".stderr")).read_text():
                        raise ValueError(name + ": missing causal diagnostic")
                bad = [arg if not arg.startswith("--expected-sha=") else "--expected-sha=" + "0"*64 for arg in base]
                command("wrong_pin", bad, 1)
                command("invalid_args", [str(binary), "invalid"], 2)
        receipt["status"] = "passed"
    except Exception as error:
        receipt["status"] = "failed"
        receipt["error"] = str(error)
    finally:
        receipt["sources_after"] = {str(p.relative_to(HERE)): sha(p) for p in paths}
        receipt["sources_stable"] = before == receipt["sources_after"]
        if not receipt["sources_stable"]:
            receipt["status"] = "failed"
        save()
    return 0 if receipt["status"] == "passed" else 1


if __name__ == "__main__":
    raise SystemExit(main())
