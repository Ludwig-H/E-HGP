#!/usr/bin/env python3
"""Serial create-only capture, raw streams and exact source pins."""
import argparse
import datetime
import hashlib
import json
import os
from pathlib import Path
import subprocess
import time

HERE = Path(__file__).resolve().parent


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def manifest():
    return {str(p.relative_to(HERE)): sha(p) for tree in ["baseline", "observed", "mutants"]
            for p in sorted((HERE / tree).rglob("*")) if p.is_file()}


def execute(name, argv, env=None):
    target = HERE / "runs" / name
    target.mkdir(parents=True)
    before = manifest()
    started = datetime.datetime.now(datetime.timezone.utc).isoformat()
    tick = time.monotonic()
    with (target / "stdout").open("wb") as out, (target / "stderr").open("wb") as err:
        result = subprocess.run(argv, cwd=HERE, stdout=out, stderr=err, env={**os.environ, **(env or {})}, check=False)
    after = manifest()
    receipt = {"schema": "mhgp7-private-initial-representatives-run-v1", "name": name,
               "argv": argv, "cwd": str(HERE), "environment_overlay": env or {},
               "started_utc": started, "elapsed_s": time.monotonic() - tick, "exit_code": result.returncode,
               "sources_before": before, "sources_after": after, "sources_stable": before == after,
               "stdout_sha256": sha(target / "stdout"), "stderr_sha256": sha(target / "stderr"),
               "instrumented_not_benchmark": name.startswith("observed_")}
    receipt["recorder_sha256"] = sha(Path(__file__))
    receipt["executables"] = {arg: sha(Path(arg)) for arg in argv
                              if str(HERE / "bin") in arg and Path(arg).is_file()}
    (target / "receipt.json").write_text(json.dumps(receipt, indent=2) + "\n")
    print(json.dumps({k: receipt[k] for k in ["name", "exit_code", "elapsed_s", "sources_stable"]}), flush=True)
    if result.returncode != 0 or before != after:
        raise SystemExit(result.returncode or 3)


def compile_all():
    bins = HERE / "bin"
    bins.mkdir(exist_ok=True)
    for name, source in [
        ("baseline_gate", "baseline/morsehgp3D_v7/tests/full_ball_tower_gate.cpp"),
        ("observed_gate", "observed/morsehgp3D_v7/tests/unique_representative_gate.cpp"),
        ("baseline_probe", "baseline/morsehgp3D_v7/bench/full_ball_tower_probe.cpp"),
        ("observed_probe", "observed/morsehgp3D_v7/bench/full_ball_tower_probe.cpp")]:
        execute("compile_r2_" + name, ["g++", "-std=c++20", "-O2", "-Wall", "-Wextra", "-Wpedantic", "-Werror", "-pthread", "-isystem", str(HERE.parents[0] / "v7_boost_gate/extracted/usr/include"), source, "-o", str(bins / name)])


def main():
    p = argparse.ArgumentParser()
    p.add_argument("task", choices=["compile", "gates", "micro", "scale", "scale-extra"])
    args = p.parse_args()
    if args.task == "compile":
        compile_all()
    elif args.task == "gates":
        for name, env in [("baseline_gate", {}), ("observed_gate", {}), ("observed_gate_nocache", {"MHGP7_PRIVATE_NO_CACHE": "1"})]:
            execute(name, [str(HERE / "bin" / name.replace("_nocache", "")), "--selftest"], env)
    elif args.task == "micro":
        for name, env in [("baseline_n400", {}), ("observed_n400", {}), ("observed_n400_nocache", {"MHGP7_PRIVATE_NO_CACHE": "1"})]:
            binary = "baseline_probe" if name.startswith("baseline") else "observed_probe"
            execute(name, ["/usr/bin/time", "-v", str(HERE / "bin" / binary), "--n=400", "--s=8", "--kmax=10", "--threads=1"], env)
    elif args.task == "scale":
        for n, s, family in [(8000, 8, "uniform"), (2000, 8, "scanline_overlap_multiecho")]:
            execute(f"observed_{family}_n{n}_s{s}", ["/usr/bin/time", "-v", str(HERE / "bin/observed_probe"), f"--n={n}", f"--s={s}", "--kmax=10", "--threads=1"], {"MHGP7_PRIVATE_FAMILY": family})
    elif args.task == "scale-extra":
        for n, s, family in [(8000, 10, "uniform"), (8000, 12, "uniform")]:
            execute(f"observed_{family}_n{n}_s{s}", ["/usr/bin/time", "-v", str(HERE / "bin/observed_probe"), f"--n={n}", f"--s={s}", "--kmax=10", "--threads=1"], {"MHGP7_PRIVATE_FAMILY": family})


if __name__ == "__main__":
    main()
