#!/usr/bin/env python3
"""Create a portable content-addressed package, excluding ELF executables."""
import hashlib
import json
from pathlib import Path
import shutil
import subprocess

HERE = Path(__file__).resolve().parent


def main():
    # Seal only after the raw reader passes normal and optimized Python.
    for mode in [[], ["-O"]]:
        subprocess.run(["python3", "-B", *mode, str(HERE / "verify.py")], check=True)
    target = HERE / "packet"
    target.mkdir()
    objects = target / "objects"
    objects.mkdir()
    files = {}
    sources = [p for p in HERE.iterdir() if p.is_file()]
    for directory in ["baseline", "observed", "mutants", "runs", "historical_reference"]:
        sources += [p for p in (HERE / directory).rglob("*") if p.is_file()]
    for source in sorted(sources):
        data = source.read_bytes()
        if data.startswith(b"\x7fELF"):
            raise RuntimeError(f"ELF in publication set: {source}")
        digest = hashlib.sha256(data).hexdigest()
        files[str(source.relative_to(HERE))] = digest
        obj = objects / (digest + ".source")
        if not obj.exists():
            obj.write_bytes(data)
    manifest = {"schema": "mhgp7-private-initial-representatives-packet-v1", "files": files}
    encoded = (json.dumps(manifest, indent=2, sort_keys=True) + "\n").encode()
    (target / "logical_manifest.json").write_bytes(encoded)
    for name in ["verify.py", "README.md"]:
        shutil.copyfile(HERE / name, target / name)
    for mode in [[], ["-O"]]:
        subprocess.run(["python3", "-B", *mode, str(target / "verify.py")], check=True)
    print(json.dumps({"status": "sealed", "logical_files": len(files),
                      "objects": len(list(objects.iterdir())), "manifest_sha256": hashlib.sha256(encoded).hexdigest()}))


if __name__ == "__main__":
    main()
