+      while (*value != '\0' && out < message + sizeof(message) - 1) *out++ = *value++;
+    };
+    const auto number = [&](int value) noexcept {
+      char digits[32]{};
+      const auto result = std::to_chars(digits, digits + sizeof(digits) - 1, value);
+      if (result.ec == std::errc{}) append(digits);
+      else append("?");
+    };
