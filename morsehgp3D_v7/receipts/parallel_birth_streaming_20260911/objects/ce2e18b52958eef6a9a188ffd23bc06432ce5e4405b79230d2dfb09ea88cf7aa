int main(int argc, char** argv) {
  if (argc != 2) return 2;
  const std::string_view mode(argv[1]);
  const auto expected = streaming_gate::cause_for(mode);
  try {
    using namespace streaming_gate;
    if (mode == "--reject-parallel-worker") return reject_parallel_worker();
    if (mode == "--selftest") {
      auto corpus = fixtures();
      corpus.push_back({"singleton", {{3,7,11}}, 1});
      corpus.push_back({"line4", {{0,0,0},{2,0,0},{10,0,0},{12,0,0}}, 4});
      for (const auto& fixture : corpus) for (unsigned v : {0, 1}) for (int s : {8, 10, 12}) one_case(fixture, v, s, s == 8);
      need(cases == 96 && trials == 768 && atomic_levels > 0 && observed > 1000 && graph_gate::oracle_verticals > 10000,
           "stream_gate.selftest_nonvacuity");
    } else if (mode == "--high") {
      const Fixture spatial{"spatial12", {{7,42,83},{91,12,64},{33,88,9},{54,20,71},{18,61,39},{76,53,95},
          {42,7,24},{62,94,47},{3,29,58},{85,73,15},{29,36,97},{58,65,3}}, 10};
      const Fixture shell{"shell14", {{15,10,10},{5,10,10},{10,15,10},{10,5,10},{10,10,15},{10,10,5},
          {13,14,10},{13,6,10},{7,14,10},{7,6,10},{10,13,14},{10,7,6},{10,10,10},{20,25,30}}, 10};
      for (const auto& fixture : {spatial, shell}) for (unsigned v : {0, 1}) for (int s : {8, 10, 12}) one_case(fixture, v, s, s == 8);
      need(cases == 12 && trials == 96 && graph_gate::oracle_verticals > 100000, "stream_gate.high_nonvacuity");
    } else if (mode == "--uniform32") {
      Fixture uniform{"uniform32", {}, 10};
      for (const auto& p : make_family_input(CloudFamily::kUniform, 32, 65536, 3)) uniform.points.push_back(p.position);
      for (unsigned v : {0, 1}) for (int s : {8, 10, 12}) one_case(uniform, v, s, false);
      need(cases == 6 && trials == 48 && observed > 100000, "stream_gate.uniform_nonvacuity");
    } else if (!expected.empty()) {
      one_case({"line4", {{0,0,0},{2,0,0},{10,0,0},{12,0,0}}, 4}, 0, 8, false, mode);
      need(false, "stream_gate.mutant_survived");
    } else return 2;
    work_nonvacuity();
    std::printf("{\"status\":\"passed\",\"public_status\":\"not_claimed\",\"cases\":%llu,\"stream_trials\":%llu,"
        "\"observed_terminals\":%llu,\"checks\":%llu,\"paired_nodes\":%llu,\"paired_contributions\":%llu,"
        "\"oracle_cuts\":%llu,\"oracle_verticals\":%llu,\"stream_mebs\":%llu,\"reference_mebs_repeated\":%llu,"
        "\"multifusion_observations\":%llu,\"widths\":[1,7,31,4096],\"workers_queries\":[1,4],\"gcp_used\":false",
        static_cast<unsigned long long>(cases), static_cast<unsigned long long>(trials), static_cast<unsigned long long>(observed),
        static_cast<unsigned long long>(checks), static_cast<unsigned long long>(graph_gate::paired_nodes),
        static_cast<unsigned long long>(graph_gate::paired_contributions), static_cast<unsigned long long>(graph_gate::oracle_cuts),
        static_cast<unsigned long long>(graph_gate::oracle_verticals), static_cast<unsigned long long>(windowed_mebs),
        static_cast<unsigned long long>(reference_mebs), static_cast<unsigned long long>(atomic_levels));
    print_width_work();
    return 0;
  } catch (const Failure& error) {
    if (!expected.empty() && expected == error.why && streaming_gate::causal_hit(mode)) {
      std::printf("{\"status\":\"causal_rejection\",\"cause\":\"%s\",\"observed_terminals\":%llu,\"callback_aborts\":%llu,\"fault_hits\":%llu}\n",
          error.why, static_cast<unsigned long long>(streaming_gate::observed),
          static_cast<unsigned long long>(streaming_gate::callback_aborts),
          static_cast<unsigned long long>(mhgp7::parallel_birth_streaming_graph_private::fault_hits)); return 4;
    }
    std::fprintf(stderr, "FAIL [%s] %s\n", context.c_str(), error.why);
  } catch (const std::exception& error) {
    if (!expected.empty() && expected == error.what() && streaming_gate::causal_hit(mode)) {
      std::printf("{\"status\":\"causal_rejection\",\"cause\":\"%s\",\"observed_terminals\":%llu,\"callback_aborts\":%llu,\"fault_hits\":%llu}\n",
          error.what(), static_cast<unsigned long long>(streaming_gate::observed),
          static_cast<unsigned long long>(streaming_gate::callback_aborts),
          static_cast<unsigned long long>(mhgp7::parallel_birth_streaming_graph_private::fault_hits)); return 4;
    }
    std::fprintf(stderr, "EXCEPTION [%s] %s\n", context.c_str(), error.what());
  } catch (const full_ball_detail::Failure& error) { std::fprintf(stderr, "GEOMETRY [%s] %s\n", context.c_str(), error.reason); }
  return 1;
}
