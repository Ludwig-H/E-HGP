struct Observation {
  const ag::Extraction& reference;
  std::vector<u8> seen;
  unsigned last_k = 0;
  u64 next_ordinal = 0;
  bool corrupt = false, abort = false;
  u64 accepted = 0;
  static void accept(void* opaque, const ag::Occurrence& occurrence) {
    auto& self = *static_cast<Observation*>(opaque);
    if (self.abort && self.accepted == 3) {
      need(self.last_k == 1 && self.next_ordinal == 3, "stream_gate.observer_abort_prefix");
      ++callback_aborts;
      throw std::runtime_error("stream_gate.observer_abort_after_three");
    }
    auto actual = occurrence;
    if (self.corrupt) ++actual.target;
    const auto& a = self.reference.atlas;
    need(actual.k >= 1 && actual.k <= a.kmax && actual.source_ball < a.balls.size(), "stream_gate.observation_domain");
    need(actual.slot < self.seen.size() && self.seen[actual.slot]++ == 0, "stream_gate.observation_unique");
    need(actual.target == self.reference.targets[actual.slot], "stream_gate.direct_terminal");
    const u64 cell = a.cell(actual.source_ball, actual.k);
    need(actual.source_block == *a.block_id(actual.source_ball, actual.k) &&
         actual.slot == a.rep_offsets[cell] + actual.local && actual.slot < a.rep_offsets[cell + 1],
         "stream_gate.occurrence_identity");
    if (actual.k != self.last_k) {
      need(actual.k > self.last_k, "stream_gate.observer_order");
      self.last_k = actual.k; self.next_ordinal = 0;
    }
    need(actual.ordinal == self.next_ordinal++, "stream_gate.observer_ordinal");
    ++observed; ++self.accepted;
  }
};

std::vector<gf::History> reconstruct(const std::vector<fc::Certificate<u32>>& certificates) {
  std::vector<gf::History> histories;
  for (const auto& certificate : certificates) histories.push_back(fc::reconstruct(certificate, std::less<u32>{}));
  return histories;
}

void compare_ordered(const sg::Streaming& trial,
                     const ordered_streaming_graph_private::Streaming& ordered) {
  need(trial.extraction.phi == ordered.extraction.phi, "birth_stream_gate.ordered_phi");
  need(trial.certificates.size() == ordered.certificates.size(), "birth_stream_gate.ordered_domain");
  for (size_t k = 0; k < trial.certificates.size(); ++k) {
    auto a = trial.certificates[k].edges;
    auto b = ordered.certificates[k].edges;
    const auto by_id = [](const auto& x, const auto& y) { return x.id < y.id; };
    std::sort(a.begin(), a.end(), by_id); std::sort(b.begin(), b.end(), by_id);
    need(a.size() == b.size(), "birth_stream_gate.ordered_edge_count");
    for (size_t j = 0; j < a.size(); ++j) {
      need(a[j].id == b[j].id && a[j].a == b[j].a && a[j].b == b[j].b && a[j].date == b[j].date,
           "birth_stream_gate.ordered_edge_identity");
      ++native_edge_comparisons;
    }
    const auto& x = trial.stats.orders[k + 1]; const auto& y = ordered.stats.orders[k + 1];
    need(x.occurrences == y.occurrences && x.windows == y.windows && x.window_unique == y.window_unique &&
         x.initial_seed_hits == y.initial_seed_hits && x.seed_rows == y.seed_rows, "birth_stream_gate.same_geometry_groups");
    const auto& u = x.geometry_work; const auto& v = y.geometry_work;
    need(u.resolve_work.calls == v.resolve_work.calls && u.resolve_work.power_tests == v.resolve_work.power_tests &&
         u.resolve_work.materializations == v.resolve_work.materializations &&
         u.resolve_work.supports_by_size == v.resolve_work.supports_by_size &&
         u.static_post_seed_queries == v.static_post_seed_queries && u.static_post_seed_hits == v.static_post_seed_hits &&
         u.static_post_seed_terminals == v.static_post_seed_terminals, "birth_stream_gate.same_geometry_work");
    for (const auto field : {&FullBallStats::anchor_hits, &FullBallStats::key_lookups,
        &FullBallStats::intruder_queries, &FullBallStats::intruder_nodes, &FullBallStats::intruder_power_tests,
        &FullBallStats::interior_ranges, &FullBallStats::same_radius_steps, &FullBallStats::descending_steps,
        &FullBallStats::max_chain_steps}) need(u.*field == v.*field, "birth_stream_gate.same_geometry_detail");
  }
}

void metadata(const sg::Streaming& trial, const ag::Extraction& reference) {
  const auto& e = trial.extraction;
  need(e.targets.empty() && e.targets.capacity() == 0, "stream_gate.no_terminal_tape");
  need(e.atlas.index == reference.atlas.index && e.atlas.balls.data() == reference.atlas.balls.data() &&
       e.atlas.balls.size() == reference.atlas.balls.size(), "stream_gate.borrowed_census");
  need(e.atlas.rep_masks == reference.atlas.rep_masks && e.atlas.rep_offsets == reference.atlas.rep_offsets &&
       e.atlas.program_balls == reference.atlas.program_balls, "stream_gate.shared_atlas_program");
  need(e.phi == reference.phi, "stream_gate.ordinal_zero_pivots");
  need(e.orders.size() == reference.orders.size() && trial.certificates.size() == reference.orders.size(),
       "stream_gate.order_count");
  for (size_t k = 0; k < e.orders.size(); ++k) {
    const auto& a = e.orders[k]; const auto& b = reference.orders[k];
    need(a.k == b.k && a.graph.edges.empty() && a.graph.edges.capacity() == 0, "stream_gate.no_global_graph");
    need(a.graph.births.size() == b.graph.births.size() && a.graph.marks.size() == b.graph.marks.size(),
         "stream_gate.metadata_domain");
    for (size_t j = 0; j < a.graph.births.size(); ++j)
      need(a.graph.births[j].id == b.graph.births[j].id && a.graph.births[j].date == b.graph.births[j].date,
           "stream_gate.native_births");
    for (size_t j = 0; j < a.graph.marks.size(); ++j)
      need(a.graph.marks[j].id == b.graph.marks[j].id && a.graph.marks[j].representative == b.graph.marks[j].representative &&
           a.graph.marks[j].admission == b.graph.marks[j].admission, "stream_gate.dated_marks");
    fc::verify_certificate(b.graph, trial.certificates[k], std::less<u32>{});
  }
}

template<class T> u64 reserved_bytes(size_t count) {
  // Characterize reserve on this runtime, not a universal std::vector growth rule.
  std::vector<T> probe; probe.reserve(count);
  return probe.capacity() * sizeof(T);
}

void work_and_residence(const sg::Streaming& trial, const ag::Extraction& reference, size_t width) {
  const auto& e = trial.extraction;
  const auto position = std::find(widths.begin(), widths.end(), width);
  need(position != widths.end() && trial.stats.window_width == width, "stream_gate.width_identity");
  auto& total = width_work[static_cast<size_t>(position - widths.begin())];
  u64 expected_peak_items = 0, expected_peak_capacity = 0, all_occurrences = 0, expected_tasks = 0, expected_batches = 0;
  FullBallStats sum;
  for (unsigned k = 1; k <= e.atlas.kmax; ++k) {
    const auto& s = trial.stats.orders[k];
    const auto& w = s.geometry_work;
    const auto& hub = trial.stats.hub_work[k];
    const auto& native = trial.stats.native_work[k];
    const auto& birth = trial.stats.birth_work[k];
    u64 occurrences = 0, pivots = 0;
    for (u32 b : e.atlas.program(k)) {
      const u64 cell = e.atlas.cell(b, k);
      const u64 count = e.atlas.rep_offsets[cell + 1] - e.atlas.rep_offsets[cell];
      cm::add(occurrences, count); cm::add(pivots, count != 0);
    }
    const u64 expected_windows = occurrences / width + (occurrences % width != 0);
    cm::add(expected_batches, expected_windows);
    need(s.occurrences == occurrences && s.pivots == pivots, "stream_gate.occurrence_work");
    need(s.windows == expected_windows && birth.windows == expected_windows,
         "stream_gate.window_work");
    need(s.window_unique <= occurrences && s.initial_seed_hits <= s.window_unique,
         "stream_gate.window_unique_bounds");
    if (width == 1) need(s.window_unique == occurrences, "stream_gate.unit_window_unique");
    need(s.seed_rows == reference.stats.seed_rows[k], "stream_gate.global_seed_domain");
    const u64 native_vertices = e.orders[k - 1].graph.births.size();
    need(birth.dsu_initializations == 1 && birth.native_vertices == native_vertices &&
         birth.occurrences == occurrences && birth.pivot_assignments == pivots &&
         birth.nonpivot_occurrences == occurrences - pivots && birth.dsu_attempts == occurrences - pivots,
         "birth_stream_gate.single_pass");
    need(birth.order_date_comparisons == (occurrences == 0 ? 0 : occurrences - 1) &&
         birth.order_identity_comparisons == occurrences && birth.dense_terminal_reads == occurrences &&
         birth.dense_source_reads == occurrences - pivots && birth.native_date_comparisons == 2 * occurrences - pivots &&
         birth.phi_conversions == e.atlas.program(k).size() &&
         birth.dsu_logical_bytes == 2 * sizeof(size_t) * native_vertices &&
         birth.dsu_capacity_bytes >= birth.dsu_logical_bytes, "birth_stream_gate.dense_work");
    for (const auto& legacy : {hub, native})
      for (auto field : {&cm::Work::domain_vertices, &cm::Work::domain_sort_items, &cm::Work::domain_sort_comparisons,
          &cm::Work::compact_calls, &cm::Work::input_edges, &cm::Work::output_edges, &cm::Work::sort_calls,
          &cm::Work::sort_items, &cm::Work::identity_sort_comparisons, &cm::Work::sort_date_comparisons,
          &cm::Work::endpoint_queries, &cm::Work::endpoint_comparisons, &cm::Work::validation_date_comparisons,
          &cm::Work::touched_vertices, &cm::Work::peak_touched_vertices, &cm::Work::dsu_attempts, &cm::Work::dsu_unions,
          &cm::Work::windows, &cm::Work::nonempty_windows, &cm::Work::source_edges, &cm::Work::merges,
          &cm::Work::peak_retained_edges, &cm::Work::peak_call_edge_slots, &cm::Work::peak_merge_input_edges})
        need(legacy.*field == 0, "birth_stream_gate.no_legacy_reducer");
    using OldOrdered = ordered_msf_private::Stats;
    for (auto field : {&OldOrdered::dsu_initializations, &OldOrdered::initialized_vertices,
        &OldOrdered::order_date_comparisons, &OldOrdered::order_identity_comparisons, &OldOrdered::validated_edges,
        &OldOrdered::finish_calls, &OldOrdered::peak_input_edges, &OldOrdered::peak_certificate_edges,
        &OldOrdered::dsu_logical_bytes, &OldOrdered::dsu_capacity_bytes, &OldOrdered::peak_certificate_capacity_bytes})
      need(trial.stats.ordered_work[k].*field == 0, "birth_stream_gate.no_legacy_reducer");
    need(s.retained_pivots == 0 && s.projected_loops == 0 && s.projected_edges == 0 && s.hub_certificate_edges == 0 &&
         trial.stats.ordered_work[k].dsu_initializations == 0, "birth_stream_gate.no_hub_projection");
    need(birth.dsu_unions == birth.certificate_edges && birth.certificate_edges == s.native_certificate_edges &&
         s.native_certificate_edges == trial.certificates[k - 1].edges.size() && birth.dense_self_loops <= birth.dsu_attempts,
         "birth_stream_gate.certificate_work");
    cm::add(birth_occurrences, birth.occurrences); cm::add(dense_dsu_initializations, birth.dsu_initializations);
    cm::add(pivot_assignments, pivots); cm::add(nonpivot_attempts, birth.dsu_attempts);
    cm::add(dense_loop_occurrences, birth.dense_self_loops);
    u64 cursor = 0;
    for (u32 b : e.atlas.program(k)) {
      const auto cell = e.atlas.cell(b, k);
      const auto count = e.atlas.rep_offsets[cell + 1] - e.atlas.rep_offsets[cell];
      for (u64 local = 1; local < count; ++local) cm::add(split_hub_windows, (cursor + local) % width == 0);
      cursor += count;
    }
    const size_t reserve = std::min<u64>(width, occurrences);
    expected_peak_items = std::max<u64>(expected_peak_items, reserve);
    const u64 capacity = reserved_bytes<sg::detail::Request>(reserve) + reserved_bytes<size_t>(reserve) +
        reserved_bytes<u32>(reserve) + reserved_bytes<size_t>(reserve == 0 ? 0 : reserve + 1) +
        reserved_bytes<size_t>(reserve);
    expected_peak_capacity = std::max(expected_peak_capacity, capacity);
    cm::add(all_occurrences, occurrences); cm::add(total.orders);
    cm::add(total.occurrences, occurrences); cm::add(total.windows, expected_windows);
    cm::add(total.multi_window_orders, expected_windows > 1);
    cm::add(total.partial_window_orders, occurrences % width != 0);
    if (k >= 2) {
      const u64 starts = s.window_unique - s.initial_seed_hits;
      cm::add(expected_tasks, starts);
      const u64 q = w.static_post_seed_queries[k], h = w.static_post_seed_hits[k];
      const u64 t = w.static_post_seed_terminals[k], m = w.resolve_work.calls;
      need(h <= q && h <= starts && h == t, "stream_gate.postseed_work");
      need(m == cm::sum(starts, q - h) && w.key_lookups == m &&
           cm::sum(w.anchor_hits, h) == starts && w.intruder_queries == q &&
           cm::sum(w.descending_steps, w.same_radius_steps) == q, "stream_gate.meb_work_identity");
      need(e.work.static_requests[k] == occurrences && e.work.static_unique[k] == 0 && e.work.static_seeded[k] == 0,
           "stream_gate.window_not_global_counts");
      need(reference.work.static_unique[k] <= s.window_unique && reference.work.static_seeded[k] <= s.initial_seed_hits,
           "stream_gate.global_dedup_lower_bound");
      cm::add(total.geometry_occurrences, occurrences); cm::add(total.unique, s.window_unique);
      cm::add(total.initial_hits, s.initial_seed_hits); cm::add(total.starts, starts);
      cm::add(total.queries, q); cm::add(total.hits, h); cm::add(total.terminals, t); cm::add(total.mebs, m);
      cm::add(total.deduplicated_orders, s.window_unique < occurrences); cm::add(total.postseed_orders, h != 0);
      ++work_identity_orders;
    } else need(w.resolve_work.calls == 0 && s.initial_seed_hits == 0, "stream_gate.K1_geometry_separate");
    for (size_t j = 0; j < sum.static_post_seed_queries.size(); ++j) {
      if (j != k) need(w.static_post_seed_queries[j] == 0 && w.static_post_seed_hits[j] == 0 &&
                       w.static_post_seed_terminals[j] == 0, "stream_gate.work_order_identity");
      cm::add(sum.static_post_seed_queries[j], w.static_post_seed_queries[j]);
      cm::add(sum.static_post_seed_hits[j], w.static_post_seed_hits[j]);
      cm::add(sum.static_post_seed_terminals[j], w.static_post_seed_terminals[j]);
    }
    for (const auto field : {&FullBallStats::anchor_hits, &FullBallStats::key_lookups,
        &FullBallStats::intruder_queries, &FullBallStats::intruder_nodes, &FullBallStats::intruder_power_tests,
        &FullBallStats::interior_ranges, &FullBallStats::same_radius_steps, &FullBallStats::descending_steps})
      cm::add(sum.*field, w.*field);
    sum.max_chain_steps = std::max(sum.max_chain_steps, w.max_chain_steps);
    cm::add(sum.resolve_work.calls, w.resolve_work.calls);
    cm::add(sum.resolve_work.power_tests, w.resolve_work.power_tests);
    cm::add(sum.resolve_work.materializations, w.resolve_work.materializations);
    for (size_t q = 0; q < sum.resolve_work.supports_by_size.size(); ++q)
      cm::add(sum.resolve_work.supports_by_size[q], w.resolve_work.supports_by_size[q]);
  }
  need(all_occurrences == reference.targets.size() && all_occurrences == e.stats.representatives,
       "stream_gate.total_occurrence_work");
  need(trial.stats.peak_hub_domain_logical_bytes == 0 && trial.stats.peak_hub_domain_capacity_bytes == 0 &&
       trial.stats.peak_hub_certificate_logical_bytes == 0 && trial.stats.peak_hub_certificate_capacity_bytes == 0,
       "birth_stream_gate.no_hub_storage");
  need(sum.static_post_seed_queries == e.work.static_post_seed_queries && sum.static_post_seed_hits == e.work.static_post_seed_hits &&
       sum.static_post_seed_terminals == e.work.static_post_seed_terminals, "stream_gate.aggregate_postseed_work");
  for (const auto field : {&FullBallStats::anchor_hits, &FullBallStats::key_lookups,
      &FullBallStats::intruder_queries, &FullBallStats::intruder_nodes, &FullBallStats::intruder_power_tests,
      &FullBallStats::interior_ranges, &FullBallStats::same_radius_steps, &FullBallStats::descending_steps, &FullBallStats::max_chain_steps})
    need(sum.*field == e.work.*field, "stream_gate.aggregate_geometry_work");
  need(sum.resolve_work.calls == e.work.resolve_work.calls && sum.resolve_work.power_tests == e.work.resolve_work.power_tests &&
       sum.resolve_work.materializations == e.work.resolve_work.materializations &&
       sum.resolve_work.supports_by_size == e.work.resolve_work.supports_by_size, "stream_gate.aggregate_meb_work");
  const u64 stride = sizeof(sg::detail::Request) + sizeof(size_t) + sizeof(u32);
  need(trial.stats.peak_window_items == expected_peak_items &&
       trial.stats.peak_window_logical_bytes >= expected_peak_items * stride &&
       trial.stats.peak_window_logical_bytes <= expected_peak_capacity &&
       trial.stats.peak_window_capacity_bytes == expected_peak_capacity, "stream_gate.named_window_residence");
  const auto worker_count = trial.stats.requested_geometry_workers;
  need((worker_count == 1 || worker_count == 4) &&
       trial.stats.created_geometry_threads == (worker_count == 1 ? 0 : worker_count) &&
       trial.stats.geometry_batches == expected_batches && trial.stats.geometry_tasks == expected_tasks &&
       trial.stats.geometry_tasks_per_worker.size() == worker_count, "parallel_stream_gate.team_and_tasks");
  u64 paid = 0, useful = 0;
  for (u64 count : trial.stats.geometry_tasks_per_worker) { cm::add(paid, count); cm::add(useful, count != 0); }
  need(paid == expected_tasks, "parallel_stream_gate.worker_tasks");
  need(trial.stats.worker_state_capacity_bytes == reserved_bytes<sg::detail::WorkerState>(worker_count),
       "parallel_stream_gate.worker_state_residence");
  if (worker_count > 1) {
    ++parallel_trials; cm::add(parallel_tasks, paid);
    parallel_geometry_observed = parallel_geometry_observed || useful > 1;
  }
  // These named-vector samples do NOT observe hidden/freed transients, MSF
  // capacities, simultaneous RSS, or the intruder DFS's intermediate size.
  total.peak_window_items = std::max(total.peak_window_items, trial.stats.peak_window_items);
  total.peak_window_capacity_bytes = std::max(total.peak_window_capacity_bytes, trial.stats.peak_window_capacity_bytes);
}

void work_nonvacuity() {
  u64 deduplicated = 0, postseed = 0, multiple = 0, partial = 0, total_mebs = 0, total_occurrences = 0;
  for (size_t j = 0; j < widths.size(); ++j) {
    const auto& w = width_work[j];
    need(w.orders > 0 && w.occurrences == width_work[0].occurrences &&
         w.geometry_occurrences == width_work[0].geometry_occurrences, "stream_gate.width_work_domain");
    need(w.hits == w.terminals && w.queries >= w.hits && w.starts == w.unique - w.initial_hits &&
         w.mebs == cm::sum(w.starts, w.queries - w.hits), "stream_gate.width_work_identity");
    if (widths[j] == 1) need(w.unique == w.geometry_occurrences && w.deduplicated_orders == 0,
                           "stream_gate.unit_window_nonvacuity");
    cm::add(deduplicated, w.deduplicated_orders); cm::add(postseed, w.postseed_orders);
    cm::add(multiple, w.multi_window_orders); cm::add(partial, w.partial_window_orders);
    cm::add(total_mebs, w.mebs); cm::add(total_occurrences, w.occurrences);
  }
  need(work_identity_orders > 0 && deduplicated > 0 && postseed > 0 && multiple > 0 && partial > 0,
       "stream_gate.window_work_nonvacuity");
  need(total_mebs == windowed_mebs && total_mebs > 0 && total_occurrences == observed,
       "stream_gate.observed_work_totals");
  need(birth_occurrences == observed && dense_dsu_initializations > 0 && pivot_assignments > 0 &&
       pivot_assignments + nonpivot_attempts == observed && dense_loop_occurrences > 0 &&
       native_edge_comparisons > 0 && window_certificate_checks > 0 && split_hub_windows > 0,
       "birth_stream_gate.nonvacuity");
  need(parallel_geometry_observed && parallel_trials * 2 == trials && parallel_tasks > 0,
       "parallel_stream_gate.nonvacuity");
  // Non-nested widths need not have monotone Uw or M. Width4096 boundary
  // coverage is reported from multi_window_orders, never assumed here.
}

