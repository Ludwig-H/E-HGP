        static_cast<unsigned long long>(w.orders), static_cast<unsigned long long>(w.occurrences),
        static_cast<unsigned long long>(w.geometry_occurrences), static_cast<unsigned long long>(w.windows),
        static_cast<unsigned long long>(w.unique), static_cast<unsigned long long>(w.initial_hits),
        static_cast<unsigned long long>(w.starts), static_cast<unsigned long long>(w.queries),
        static_cast<unsigned long long>(w.hits), static_cast<unsigned long long>(w.terminals), static_cast<unsigned long long>(w.mebs),
        static_cast<unsigned long long>(w.multi_window_orders), static_cast<unsigned long long>(w.partial_window_orders),
        static_cast<unsigned long long>(w.deduplicated_orders), static_cast<unsigned long long>(w.postseed_orders),
        static_cast<unsigned long long>(w.peak_window_items), static_cast<unsigned long long>(w.peak_window_capacity_bytes));
  }
  std::printf("]}\n");
}

void one_case(const Fixture& fixture, unsigned variant, int s, bool oracle, std::string_view fault = {}) {
  context = std::string(fixture.name) + "/v" + std::to_string(variant) + "/s" + std::to_string(s);
  std::fprintf(stderr, "start=%s\n", context.c_str());
  const auto input = graph_gate::make_input(fixture, variant);
  const auto index = build_cloud_index(input);
  auto balls = graph_gate::real_census(index, fixture.kmax, s);
  if (variant) {
    std::reverse(balls.begin(), balls.end());
    for (auto& b : balls) {
      std::reverse(b.shell_ids, b.shell_ids + b.n_shell);
      std::reverse(b.interior_ids, b.interior_ids + b.n_interior);
    }
  }
  const auto original = build_full_ball_tower(index, balls, fixture.kmax, 1);
  need(original.status == FullBallStatus::kCompleteRelative, "stream_gate.reference_complete");
  const auto reference = ag::extract(index, balls, fixture.kmax);
  std::vector<fc::Certificate<u32>> certificates;
  for (const auto& order : reference.orders) certificates.push_back(fc::spanning_certificate(order.graph, std::less<u32>{}));
  const auto full = gf::build(reference, reconstruct(certificates), 1);
  compare_towers(original, full.tower, reference);
  if (oracle) graph_gate::judge(full.tower, input);
  std::vector<fc::Certificate<u32>> first_window_certificates;
  for (size_t width : widths) for (size_t workers : {size_t{1}, size_t{4}}) {
    Observation observer{reference, std::vector<u8>(reference.targets.size(), 0)};
    observer.corrupt = fault == "--mutant-terminal";
    observer.abort = fault == "--reject-observer";
    sg::Fault injected = sg::Fault::kNone;
    if (fault == "--mutant-root-pivot") injected = sg::Fault::kRootPivot;
    if (fault == "--mutant-forget-pivot") injected = sg::Fault::kForgetPivot;
    if (fault == "--mutant-early-conversion") injected = sg::Fault::kEarlyConversion;
    auto streamed = sg::build(index, balls, fixture.kmax, fault == "--reject-zero-window" ? 0 : width,
                             {&observer, fault == "--reject-observer-pair" ? nullptr : Observation::accept},
                             fault == "--reject-zero-workers" ? 0 : workers, injected);
    need(std::all_of(observer.seen.begin(), observer.seen.end(), [](u8 count) { return count == 1; }),
         "stream_gate.observation_complete");
    if (fault == "--mutant-pivot") {
      need(!streamed.extraction.phi.empty(), "stream_gate.pivot_mutant_nonvacuity");
      streamed.extraction.phi.front() = ag::absent;
    } else if (fault == "--mutant-edge-date") {
      need(!streamed.certificates[0].edges.empty(), "stream_gate.edge_mutant_nonvacuity");
      streamed.certificates[0].edges[0].date = 0;
    } else if (fault == "--mutant-drop-edge") {
      need(!streamed.certificates[0].edges.empty(), "stream_gate.drop_mutant_nonvacuity");
      streamed.certificates[0].edges.pop_back();
    } else if (fault == "--mutant-mark-date") {
      need(!streamed.certificates[0].marks.empty(), "stream_gate.mark_mutant_nonvacuity");
      streamed.certificates[0].marks[0].admission = 0;
    } else if (fault == "--mutant-drop-birth") {
      need(streamed.certificates.back().edges.empty() && !streamed.certificates.back().births.empty(),
           "stream_gate.birth_mutant_nonvacuity");
      streamed.certificates.back().births.clear(); streamed.certificates.back().marks.clear();
    } else if (fault == "--mutant-work") {
      need(streamed.extraction.atlas.kmax >= 2, "stream_gate.work_mutant_nonvacuity");
      ++streamed.stats.orders[2].geometry_work.resolve_work.calls;
    } else if (fault == "--mutant-window-work") {
      need(streamed.stats.orders[1].occurrences > 0, "stream_gate.window_mutant_nonvacuity");
      ++streamed.stats.orders[1].windows;
    } else if (fault == "--mutant-birth-work") {
      ++streamed.stats.birth_work[1].dsu_attempts;
    } else if (fault == "--mutant-legacy-work") {
      ++streamed.stats.native_work[1].input_edges;
    } else if (fault == "--mutant-worker-work") {
      ++streamed.stats.geometry_tasks;
    }
    metadata(streamed, reference);
    work_and_residence(streamed, reference, width);
    const auto ordered = ordered_streaming_graph_private::build(index, balls, fixture.kmax, width);
    compare_ordered(streamed, ordered);
    if (width == widths.front() && workers == 1) first_window_certificates = streamed.certificates;
    else for (size_t k = 0; k < streamed.certificates.size(); ++k) {
      const auto& a = first_window_certificates[k].edges;
      const auto& b = streamed.certificates[k].edges;
      need(a.size() == b.size(), "ordered_stream_gate.window_certificate_size");
      for (size_t i = 0; i < a.size(); ++i) {
        need(a[i].id == b[i].id && a[i].a == b[i].a && a[i].b == b[i].b && a[i].date == b[i].date,
             "ordered_stream_gate.window_certificate_identity");
        ++window_certificate_checks;
      }
    }
    const auto histories = reconstruct(streamed.certificates);
    const auto candidate = gf::build(streamed.extraction, histories, 1);
    compare_towers(original, candidate.tower, reference);
    same_payload(full.tower, candidate.tower);
    const auto parallel_queries = gf::build(streamed.extraction, histories, 4);
    same_payload(candidate.tower, parallel_queries.tower);
    // Shared ownership is required, in addition to equal bank row contents.
    for (const auto& order : candidate.tower.orders)
      need(order.forest.populations().get() == candidate.tower.orders[0].forest.populations().get(), "stream_gate.shared_bank");
    if (oracle && width == 7) graph_gate::judge(candidate.tower, input);
    windowed_mebs += streamed.extraction.work.resolve_work.calls;
    reference_mebs += reference.work.resolve_work.calls;
    for (const auto& history : histories) for (const auto& node : history.nodes) atomic_levels += node.parent_count >= 3;
    ++trials;
  }
  ++cases;
  std::fprintf(stderr, "complete=%s\n", context.c_str());
}

std::string_view cause_for(std::string_view mode) {
  if (mode == "--mutant-terminal") return "stream_gate.direct_terminal";
  if (mode == "--mutant-pivot") return "stream_gate.ordinal_zero_pivots";
  if (mode == "--mutant-edge-date") return "filtered.edge_not_strictly_after_birth";
  if (mode == "--mutant-drop-edge") return "filtered.cut_connectivity";
  if (mode == "--mutant-mark-date") return "filtered.mark_identity";
  if (mode == "--mutant-drop-birth") return "filtered.certificate_domain";
  if (mode == "--mutant-work") return "stream_gate.meb_work_identity";
  if (mode == "--mutant-window-work") return "stream_gate.window_work";
  if (mode == "--mutant-birth-work") return "birth_stream_gate.single_pass";
  if (mode == "--mutant-legacy-work") return "birth_stream_gate.no_legacy_reducer";
  if (mode == "--mutant-root-pivot") return "stream_gate.ordinal_zero_pivots";
  if (mode == "--mutant-forget-pivot") return "birth_stream.source_label";
  if (mode == "--mutant-early-conversion") return "birth_stream.source_label";
  if (mode == "--mutant-worker-work") return "parallel_stream_gate.team_and_tasks";
  if (mode == "--reject-zero-workers") return "parallel_stream.geometry_workers";
  if (mode == "--reject-zero-window") return "streaming.window_width";
  if (mode == "--reject-observer") return "stream_gate.observer_abort_after_three";
  if (mode == "--reject-observer-pair") return "streaming.observer_pair";
  return {};
}
bool causal_hit(std::string_view mode) {
  const bool injected = mode == "--mutant-root-pivot" || mode == "--mutant-forget-pivot" ||
      mode == "--mutant-early-conversion";
  return !injected || sg::fault_hits > 0;
}

// A real unresolved K>=2 batch, not the earlier K1 observer refusal.
// Each of four workers pays geometry before the test-only callback barrier;
// worker zero then throws. The callback never supplies an algorithm value.
int reject_parallel_worker() {
  struct Probe {
    std::barrier<> ready{4};
    std::array<std::atomic<bool>, 4> seen{};
    std::atomic<u64> entered{0}, active{0}, completed{0};
    static void after(void* opaque, unsigned k, size_t tasks, size_t worker) {
      auto& self = *static_cast<Probe*>(opaque);
      if (k < 2 || tasks < 4 || self.seen[worker].exchange(true)) return;
      self.entered.fetch_add(1);
      self.active.fetch_add(1);
      struct Leave { std::atomic<u64>& active; ~Leave() { active.fetch_sub(1); } } leave{self.active};
      self.ready.arrive_and_wait();
      self.completed.fetch_add(1);
      if (worker == 0) throw std::runtime_error("parallel_stream_gate.worker_after_geometry");
    }
  } probe;
  context = "parallel_worker_uniform32";
  Fixture uniform{"uniform32", {}, 10};
  for (const auto& p : make_family_input(CloudFamily::kUniform, 32, 65536, 3)) uniform.points.push_back(p.position);
  const auto input = graph_gate::make_input(uniform, 0);
  const auto index = build_cloud_index(input);
  const auto balls = graph_gate::real_census(index, 10, 8);
  bool caught = false;
  try {
    (void)sg::build(index, balls, 10, 4096, {}, 4, sg::Fault::kNone, {&probe, Probe::after});
  } catch (const std::runtime_error& error) {
    need(std::string_view(error.what()) == "parallel_stream_gate.worker_after_geometry", "parallel_stream_gate.worker_cause");
    caught = true;
  }
  need(caught && probe.entered == 4 && probe.completed == 4 && probe.active == 0 &&
       window_workers_private::testing::launch_active == 0 &&
       window_workers_private::testing::exceptions_captured == 1,
       "parallel_stream_gate.worker_quiescence");
  // A fresh complete producer still agrees after the failed producer's
  // destruction; no reuse of a partially published Streaming is possible.
  const auto resumed = sg::build(index, balls, 10, 4096, {}, 4);
  const auto ordered = ordered_streaming_graph_private::build(index, balls, 10, 4096);
  compare_ordered(resumed, ordered);
  need(resumed.stats.geometry_tasks > 4 && window_workers_private::testing::launch_active == 0,
       "parallel_stream_gate.worker_recovery_nonvacuity");
  std::printf("{\"status\":\"causal_rejection\",\"cause\":\"parallel_stream_gate.worker_after_geometry\","
      "\"workers_after_geometry\":4,\"callbacks_active_after\":0,\"threads_active_after\":0,"
      "\"captured_exceptions\":1,\"fresh_producer_verified\":true}\n");
  return 4;
}
