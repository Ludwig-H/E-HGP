#!/usr/bin/env python3
import difflib
import hashlib
import json
from pathlib import Path

BASE = Path('/workspaces/E-HGP/build/v7_ball_tower_mono_20260910')
expected = (BASE / 'run_extended/o2_selftest.stdout').read_bytes()
receipts = {}
for mode in ['o2', 'san', 'mutant']:
    run = BASE / ('run_monotone_' + mode)
    receipt = json.loads((run / 'receipt.json').read_text())
    if any(row['returncode'] != row['expected'] for row in receipt['commands']):
        raise RuntimeError('wrong return code')
    for row in receipt['commands']:
        for stream in ['stdout', 'stderr']:
            if hashlib.sha256((run / (row['name'] + '.' + stream)).read_bytes()).hexdigest() != row[stream + '_sha256']:
                raise RuntimeError('raw stream changed')
    if mode != 'mutant' and (run / 'oracle_selftest.stdout').read_bytes() != expected:
        raise RuntimeError('oracle differs')
    receipts[mode] = hashlib.sha256((run / 'receipt.json').read_bytes()).hexdigest()
if (BASE / 'run_monotone_o2/comb_selftest.stdout').read_bytes() != (BASE / 'run_monotone_san/comb_selftest.stdout').read_bytes():
    raise RuntimeError('comb O2/SAN differs')
baseline = BASE / 'baseline/src/forest/full_ball_tower.hpp'
final = BASE / 'monotone/src/forest/full_ball_tower.hpp'
patch = ''.join(difflib.unified_diff(baseline.read_text().splitlines(keepends=True), final.read_text().splitlines(keepends=True),
    fromfile='a/morsehgp3D_v7/src/forest/full_ball_tower.hpp', tofile='b/morsehgp3D_v7/src/forest/full_ball_tower.hpp'))
(BASE / 'combined.patch').write_text(patch)
summary = {'status': 'passed', 'scope': 'private_two_step_cpu_delta_not_performance_contract',
    'baseline_sha256': hashlib.sha256(baseline.read_bytes()).hexdigest(),
    'candidate_sha256': hashlib.sha256(final.read_bytes()).hexdigest(),
    'combined_patch_sha256': hashlib.sha256((BASE / 'combined.patch').read_bytes()).hexdigest(),
    'gate_sha256': hashlib.sha256((BASE / 'monotone/tests/full_ball_tower_gate.cpp').read_bytes()).hexdigest(),
    'receipts': receipts, 'oracle': json.loads(expected),
    'comb': [json.loads(line) for line in (BASE / 'run_monotone_o2/comb_selftest.stdout').read_text().splitlines()],
    'gcp_used': False}
(BASE / 'monotone_summary.json').write_text(json.dumps(summary, indent=2) + '\n')
print(json.dumps(summary, indent=2))
