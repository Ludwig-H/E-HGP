#!/usr/bin/env python3
"""Fresh active-source gate, complete local-header antidrift and raw streams."""
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import time

ROOT = Path('/workspaces/E-HGP')
PROJECT = ROOT / 'morsehgp3D_v7'
BASE = ROOT / 'build/v7_ball_work_gate_20260910'
MODE = sys.argv[1]
RUN = BASE / ('run_' + MODE)
RUN.mkdir(exist_ok=False)
files = sorted((PROJECT / 'src').rglob('*.hpp')) + sorted((PROJECT / 'oracle').glob('*.hpp'))
files += [PROJECT / 'tests/full_ball_tower_gate.cpp', PROJECT / 'tests/full_ball_work_gate.cpp', Path(__file__)]


def hashes():
    return {str(path.relative_to(ROOT)): hashlib.sha256(path.read_bytes()).hexdigest() for path in files}


before = hashes()
manifest = {'schema': 'active-full-ball-work-gate-v1', 'sources_before': before, 'commands': []}
for path in [PROJECT / 'src/forest/full_ball_tower.hpp', PROJECT / 'tests/full_ball_tower_gate.cpp',
             PROJECT / 'tests/full_ball_work_gate.cpp', Path(__file__)]:
    shutil.copy2(path, RUN / path.name)


def run(name, argv, expected, env=None):
    started = time.time_ns()
    with (RUN / (name + '.stdout')).open('wb') as out, (RUN / (name + '.stderr')).open('wb') as err:
        result = subprocess.run(argv, cwd=ROOT, stdout=out, stderr=err, env=env, check=False)
    command = {'name': name, 'argv': argv, 'returncode': result.returncode, 'expected': expected,
               'start_ns': started, 'end_ns': time.time_ns()}
    for stream in ['stdout', 'stderr']:
        command[stream + '_sha256'] = hashlib.sha256((RUN / (name + '.' + stream)).read_bytes()).hexdigest()
    manifest['commands'].append(command)
    (RUN / 'receipt.json').write_text(json.dumps(manifest, indent=2) + '\n')
    print(name, result.returncode, flush=True)
    if result.returncode != expected:
        print((RUN / (name + '.stderr')).read_text(), flush=True)
        raise RuntimeError(name)


if MODE not in ['o2', 'san']:
    raise ValueError(MODE)
flags = ['-O2'] if MODE == 'o2' else ['-O1', '-g', '-fsanitize=address,undefined', '-fno-omit-frame-pointer']
executable = RUN / 'mhgp7_full_ball_work_gate'
command = ['g++', '-std=c++20', '-Wall', '-Wextra', '-Wpedantic', '-Werror', '-isystem',
           str(ROOT / 'build/v7_boost_gate/extracted/usr/include')] + flags
run('compile', command + ['-MMD', '-MF', str(RUN / 'gate.d'), str(PROJECT / 'tests/full_ball_work_gate.cpp'),
                          '-o', str(executable)], 0)
manifest['elf_sha256'] = hashlib.sha256(executable.read_bytes()).hexdigest()
env = os.environ.copy()
if MODE == 'san':
    env['ASAN_OPTIONS'] = 'detect_leaks=1:halt_on_error=1'
    env['UBSAN_OPTIONS'] = 'halt_on_error=1:print_stacktrace=1'
    manifest['sanitizer_env'] = {key: env[key] for key in ['ASAN_OPTIONS', 'UBSAN_OPTIONS']}
run('selftest', [str(executable), '--selftest'], 0, env)
run('bad_argument', [str(executable), '--unknown'], 2, env)
manifest['sources_after'] = hashes()
manifest['antidrift'] = before == manifest['sources_after']
(RUN / 'receipt.json').write_text(json.dumps(manifest, indent=2) + '\n')
if not manifest['antidrift']:
    raise RuntimeError('source drift')
print('antidrift passed', flush=True)
