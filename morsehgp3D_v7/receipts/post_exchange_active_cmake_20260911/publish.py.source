#!/usr/bin/env python3
"""Create-only compact active qualification receipt, preserving raw captures."""
import hashlib
import json
from pathlib import Path
import shutil

BASE=Path(__file__).resolve().parent
ROOT=BASE.parents[1]
SOURCE=ROOT/'build/v7_postseed_active_20260911/capture_r1'
TARGET=ROOT/'morsehgp3D_v7/receipts/post_exchange_active_cmake_20260911'


def sha(data):return hashlib.sha256(data).hexdigest()


def write(path,data):
    path.parent.mkdir(parents=True,exist_ok=True)
    with path.open('xb') as stream:stream.write(data)


def main():
    receipt=json.loads((SOURCE/'receipt.json').read_text())
    if receipt['status']!='passed' or receipt['selected_CTests']!=24 or receipt['commands']!=21:
        raise RuntimeError('active_capture_not_closed')
    entries={}
    for path in sorted(SOURCE.rglob('*')):
        if path.is_file():
            if path.is_symlink():raise RuntimeError('no_symlinks')
            data=path.read_bytes();data.decode('utf-8')
            if data.startswith(b'\x7fELF'):raise RuntimeError('no_ELF')
            entries[path.relative_to(SOURCE).as_posix()]=data
    TARGET.mkdir(exist_ok=False)
    mapping={}
    for logical,data in entries.items():
        destination='capture/'+logical+('.source' if logical.endswith('.md') else '')
        write(TARGET/destination,data)
        mapping[logical]=dict(storage=destination,sha256=sha(data),size=len(data))
    write(TARGET/'source_map.json',(json.dumps(mapping,indent=2,sort_keys=True)+'\n').encode())
    for name in ('README.md','verify.py'):
        shutil.copyfile(BASE/name,TARGET/name)
    shutil.copyfile(Path(__file__),TARGET/'publish.py.source')
    files={p.relative_to(TARGET).as_posix():sha(p.read_bytes()) for p in sorted(TARGET.rglob('*')) if p.is_file()}
    write(TARGET/'MANIFEST.json',(json.dumps(dict(files=files,GCP_used=False,cuda_executed=False,
        vendor_included=False,ELF_included=False,public_status='not_claimed'),indent=2,sort_keys=True)+'\n').encode())
    if any((SOURCE/name).read_bytes()!=data for name,data in entries.items()):
        raise RuntimeError('capture_changed_during_publication')
    print(json.dumps(dict(status='published',capture_files=len(entries),bytes=sum(len(v) for v in entries.values()),
        manifest_sha256=sha((TARGET/'MANIFEST.json').read_bytes()))))


if __name__=='__main__':main()
