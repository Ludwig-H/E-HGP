#!/usr/bin/env python3
"""Fresh T2 qualification of the captured active post-exchange CPU producer."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import time

HERE = Path(__file__).resolve().parent
REPO = HERE.parents[1]


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--out", required=True)
    parser.add_argument("--mode", choices=("o2", "san"), required=True)
    args = parser.parse_args()
    out = HERE / args.out
    out.mkdir(exist_ok=False)
    paths = sorted([p for p in (HERE / "source").rglob("*") if p.is_file()] +
                   [p for p in HERE.iterdir() if p.is_file() and p.suffix in (".py", ".json", ".md")])
    before = {str(p.relative_to(HERE)): sha(p) for p in paths}
    snapshot = out / "source_snapshot"
    for path in paths:
        target = snapshot / path.relative_to(HERE)
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.copy2(path, target)
    receipt = dict(status="running", mode=args.mode, sources_before=before, commands=[], GCP_used=False,
                   device_executed=False, public_status="not_claimed", inherited_results=False,
                   probe_compiled=False, binary_before=None, binary_after=None)
    environment = dict(os.environ, ASAN_OPTIONS="detect_leaks=1:halt_on_error=1",
                       UBSAN_OPTIONS="halt_on_error=1:print_stacktrace=1")
    receipt["sanitizer_environment"] = {name: environment[name] for name in ("ASAN_OPTIONS", "UBSAN_OPTIONS")}

    def save():
        (out / "receipt.json").write_text(json.dumps(receipt, indent=2, sort_keys=True) + "\n")

    def run(name, command, expected=0, diagnostic=None):
        intent = dict(argv=command, expected_exit=expected, causal_diagnostic=diagnostic)
        (out / (name + ".intent.json")).write_text(json.dumps(intent, indent=2) + "\n")
        print("start=" + name, flush=True)
        start = time.time_ns()
        with (out / (name + ".stdout")).open("wb") as stdout, (out / (name + ".stderr")).open("wb") as stderr:
            result = subprocess.run(command, cwd=REPO, env=environment, stdout=stdout, stderr=stderr)
        errors = (out / (name + ".stderr")).read_text()
        row = dict(name=name, argv=command, expected_exit=expected, exit_code=result.returncode,
            started_ns=start, ended_ns=time.time_ns(), diagnostic=diagnostic,
            diagnostic_matched=diagnostic is None or diagnostic in errors,
            stdout_sha256=sha(out / (name + ".stdout")), stderr_sha256=sha(out / (name + ".stderr")))
        receipt["commands"].append(row)
        save(); print(name, result.returncode, flush=True)
        if result.returncode != expected or not row["diagnostic_matched"]:
            raise ValueError(name + ": unexpected exit or diagnostic")

    save()
    binary = out / "gate"
    try:
        flags = ["-O2"] if args.mode == "o2" else ["-O1", "-g", "-fno-omit-frame-pointer", "-fsanitize=address,undefined",
                                                                  "-fno-sanitize-recover=all"]
        run("compile", ["g++", "-std=c++20", "-Wall", "-Wextra", "-Wpedantic", "-Werror", "-pthread", *flags,
            "-isystem", str(REPO / "build/v7_boost_gate/extracted/usr/include"), "-MMD", "-MF", str(binary) + ".d",
            str(snapshot / "source/t2_gate.cpp"), "-o", str(binary)])
        receipt["binary_before"] = sha(binary)
        for name in ("historical", "line12", "shell14", "spatial12", "rejects"):
            run(name, [str(binary), "--" + name])
        for name, diagnostic in (("mutant-assignment", "T2 unassigned subset"),
                ("mutant-open", "T2.historical.exact_Gamma"), ("mutant-adjacency", "T2.historical.exact_Gamma"),
                ("mutant-census", "T2.census.exhaustive_ball_inventory")):
            run(name, [str(binary), "--" + name], 1, diagnostic)
        run("invalid-args", [str(binary), "--invalid"], 2)
        cases = {name: json.loads((out / (name + ".stdout")).read_bytes()) for name in ("line12", "shell14", "spatial12")}
        sums = {name: sum(case[name] for case in cases.values()) for name in
            ("orders", "census_runs", "physical_tower_pairs", "cuts", "vertical_checks", "post_seed_queries",
             "post_seed_hits", "post_seed_terminals", "post_static_towers", "post_work_pairs")}
        receipt["campaign_totals"] = sums
        if sums["orders"] != 540 or sums["census_runs"] != 18 or sums["physical_tower_pairs"] != 48 or \
                sums["post_static_towers"] != 36 or sums["post_work_pairs"] != 18:
            raise ValueError("T2post.campaign_shape")
        # One geometry may legitimately have no hit. Qualification of the new
        # shortcut requires nonzero actual hits over the complete campaign.
        if sums["post_seed_hits"] == 0 or sums["post_seed_queries"] < sums["post_seed_hits"] or \
                sums["post_seed_terminals"] != sums["post_seed_hits"]:
            receipt["post_seed_coverage"] = "unexercised_or_inconsistent"
            raise ValueError("T2post.global_hit_nonvacuity")
        receipt["post_seed_coverage"] = "actual_nonzero_hits"
        for name, case in cases.items():
            order_rows, tower_rows = [], []
            for line in (out / (name + ".stderr")).read_text().splitlines():
                if line.startswith("T2POST_ORDER "):
                    order_rows.append(json.loads(line.removeprefix("T2POST_ORDER ")))
                if line.startswith("T2POST_TOWER "):
                    tower_rows.append(json.loads(line.removeprefix("T2POST_TOWER ")))
            if len(order_rows) != 180 or len(tower_rows) != 18:
                raise ValueError(name + ": missing detailed Q/H/T rows")
            for key, letter in (("post_seed_queries", "Q"), ("post_seed_hits", "H"), ("post_seed_terminals", "T")):
                if sum(row[letter] for row in order_rows) != case[key] or sum(row[letter] for row in tower_rows) != case[key]:
                    raise ValueError(name + ": detailed totals disagree")
            (out / (name + ".post_exchange.json")).write_text(json.dumps(dict(orders=order_rows, towers=tower_rows),
                indent=2, sort_keys=True) + "\n")
        receipt["status"] = "passed"
    except Exception as error:
        receipt["status"] = "failed"; receipt["error"] = str(error)
    finally:
        if binary.exists():
            receipt["binary_after"] = sha(binary)
        receipt["sources_after"] = {str(p.relative_to(HERE)): sha(p) for p in paths}
        receipt["sources_stable"] = before == receipt["sources_after"]
        if not receipt["sources_stable"] or receipt["binary_before"] != receipt["binary_after"]:
            receipt["status"] = "failed"
        save()
    return 0 if receipt["status"] == "passed" else 1


if __name__ == "__main__":
    raise SystemExit(main())
