#!/usr/bin/env python3
"""Capture the newly active CPU sources; never import metadata mutant headers."""
import hashlib
import json
from pathlib import Path
import shutil

HERE = Path(__file__).resolve().parent
REPO = HERE.parents[1]
EXPECTED = {
    "morsehgp3D_v7/src/forest/full_ball_tower.hpp": "6763a877f43d79a45532bce4426feca645b6ee97f18c9a4ee1fea4c47cd408a5",
    "morsehgp3D_v7/tests/full_ball_tower_gate.cpp": "c4f39462487610e32fd5b23210c268a4f7300490aff511252a3cf859afe9cb88",
    "morsehgp3D_v7/bench/full_ball_tower_probe.cpp": "e96f8d36a523c6cfb64848ae5ee86933fef2279050691e6b4f774a430a0f2f46"}


def digest(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


for name, pin in EXPECTED.items():
    if digest(REPO / name) != pin:
        raise ValueError("active pin changed: " + name)
source = HERE / "source"
source.mkdir(exist_ok=False)
files = {}
paths = sorted([p for directory in ("src", "oracle") for p in (REPO / "morsehgp3D_v7" / directory).rglob("*") if p.is_file()] +
               [REPO / "morsehgp3D_v7/tests/full_ball_tower_gate.cpp", REPO / "morsehgp3D_v7/bench/full_ball_tower_probe.cpp"])
for path in paths:
    name = path.relative_to(REPO)
    target = source / "source" / name
    target.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(path, target)
    files[str(name)] = digest(target)
for name in ("t2_gate.cpp", "t2_oracle.hpp"):
    origin = REPO / "build/v7_t2_metadata_20260911/source" / name
    shutil.copy2(origin, source / name)
    files[name] = digest(origin)
for name, pin in EXPECTED.items():
    if digest(REPO / name) != pin or files[name] != pin:
        raise ValueError("active pin moved during capture: " + name)
(HERE / "baseline.json").write_text(json.dumps(dict(authority="fresh active CPU post_exchange snapshot, no prior qualification inherited",
    expected_active_pins=EXPECTED, files=files, probe_authority="captured but not consumed by the T2 translation unit"),
    indent=2, sort_keys=True) + "\n")
print("captured", len(files), "source files, active trio stable")
