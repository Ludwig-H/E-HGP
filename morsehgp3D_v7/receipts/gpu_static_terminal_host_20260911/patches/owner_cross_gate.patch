+// Separate CLI mode, hence a fresh process: no dependence on owners created by
+// another fixture. The historical r2 owner publishes its independent token 1
+// while its owned spatial index has token 2, colliding with foreign_index.
+void run_owner_cross() {
+  const auto a = build_cloud_index(std::vector<P3>{{10,10,10},{12,12,12}});
+  const auto b = build_cloud_index(std::vector<P3>{{0,0,0},{2,2,2}});
+  terminal::spatial::IndexOwner foreign_index(a);
+  BallData ball;
+  ball.key = q2_ball_key(b.upos[0], b.upos[1]);
+  ball.level = promote_level(q2_exact_level(p3_norm2(p3_sub(b.upos[0], b.upos[1]))));
+  ball.arity = 2; ball.n_shell = 2; ball.shell_ids[0] = 0; ball.shell_ids[1] = 1;
+  terminal::HostOwner owner(b, std::span<const BallData>(&ball, 1));
+  const auto view = owner.view();
+  terminal::Request request;
+  request.snapshot = view.index.snapshot; request.ordinal = (u64{1} << 40) + 7;
+  request.k = 2; request.selected[0] = 0; request.selected[1] = 1;
+  request.before = terminal::encode_level(ExactLevel{{100,0,0},1});
+  const auto nominal = terminal::resolve(view, request);
+  need(nominal.status == terminal::Status::kOk && nominal.target == 0 &&
+      nominal.work.calls == 1, "guard.cross_owner_nominal");
+  auto mixed = view;
+  mixed.index = foreign_index.view();
+  // Check the actual API refusal before inspecting token inequality: the old
+  // implementation reaches geometric work instead of rejecting this mix.
+  const auto result = terminal::resolve(mixed, request);
+  refuse(result, terminal::Status::kInvalidView, "guard.cross_owner_must_refuse_foreign_index");
+  need(result.work.calls == 0 && result.ordinal == request.ordinal,
+      "guard.cross_owner_refusal_prework");
+  need(mixed.index.snapshot != mixed.catalog.snapshot,
+      "guard.cross_owner_identity_is_distinct");
+  need(!terminal::valid_view(mixed), "guard.cross_owner_invalid_view");
 }
