#!/usr/bin/env python3
"""Record pure Python boundary tests normally and under -O; no cloud/compiler."""
import argparse
import hashlib
import json
from pathlib import Path
import shutil
import subprocess

BASE = Path(__file__).resolve().parent
ROOT = BASE.parents[1]


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def save(path, value):
    with path.open('x') as stream:
        json.dump(value, stream, indent=2, sort_keys=True)
        stream.write('\n')


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--out', required=True)
    args = parser.parse_args()
    if not args.out.isidentifier():
        raise ValueError('fresh output name')
    out = BASE / args.out
    out.mkdir()
    sources = [ROOT / 'gcp-migration/terminal_batch_worker_v7.py',
               ROOT / 'gcp-migration/selftest_terminal_batch_worker_v7.py',
               ROOT / 'gcp-migration/README_TERMINAL_BATCH_V7.md',
               BASE / 'build_snapshot.py', Path(__file__)]
    before = {str(path): sha(path) for path in sources}
    for path in sources:
        shutil.copyfile(path, out / path.name)
    save(out / 'sources_before.json', before)
    rows, status, error = [], 'failed', None
    try:
        for name, flags in (('normal', []), ('optimized', ['-O'])):
            argv = ['python3', '-B', *flags, str(ROOT / 'gcp-migration/selftest_terminal_batch_worker_v7.py')]
            with (out / (name + '.stdout')).open('xb') as so, (out / (name + '.stderr')).open('xb') as se:
                run = subprocess.run(argv, stdout=so, stderr=se, check=False)
            row = dict(name=name, argv=argv, exit_code=run.returncode,
                       stdout_sha256=sha(out / (name + '.stdout')), stderr_sha256=sha(out / (name + '.stderr')))
            rows.append(row)
            save(out / (name + '.command.json'), row)
            if run.returncode != 0:
                raise ValueError('pure parser selftest failed: ' + name)
            payload = json.loads((out / (name + '.stdout')).read_text())
            if payload.get('status') != 'passed' or payload.get('rejections', 0) < 200:
                raise ValueError('pure parser selftest nonvacuity')
        status = 'passed'
    except BaseException as exc:
        error = type(exc).__name__ + ': ' + str(exc)
    finally:
        after = {str(path): sha(path) for path in sources}
        if before != after:
            status, error = 'failed', 'source changed'
        save(out / 'sources_after.json', after)
        save(out / 'receipt.json', dict(status=status, error=error, source_stable=before == after,
                                       commands=rows, GCP_used=False, device_executed=False, compiled=False))
    print(json.dumps(dict(status=status, error=error, output=str(out))))
    if status != 'passed':
        raise SystemExit(1)


if __name__ == '__main__':
    main()
