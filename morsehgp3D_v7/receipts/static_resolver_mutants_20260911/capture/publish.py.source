#!/usr/bin/env python3
"""Publish a byte-identical, deduplicated receipt; destination must be new."""
from __future__ import annotations

import hashlib
import json
from pathlib import Path
import shutil

HERE = Path(__file__).resolve().parent
ROOT = HERE.parents[1]
DEST = ROOT / 'morsehgp3D_v7/receipts/static_resolver_mutants_20260911'
PRIVATE_SHA = '47bad2042100d4545faa1f5bcd57bf77482cc126266d2ef6b612a69a9f16c15e'

def need(ok: bool, reason: str) -> None:
    if not ok:
        raise ValueError(reason)

def sha(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()

def main() -> None:
    need(not DEST.exists(), 'destination_exists')
    original_bytes = (HERE / 'MANIFEST.json').read_bytes()
    need(sha(original_bytes) == PRIVATE_SHA, 'original_manifest')
    manifest = json.loads(original_bytes)
    need(len(manifest['files']) == 544, 'logical_count')
    original = {}
    for name, digest in manifest['files'].items():
        data = (HERE / name).read_bytes()
        need(sha(data) == digest and not data.startswith(b'\x7fELF'), 'original_capture:' + name)
        original[name] = data
    preferred = {
        'README.md': 'capture/README.md.source',
        'driver.cpp': 'capture/driver.cpp',
        'fixtures.txt': 'capture/fixtures.txt',
        'expected.txt': 'capture/expected.txt',
        'fixture_metrics.json': 'capture/fixture_metrics.json',
        'source_pins.json': 'capture/source_pins.json',
        'verify.py': 'capture/verify_private.py.source',
        'prepare.py': 'capture/prepare.py.source',
        'record.py': 'capture/record.py.source',
        'run_r1/commands.json': 'capture/commands.json',
        'run_r1/receipt.json': 'capture/receipt.json',
        'source/morsehgp3D_v7/src/forest/full_ball_tower.hpp': 'capture/full_ball_tower.hpp.source',
        'geometry/plateau_model.py': 'capture/geometry/plateau_model.py',
        'meb_rational_oracle_20260905.py': 'capture/meb_rational_oracle_20260905.py',
    }
    for name in ('admit_global_key', 'consult_anchors', 'scatter_sorted_index', 'scatter_holes',
                 'unnormalized_anchor', 'partial_launch'):
        preferred['run_r1/' + name + '/mutation.diff'] = 'capture/mutations/' + name + '.diff'
        preferred['run_r1/' + name + '_run.stderr'] = 'capture/rejections/' + name + '.stderr'
    for mode in ('0', '1', '4', 'launch'):
        preferred['run_r1/nominal_' + mode + '.stdout'] = 'capture/nominal_' + mode + '.stdout.json'
    DEST.mkdir(parents=True)
    stored = {}
    mapping = {}
    for name in [*preferred, *(n for n in original if n not in preferred)]:
        data = original[name]
        digest = sha(data)
        if digest not in stored:
            physical = preferred.get(name, 'objects/' + digest)
            target = DEST / physical
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(data)
            stored[digest] = physical
        mapping[name] = stored[digest]
    (DEST / 'capture/MANIFEST.json').write_bytes(original_bytes)
    (DEST / 'storage_map.json').write_text(json.dumps(mapping, indent=2, sort_keys=True) + '\n')
    shutil.copyfile(HERE / 'public_README.md', DEST / 'README.md')
    shutil.copyfile(HERE / 'public_verify.py', DEST / 'verify.py')
    shutil.copyfile(Path(__file__), DEST / 'capture/publish.py.source')
    review = ROOT / 'build/v7_static_resolver_review_20260911'
    review_pins = {}
    for name, target_name in [('README.md', 'CONCEPTION.md'), ('REVIEW_INITIAL.md', 'INITIAL.md')]:
        target = DEST / 'review' / target_name
        target.parent.mkdir(exist_ok=True)
        shutil.copyfile(review / name, target)
        review_pins[target.relative_to(DEST).as_posix()] = sha(target.read_bytes())
    pins = dict(private_manifest_sha256=PRIVATE_SHA, logical_capture_files=544,
        prototype_header_sha256='33e7d05effce908532d21255e5e0efc4f8c7370d8a05a17dd761142d81bd4209',
        commands=18, physical_mutants=6, private_prototype_cpu=True, default_route_not_changed=True,
        preserved_bytes=True, ELF_included=False, GCP_used=False, review_files=review_pins,
        historical_markdown_storage='README.md mapped byte-identically to capture/README.md.source',
        original_root_header='build/v7_static_resolver_20260911/source_r2/morsehgp3D_v7/src/forest/full_ball_tower.hpp')
    (DEST / 'source_pins.json').write_text(json.dumps(pins, indent=2, sort_keys=True) + '\n')
    files = {p.relative_to(DEST).as_posix(): sha(p.read_bytes()) for p in sorted(DEST.rglob('*')) if p.is_file()}
    (DEST / 'MANIFEST.json').write_text(json.dumps(dict(files=files, public_status='not_claimed'),
        indent=2, sort_keys=True) + '\n')
    print(json.dumps(dict(status='published', logical_files=len(original), stored_unique_captures=len(stored),
        public_files=len(files), logical_bytes=sum(map(len, original.values())),
        stored_capture_bytes=sum((DEST / p).stat().st_size for p in stored.values()),
        manifest_sha256=sha((DEST / 'MANIFEST.json').read_bytes()))))

if __name__ == '__main__':
    main()
