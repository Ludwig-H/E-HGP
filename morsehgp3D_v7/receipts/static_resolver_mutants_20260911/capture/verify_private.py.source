#!/usr/bin/env python3
"""Read-only verifier of frozen light-driver qualification; no assert gate."""
import hashlib
import json
from pathlib import Path

HERE = Path(__file__).resolve().parent

def need(ok, why):
    if not ok:
        raise ValueError(why)

def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()

def main():
    manifest = json.loads((HERE / 'MANIFEST.json').read_text())
    for name, digest in manifest['files'].items():
        path = Path(name)
        need(not path.is_absolute() and '..' not in path.parts, 'manifest_path')
        need(sha(HERE / path) == digest, 'manifest_sha:' + name)
    run = HERE / 'run_r1'
    receipt = json.loads((run / 'receipt.json').read_text())
    need(receipt['status'] == 'passed' and receipt['mutants'] == 6 and not receipt['GCP_used'], 'receipt_status')
    need(receipt['source_header_sha256'] == '33e7d05effce908532d21255e5e0efc4f8c7370d8a05a17dd761142d81bd4209',
         'root_source_r2_identity')
    commands = json.loads((run / 'commands.json').read_text())
    rows = {r['name']: r for r in commands}
    need(len(rows) == len(commands) == 18, 'closed_command_count')
    for row in commands:
        need(row['exit_code'] == row['expected_exit_code'], 'closed_exit:' + row['name'])
        need(row['ended_ns'] >= row['started_ns'], 'command_time')
        for stream in ('stdout', 'stderr'):
            need(sha(run / (row['name'] + '.' + stream)) == row[stream + '_sha256'], 'stream_sha')
    sources = ('nominal', 'admit_global_key', 'consult_anchors', 'scatter_sorted_index',
               'scatter_holes', 'unnormalized_anchor', 'partial_launch')
    base_pins = json.loads((HERE / 'source_pins.json').read_text())
    header = 'morsehgp3D_v7/src/forest/full_ball_tower.hpp'
    pool = 'morsehgp3D_v7/src/parallel/pool.hpp'
    mutation_files = {name: pool if name == 'partial_launch' else header for name in sources[1:]}
    for name in sources:
        before = json.loads((run / name / 'sources_before.json').read_text())
        after = json.loads((run / name / 'sources_after.json').read_text())
        need(before == after, 'sources_changed:' + name)
        need(set(before) == set(base_pins), 'source_domain:' + name)
        changed = {p for p in before if before[p] != base_pins[p]}
        need(changed == (set() if name == 'nominal' else {mutation_files[name]}), 'mutation_footprint:' + name)
        for path, digest in before.items():
            need(sha(run / name / 'source' / path) == digest, 'source_pin:' + name)
        compile_row = rows[name + '_compile']
        need(compile_row['exit_code'] == 0 and '-Werror' in compile_row['argv'] and
             '-Wpedantic' in compile_row['argv'] and '-DMHGP7_TESTING' in compile_row['argv'], 'strict_compiled:' + name)
        need((run / name / 'binary.sha256').read_text().strip(), 'binary_pin')
        binary = run / name / 'gate'
        if binary.exists():
            need(sha(binary) == (run / name / 'binary.sha256').read_text().strip(), 'binary_changed')
    values = []
    for route in ('0', '1', '4'):
        row = json.loads((run / ('nominal_' + route + '.stdout')).read_text())
        need(row['status'] == 'passed' and row['rows'] == 2524 and row['vertical'] == 1506 and
             row['orders'] == 46 and row['cuts'] == 1544 and row['checks'] >= 20134, 'semantic_floors')
        values.append(row)
    for value in values[1:]:
        need(value['requests'] == 354 and value['unique'] == 219 and value['seeded'] == 176 and
             value['mebs'] == 51, 'nonvacuous_static_work')
    need(json.loads((run / 'nominal_launch.stdout').read_text())['status'] == 'passed_launch_guard',
         'launch_nominal_passed')
    for name in sources[1:]:
        need(rows[name + '_run']['exit_code'] == 1, 'mutant_runtime_rejection:' + name)
        need((run / (name + '_run.stderr')).read_text().strip(), 'named_rejection:' + name)
        need((run / name / 'mutation.diff').read_text().strip(), 'physical_mutant_diff:' + name)
    reasons = {
        'admit_global_key': 'tower_status:E5:full_ball_static_closed_anchor_missing',
        'consult_anchors': 'tower_status:E5:full_ball_static_missing_weak_terminal',
        'scatter_sorted_index': 'tower_status:E5:full_ball_final_component_count',
        'scatter_holes': 'tower_status:E5:full_ball_static_target_not_strict',
        'unnormalized_anchor': 'tower_status:E5:full_ball_final_component_count',
        'partial_launch': 'partial_launch_admitted_geometry',
    }
    for name, reason in reasons.items():
        need((run / (name + '_run.stderr')).read_text().strip() == reason, 'exact_mutant_reason:' + name)
    for filename in ('fixtures.txt', 'expected.txt', 'driver.cpp'):
        need(sha(HERE / filename) == sha(run / filename), 'captured_input_identity:' + filename)
    fixture_metrics = json.loads((HERE / 'fixture_metrics.json').read_text())
    need(len(fixture_metrics) == 6 and any(r['name'] == 'window' and r['n'] == 8 and r['kmax'] == 6
                                        for r in fixture_metrics), 'window_fixture_present')
    need(len((HERE / 'expected.txt').read_text().splitlines()) == 2524, 'independent_expected_rows')
    print(json.dumps(dict(status='verified_private_static_mutants', commands=len(commands),
        mutants=6, geometry_Gamma_rows=2524, source_files=len(manifest['files']), public_status='not_claimed')))

if __name__ == '__main__':
    main()
