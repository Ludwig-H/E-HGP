#!/usr/bin/env python3
"""Freeze a reviewed private MEB snapshot and guarded-worker inputs; no cloud."""
from __future__ import annotations

import argparse
import hashlib
import importlib.util
import io
import json
from pathlib import Path
import subprocess
import sys
import tarfile

ROOT = Path('/workspaces/E-HGP')
BASE = Path(__file__).resolve().parent
sys.dont_write_bytecode = True


def need(ok, reason):
    if not ok:
        raise ValueError(reason)


def sha(path):
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def save(path, value):
    with path.open('x') as stream:
        json.dump(value, stream, indent=2, sort_keys=True)
        stream.write('\n')


def load(name, path):
    spec = importlib.util.spec_from_file_location(name, path)
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--source', type=Path, required=True)
    parser.add_argument('--key-source', type=Path)
    parser.add_argument('--key-vectors', type=Path)
    parser.add_argument('--out', required=True)
    args = parser.parse_args()
    need(args.out.isidentifier(), 'single fresh output name')
    source = args.source.resolve(strict=True)
    out = BASE / args.out
    out.mkdir(exist_ok=False)
    worker = load('meb_worker', ROOT / 'gcp-migration/anchor_meb_worker_v7.py')
    controller = load('session_controller', ROOT / 'gcp-migration/full_probe_session_v7.py')
    files = {}
    for path in (source / 'morsehgp3D_v7/src').rglob('*'):
        if path.is_file() and path.suffix in ('.h', '.hpp', '.cuh', '.cpp', '.cu'):
            files[path.relative_to(source).as_posix()] = path
    for name in (worker.DEVICE_GATE, worker.DEVICE_FIXTURE):
        files[name] = source / name
    files[worker.LEGACY_PROBE] = ROOT / worker.LEGACY_PROBE
    files[worker.STRICT_HOST] = ROOT / worker.STRICT_HOST
    files[worker.SUPPORT] = ROOT / 'gcp-migration/full_probe_worker_v7.py'
    need((args.key_source is None) == (args.key_vectors is None), 'paired optional arithmetic inputs')
    if args.key_source is not None:
        key_source = args.key_source.resolve(strict=True)
        for name in ('device_gate.cu', 'wire.cuh', 'ball_key_device.cuh'):
            files[worker.KEY_BASE + name] = key_source / name
        for path in (key_source / 'source/morsehgp3D_v7/src').rglob('*'):
            if path.is_file() and path.suffix in ('.h', '.hpp', '.cuh'):
                files[worker.KEY_BASE + path.relative_to(key_source).as_posix()] = path
        files[worker.KEY_VECTORS] = args.key_vectors.resolve(strict=True)
    before = {name: sha(path) for name, path in sorted(files.items())}
    save(out / 'source_origins.json', {name: str(path) for name, path in sorted(files.items())})
    save(out / 'sources_before.json', before)
    snapshot = out / 'source'
    snapshot.mkdir()
    with tarfile.open(out / 'snapshot.tar.gz', 'x:gz') as archive:
        for name, path in sorted(files.items()):
            need(not path.is_symlink(), 'source symlink')
            raw = path.read_bytes()
            need(hashlib.sha256(raw).hexdigest() == before[name], 'source changed during freeze')
            destination = snapshot / name
            destination.parent.mkdir(parents=True, exist_ok=True)
            with destination.open('xb') as stream:
                stream.write(raw)
            destination.chmod(0o444)
            entry = tarfile.TarInfo(name)
            entry.size, entry.mode, entry.mtime = len(raw), 0o444, 0
            archive.addfile(entry, io.BytesIO(raw))
    after = {name: sha(path) for name, path in sorted(files.items())}
    need(before == after, 'source changed during freeze')
    save(out / 'sources_after.json', after)
    save(out / 'source_manifest.json', before)
    need(worker.source_map(snapshot, before) == before, 'worker admission')
    controller.validate_snapshot(out / 'snapshot.tar.gz', before)
    pins = {}
    for name, path in {'snapshot': out / 'snapshot.tar.gz', 'manifest': out / 'source_manifest.json',
                       'worker': ROOT / 'gcp-migration/anchor_meb_worker_v7.py',
                       'controller': ROOT / 'gcp-migration/full_probe_session_v7.py',
                       'start': ROOT / 'gcp-migration/start_and_verify.sh',
                       'stop': ROOT / 'gcp-migration/stop_and_verify.sh',
                       'prepare': Path(__file__)}.items():
        pins[name] = dict(path=str(path), sha256=sha(path))
    save(out / 'pins.json', pins)
    for name, argv in [('head', ['git', 'rev-parse', 'HEAD']), ('status', ['git', 'status', '--porcelain=v1'])]:
        with (out / (name + '.txt')).open('xb') as stream:
            stream.write(subprocess.check_output(argv, cwd=ROOT))
    print(json.dumps(dict(status='frozen', sources=len(before), manifest_sha256=sha(out / 'source_manifest.json'),
                          GCP_used=False, source=str(source), out=str(out)), sort_keys=True))


if __name__ == '__main__':
    main()
