int main(int argc, char** argv) {
  if (argc != 2) return 2;
  const std::string_view mode(argv[1]);
  if (mode != "--selftest" && mode != "--target" && mode != "--slot" && mode != "--pivot" &&
      mode != "--edge-date" && mode != "--mark-date" && mode != "--omit-birth") return 2;
  try {
    using namespace gate;
    auto uniform = make_family_input(CloudFamily::kUniform, 32, 65536, 3);
    if (mode != "--selftest") { fixture("causal_uniform32", uniform, 10, 8, false, mode); return 4; }
    for (int s : {8, 10, 12}) {
      fixture("uniform32", uniform, 10, s, false, mode);
      auto reverse = uniform; std::reverse(reverse.begin(), reverse.end());
      fixture("uniform32_permuted", reverse, 10, s, true, mode);
    }
    fixture("extra_square8", points({{0,0,0},{10,0,0},{0,10,0},{10,10,0},
        {4,4,0},{5,4,0},{4,5,0},{5,5,0}}), 8, 8, true, mode);
    fixture("ABEZW", points({{0,3,0},{8,3,0},{4,2,0},{6,0,0},{4,23,0}}), 5, 8, false, mode);
    fixture("ABCZ", points({{1,8,0},{5,10,0},{9,8,0},{5,0,0}}), 4, 8, true, mode);
    fixture("line3", points({{0,0,0},{2,0,0},{4,0,0}}), 3, 8, true, mode);
    fixture("terminal_pair", points({{0,0,0},{2,0,0}}), 2, 8, false, mode);
    fixture("terminal_singleton", points({{0,0,0}}), 1, 8, false, mode);
    const u64 H = std::accumulate(total.H.begin(), total.H.end(), u64{0});
    const u64 S = std::accumulate(total.S.begin(), total.S.end(), u64{0});
    need(total.fixtures == 12 && total.q3 > 0 && total.q4 > 0 && total.extras > 0 &&
        total.direct[9] > 0 && total.direct[10] > 0 && H > 0 && S > 0 && total.descending > 0 && total.loops > 0 &&
        total.native_births > 0 && total.edges > 0 && total.marks == total.cells && total.decoded == total.cells,
        "gate.nonvacuity");
    need(total.meb_calls == total.anchor_hits + total.intruder_queries &&
        total.candidate_edges == total.edges + total.loops &&
        total.candidate_edges == total.representatives - (total.cells - total.native_births), "gate.work_identities");
    std::printf("{\"status\":\"passed\",\"scope\":\"bounded_real_census_atlas_terminal_pivot_graph_extraction\","
        "\"terminal_authority\":\"test_only_Geometry_differential_actual_Builder_static\",\"device_executed\":false,"
        "\"public_status\":\"not_claimed\",\"checks\":%llu,\"fixtures\":%llu,\"balls\":%llu,\"cells\":%llu,"
        "\"representatives\":%llu,\"point_births\":%llu,\"native_ball_births\":%llu,\"marks\":%llu,"
        "\"candidate_reduced_edges\":%llu,\"loops_removed\":%llu,\"retained_edges\":%llu,"
        "\"q3\":%llu,\"q4\":%llu,\"extras\":%llu,\"meb_calls\":%llu,\"anchor_hits\":%llu,"
        "\"intruder_queries\":%llu,\"descending_steps\":%llu,\"same_radius_steps\":%llu,\"per_k\":[",
        static_cast<unsigned long long>(total.checks), static_cast<unsigned long long>(total.fixtures),
        static_cast<unsigned long long>(total.balls), static_cast<unsigned long long>(total.cells),
        static_cast<unsigned long long>(total.representatives), static_cast<unsigned long long>(total.point_births),
        static_cast<unsigned long long>(total.native_births), static_cast<unsigned long long>(total.marks),
        static_cast<unsigned long long>(total.candidate_edges), static_cast<unsigned long long>(total.loops),
        static_cast<unsigned long long>(total.edges), static_cast<unsigned long long>(total.q3),
        static_cast<unsigned long long>(total.q4), static_cast<unsigned long long>(total.extras),
        static_cast<unsigned long long>(total.meb_calls), static_cast<unsigned long long>(total.anchor_hits),
        static_cast<unsigned long long>(total.intruder_queries), static_cast<unsigned long long>(total.descending),
        static_cast<unsigned long long>(total.same_radius));
    for (unsigned k = 1; k <= 10; ++k) std::printf("%s{\"K\":%u,\"direct\":%llu,\"R\":%llu,\"U\":%llu,"
        "\"S\":%llu,\"Q\":%llu,\"H\":%llu,\"T\":%llu}", k == 1 ? "" : ",", k,
        static_cast<unsigned long long>(total.direct[k]), static_cast<unsigned long long>(total.R[k]),
        static_cast<unsigned long long>(total.U[k]), static_cast<unsigned long long>(total.S[k]),
        static_cast<unsigned long long>(total.Q[k]), static_cast<unsigned long long>(total.H[k]),
        static_cast<unsigned long long>(total.T[k]));
    std::printf("]}\n"); return 0;
  } catch (const mhgp7::full_ball_detail::Failure& error) { std::fprintf(stderr, "reference_failure=%s\n", error.reason); }
    catch (const std::exception& error) { std::fprintf(stderr, "error=%s\n", error.what()); }
  return 1;
}
