struct RankAtlasReference {
  // Only source instrumentation is the existing one-line friend. The real
  // prepare_static_order pays actual work and returns unnormalized BallIds.
  static std::vector<std::vector<u32>> capture(const CloudIndex& ix, std::span<const BallData> balls,
      unsigned requested, FullBallStats& work) {
    Builder builder(ix, balls, requested, work, 1);
    builder.validate_catalogue();
    std::vector<std::vector<u32>> targets(builder.kmax);
    for (unsigned k = 1; k <= builder.kmax; ++k) {
      builder.current_k = k;
      if (k >= 2) {
        builder.prepare_static_order(); targets[k - 1] = builder.static_targets;
      } else for (u32 b : builder.programs[k]) {
        u16 contribution = 0; bool interior = false;
        builder.visit_block(b, contribution, interior, [&](std::vector<i32> sites) {
          require(sites.size() == 1, "gate.reference_K1_size");
          targets[0].push_back(static_cast<u32>(sites[0]));
        });
      }
    }
    return targets;
  }
};
