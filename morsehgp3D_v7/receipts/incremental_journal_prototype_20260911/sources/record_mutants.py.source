#!/usr/bin/env python3
"""Create-only causal mutants of the private implementation; strict O2 only."""
import argparse
import hashlib
import json
from pathlib import Path
import shutil
import subprocess
import time

ROOT = Path(__file__).resolve().parent
REPO = ROOT.parents[1]
MUTANTS = {
    "restore_continuation_early": {
        "file": "full_coverage_certificate.hpp",
        "before": "          live_[parent] = 0;",
        "after": "          live_[parent] = action.parents.size() == 1 ? 1 : 0;",
        "failure": "coverage_parent_not_unique_prebatch_root",
    },
    "ignore_owner_identity": {
        "file": "full_coverage_incremental.hpp",
        "before": "if (!token.owner_ || token.owner_ != owner_ || token.slot_ >= states_.size())",
        "after": "if (!token.owner_ || token.slot_ >= states_.size())",
        "failure": "owner.foreign.token",
    },
    "reserve_every_batch": {
        "file": "full_coverage_certificate.hpp",
        "before": "      const size_t prior_count = out_.nodes_.size();",
        "after": "      const size_t prior_count = out_.nodes_.size();\n"
                 "      out_.nodes_.reserve(prior_count + actions.size());\n"
                 "      out_.successors_.reserve(prior_count + actions.size());\n"
                 "      live_.reserve(prior_count + actions.size());",
        "failure": "growth.not.linear.allocations",
    },
    "write_parent_zero": {
        "file": "full_coverage_certificate.hpp",
        "before": "            out_.parents_.push_back(parent);",
        "after": "            out_.parents_.push_back(0);",
        "failure": "physical.parents.explicit",
    },
}


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--out", required=True)
    args = parser.parse_args()
    out = ROOT / args.out
    out.mkdir(exist_ok=False)
    (out / "record_mutants.py.source").write_bytes(Path(__file__).read_bytes())
    receipt = {"status": "running", "mutations": MUTANTS, "commands": [], "gcp_used": False}
    def save():
        (out / "receipt.json").write_text(json.dumps(receipt, indent=2) + "\n")
    def command(name, argv, expected, causal=None):
        start = time.time()
        done = subprocess.run(argv, cwd=REPO, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        (out / f"{name}.stdout").write_bytes(done.stdout)
        (out / f"{name}.stderr").write_bytes(done.stderr)
        receipt["commands"].append({"name": name, "argv": argv, "started_unix": start,
                                     "elapsed_seconds": time.time() - start, "exit_code": done.returncode,
                                     "expected_exit_code": expected, "expected_causal_failure": causal,
                                     "stdout_sha256": sha(out / f"{name}.stdout"),
                                     "stderr_sha256": sha(out / f"{name}.stderr")})
        save()
        print(name, done.returncode, flush=True)
        if done.returncode != expected or (causal and f"FAIL {causal}\n".encode() != done.stderr):
            raise RuntimeError(f"{name}: unexpected exit/causal diagnostic")
    try:
        for name, mutation in MUTANTS.items():
            target = out / name
            target.mkdir()
            shutil.copytree(ROOT / "variant", target / "variant")
            shutil.copy2(ROOT / "incremental_gate.cpp", target / "incremental_gate.cpp")
            header = target / "variant/morsehgp3D_v7/src/forest" / mutation["file"]
            source = header.read_text()
            if source.count(mutation["before"]) != 1:
                raise RuntimeError(f"{name}: nonunique mutation")
            header.write_text(source.replace(mutation["before"], mutation["after"]))
            receipt.setdefault("mutated_sources", {})[name] = {"header_sha256": sha(header),
                "gate_sha256": sha(target / "incremental_gate.cpp")}
            binary = target / "gate"
            command(f"compile_{name}", ["g++", "-std=c++20", "-O2", "-Wall", "-Wextra",
                "-Wpedantic", "-Werror", "-MMD", "-MF", str(binary)+".d",
                str(target / "incremental_gate.cpp"), "-o", str(binary)], 0)
            command(f"run_{name}", [str(binary)], 1, mutation["failure"])
        receipt["status"] = "passed"
    except Exception as error:
        receipt["status"] = "failed"; receipt["error"] = str(error)
    save()
    return 0 if receipt["status"] == "passed" else 1


if __name__ == "__main__":
    raise SystemExit(main())
