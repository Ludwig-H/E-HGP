#!/usr/bin/env python3
import hashlib
import json
from pathlib import Path
import subprocess
import sys

REPO = Path(__file__).resolve().parents[2]
PACKET = REPO / "morsehgp3D_v7/receipts/incremental_journal_prototype_20260911"
OUT = Path(__file__).resolve().parent / "reader_r1"
OUT.mkdir(exist_ok=False)
for name, target in (("manifest.json", "manifest_initial.json"), ("verify.py", "verify_initial.py.source")):
    (OUT / target).write_bytes((PACKET / name).read_bytes())
commands = []
for name, flags in (("normal", []), ("optimized", ["-O"])):
    argv = [sys.executable, "-B", *flags, str(PACKET / "verify.py")]
    done = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE, check=False)
    (OUT / (name + ".stdout")).write_bytes(done.stdout)
    (OUT / (name + ".stderr")).write_bytes(done.stderr)
    if done.returncode != 1 or b"census_kernels.cuh" not in done.stderr:
        raise ValueError("unexpected initial reader failure")
    commands.append({"argv": argv, "exit_code": done.returncode,
        "stdout_sha256": hashlib.sha256(done.stdout).hexdigest(),
        "stderr_sha256": hashlib.sha256(done.stderr).hexdigest(),
        "name": name})
(OUT / "receipt.json").write_text(json.dumps({"status": "failed_missing_closure_sources",
    "commands": commands, "initial_manifest_sha256": hashlib.sha256((OUT / "manifest_initial.json").read_bytes()).hexdigest()}, indent=2) + "\n")
print("recorded initial portable reader failure, normal and -O")
