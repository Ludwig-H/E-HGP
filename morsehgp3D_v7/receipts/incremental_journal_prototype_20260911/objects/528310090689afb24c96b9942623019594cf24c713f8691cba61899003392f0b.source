#!/usr/bin/env python3
"""Private create-only O2/SAN qualification; no active tree writes or GCP."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import subprocess
import time


ROOT = Path(__file__).resolve().parent
REPO = ROOT.parents[1]
BOOST = REPO / "build/v7_boost_gate/extracted/usr/include"


def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--out", required=True)
    parser.add_argument("--san", action="store_true")
    args = parser.parse_args()
    out = ROOT / args.out
    out.mkdir(exist_ok=False)
    sources = [p for directory in ("baseline", "variant")
               for p in (ROOT / directory).rglob("*") if p.is_file()]
    sources += [ROOT / "incremental_gate.cpp", ROOT / "record.py"]
    auditor = REPO / "morsehgp3D_v7/audits/receipts_journal_guards_20260910/guard_probe.cpp"
    sources.append(auditor)
    before = {str(p.relative_to(REPO)): sha(p) for p in sorted(sources)}
    receipt = {"status": "running", "source_commit": "ad7ffd28b35e153a20bd8cf42534d1cd29160bcd",
               "sources_before": before, "commands": [], "gcp_used": False}
    flags = ["-std=c++20", "-Wall", "-Wextra", "-Wpedantic", "-Werror", "-isystem", str(BOOST)]
    flags += (["-O1", "-g", "-fno-omit-frame-pointer", "-fsanitize=address,undefined"]
              if args.san else ["-O2"])
    environment = os.environ.copy()
    if args.san:
        environment["ASAN_OPTIONS"] = "detect_leaks=1:halt_on_error=1"
        environment["UBSAN_OPTIONS"] = "halt_on_error=1:print_stacktrace=1"
    def save():
        (out / "receipt.json").write_text(json.dumps(receipt, indent=2) + "\n")
    def command(name, argv, expected=0):
        start = time.time()
        with (out / f"{name}.stdout").open("wb") as stdout, (out / f"{name}.stderr").open("wb") as stderr:
            done = subprocess.run(argv, cwd=REPO, env=environment, stdout=stdout, stderr=stderr)
        receipt["commands"].append({"name": name, "argv": argv, "cwd": str(REPO),
                                     "started_unix": start, "elapsed_seconds": time.time()-start,
                                     "exit_code": done.returncode, "expected_exit_code": expected,
                                     "stdout_sha256": sha(out / f"{name}.stdout"),
                                     "stderr_sha256": sha(out / f"{name}.stderr")})
        save()
        print(name, done.returncode, flush=True)
        if done.returncode != expected:
            raise RuntimeError(f"{name}: unexpected exit code {done.returncode}")
    try:
        for flavor in ("baseline", "variant"):
            source = ROOT / flavor / "morsehgp3D_v7/tests/full_coverage_certificate_gate.cpp"
            binary = out / f"{flavor}_facade"
            command(f"compile_{flavor}_facade", ["g++", *flags, "-MMD", "-MF", str(binary)+".d",
                                                   str(source), "-o", str(binary)])
            command(f"run_{flavor}_facade", [str(binary)])
            header = ROOT / flavor / "morsehgp3D_v7/src/forest/full_coverage_certificate.hpp"
            binary = out / f"{flavor}_audit"
            command(f"compile_{flavor}_audit", ["g++", *flags, "-MMD", "-MF", str(binary)+".d",
                f'-DMHGP7_AUDIT_HEADER="{header}"', str(auditor), "-o", str(binary)])
            command(f"run_{flavor}_audit", [str(binary)])
        binary = out / "incremental"
        command("compile_incremental", ["g++", *flags, "-MMD", "-MF", str(binary)+".d",
                                         str(ROOT / "incremental_gate.cpp"), "-o", str(binary)])
        command("run_incremental", [str(binary)])
        command("reject_arguments", [str(binary), "unexpected"], 2)
        for gate in ("facade", "audit"):
            if (out / f"run_baseline_{gate}.stdout").read_bytes() != (out / f"run_variant_{gate}.stdout").read_bytes():
                raise RuntimeError(f"{gate}: baseline/variant output differs")
        receipt["status"] = "passed"
    except Exception as error:
        receipt["status"] = "failed"
        receipt["error"] = str(error)
    finally:
        after = {str(p.relative_to(REPO)): sha(p) for p in sorted(sources)}
        receipt["sources_after"] = after
        receipt["sources_stable"] = before == after
        if not receipt["sources_stable"]:
            receipt["status"] = "failed"
        save()
    return 0 if receipt["status"] == "passed" else 1


if __name__ == "__main__":
    raise SystemExit(main())
