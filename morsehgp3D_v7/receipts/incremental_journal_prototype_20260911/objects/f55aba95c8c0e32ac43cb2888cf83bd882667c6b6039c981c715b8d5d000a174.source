#!/usr/bin/env python3
"""Seal local text evidence and generate a coherent, unapplied source patch."""
import difflib
import hashlib
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parent


def main():
    if (ROOT / "manifest.json").exists() or (ROOT / "delta.patch").exists():
        raise SystemExit("refuse overwrite of existing seal")
    parts = []
    for name in ("full_coverage_certificate.hpp", "full_coverage_incremental.hpp"):
        base = ROOT / "baseline/morsehgp3D_v7/src/forest" / name
        variant = ROOT / "variant/morsehgp3D_v7/src/forest" / name
        before = base.read_text().splitlines(keepends=True) if base.exists() else []
        after = variant.read_text().splitlines(keepends=True)
        parts.extend(difflib.unified_diff(before, after,
            fromfile=f"a/morsehgp3D_v7/src/forest/{name}" if base.exists() else "/dev/null",
            tofile=f"b/morsehgp3D_v7/src/forest/{name}"))
    (ROOT / "delta.patch").write_text("".join(parts))
    selected = {}
    for path in sorted(ROOT.rglob("*")):
        if not path.is_file() or path.name == "manifest.json" or "__pycache__" in path.parts:
            continue
        if path.suffix not in {".hpp", ".cpp", ".py", ".md", ".json", ".stdout", ".stderr",
                               ".source", ".d", ".patch"}:
            continue
        data = path.read_bytes()
        selected[path.relative_to(ROOT).as_posix()] = {
            "sha256": hashlib.sha256(data).hexdigest(), "bytes": len(data)}
    (ROOT / "manifest.json").write_text(json.dumps({"schema": "private_incremental_journal_v1",
        "source_commit": "ad7ffd28b35e153a20bd8cf42534d1cd29160bcd",
        "files": selected, "gcp_used": False}, indent=2) + "\n")
    print(json.dumps({"files": len(selected), "bytes": sum(v["bytes"] for v in selected.values())}))


if __name__ == "__main__":
    main()
