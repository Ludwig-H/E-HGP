#!/usr/bin/env python3
"""Replay the identical sanitized binary outside ptrace; preserve failed run."""
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import time

HERE = Path(__file__).resolve().parent
SOURCE = HERE / 'san'
OUT = HERE / 'san_replay'

def sha(path):
    return hashlib.sha256(path.read_bytes()).hexdigest()

def pins():
    return {p.relative_to(SOURCE / 'source').as_posix(): sha(p)
            for p in sorted((SOURCE / 'source').rglob('*')) if p.is_file()}

def main():
    OUT.mkdir(exist_ok=False)
    binary = SOURCE / 'gate'
    expected = (SOURCE / 'binary.sha256').read_text().strip()
    if sha(binary) != expected:
        raise ValueError('binary_pin')
    original = json.loads((SOURCE / 'sources_before.json').read_text())
    before = pins()
    if before != original:
        raise ValueError('sources_drifted_since_compile')
    (OUT / 'sources_before.json').write_text(json.dumps(before, indent=2, sort_keys=True) + '\n')
    (OUT / 'binary_before.sha256').write_text(expected + '\n')
    shutil.copy2(Path(__file__), OUT / 'replay_sanitizers.py.source')
    argv = [str(binary), str(SOURCE / 'fixtures.txt'), str(SOURCE / 'expected.txt')]
    env = dict(os.environ)
    env['ASAN_OPTIONS'] = 'detect_leaks=1:halt_on_error=1'
    env['UBSAN_OPTIONS'] = 'halt_on_error=1:print_stacktrace=1'
    start = time.time_ns()
    with (OUT / 'stdout').open('wb') as stdout, (OUT / 'stderr').open('wb') as stderr:
        proc = subprocess.run(argv, stdout=stdout, stderr=stderr, env=env)
    after = pins()
    (OUT / 'sources_after.json').write_text(json.dumps(after, indent=2, sort_keys=True) + '\n')
    (OUT / 'binary_after.sha256').write_text(sha(binary) + '\n')
    record = dict(argv=argv, started_ns=start, ended_ns=time.time_ns(), exit_code=proc.returncode,
        stdout_sha256=sha(OUT / 'stdout'), stderr_sha256=sha(OUT / 'stderr'),
        ASAN_OPTIONS=env['ASAN_OPTIONS'], UBSAN_OPTIONS=env['UBSAN_OPTIONS'])
    (OUT / 'command.json').write_text(json.dumps(record, indent=2) + '\n')
    stable = before == after and sha(binary) == expected
    receipt = dict(status='passed' if stable and proc.returncode == 0 else 'failed',
        sources_and_binary_stable=stable, original_ptrace_failure_preserved=True,
        public_status='not_claimed', GCP_used=False)
    (OUT / 'receipt.json').write_text(json.dumps(receipt, indent=2) + '\n')
    print(json.dumps(receipt))
    if receipt['status'] != 'passed':
        raise SystemExit(1)

if __name__ == '__main__':
    main()
