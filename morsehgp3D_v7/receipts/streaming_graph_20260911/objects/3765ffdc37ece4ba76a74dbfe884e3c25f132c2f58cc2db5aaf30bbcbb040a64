void need(bool value, const char* reason) {
  if (!value) throw std::runtime_error(reason);
}

struct Options {
  i64 n = 0, s = 0, kmax = 0, window = 0, threads = 1, history_threads = 1;
  std::string_view mode;
};
bool options(int argc, char** argv, Options& out) {
  unsigned seen = 0;
  for (int i = 1; i < argc; ++i) {
    const std::string_view arg(argv[i]);
    i64* target = nullptr;
    std::size_t offset = 0;
    unsigned bit = 0;
    if (arg.starts_with("--n=")) { target = &out.n; offset = 4; bit = 1; }
    else if (arg.starts_with("--s=")) { target = &out.s; offset = 4; bit = 2; }
    else if (arg.starts_with("--kmax=")) { target = &out.kmax; offset = 7; bit = 4; }
    else if (arg.starts_with("--window=")) { target = &out.window; offset = 9; bit = 8; }
    else if (arg.starts_with("--threads=")) { target = &out.threads; offset = 10; bit = 32; }
    else if (arg.starts_with("--history-threads=")) { target = &out.history_threads; offset = 18; bit = 64; }
    else if (arg.starts_with("--mode=")) { out.mode = arg.substr(7); bit = 16; }
    else return false;
    if ((seen & bit) || (target && !parse_i64_exact(argv[i] + offset, target))) return false;
    seen |= bit;
  }
  return (seen & 31) == 31 && out.n > 0 && out.n <= std::numeric_limits<i32>::max() &&
      out.s >= 8 && out.s <= 32767 && out.kmax >= 1 && out.kmax <= kFacetMaxK && out.window > 0 &&
      static_cast<u64>(out.window) <= std::numeric_limits<std::size_t>::max() &&
      out.threads > 0 && out.threads <= std::numeric_limits<int>::max() &&
      out.history_threads > 0 && out.history_threads <= std::numeric_limits<int>::max() &&
      (out.mode == "reference" || out.mode == "streaming" || out.mode == "compare");
}
double elapsed(Clock::time_point start) {
  return std::chrono::duration<double>(Clock::now() - start).count();
}
template<class Function> double phase(const char* label, Function&& function) {
  std::fprintf(stderr, "phase_start=%s\n", label); std::fflush(stderr);
  const auto start = Clock::now(); function();
  const double seconds = elapsed(start);
  std::fprintf(stderr, "phase_complete=%s seconds=%.9f\n", label, seconds); std::fflush(stderr);
  return seconds;
}

// Dense serialization is intentionally physical within the NEW convention.
// Raw levels are the identical representative chosen by the SAME atlas, not
// normalized rational numbers. It is NOT a geometric/isomorphism oracle.
class DenseHash {
 public:
  void u64v(u64 value) {
    if (used_ + 8 > buffer_.size()) flush();
    for (unsigned i = 0; i < 8; ++i) buffer_[used_++] = static_cast<u8>(value >> (8 * i));
  }
  void tag(const char* value) {
    flush(); hash_.tag(value);
  }
  void level(const ExactLevel& value) {
    need(value.den > 0, "digest.level_denominator");
    for (u64 word : value.num) u64v(word);
    const u128 denominator = static_cast<u128>(value.den);
    u64v(static_cast<u64>(denominator)); u64v(static_cast<u64>(denominator >> 64));
  }
  template<class T> void integers(const std::vector<T>& values) {
    u64v(values.size()); for (const auto value : values) u64v(static_cast<u64>(value));
  }
  std::string hex() { flush(); return hash_.hex(); }
 private:
  void flush() { if (used_) hash_.update(buffer_.data(), used_); used_ = 0; }
  Sha256 hash_;
  std::array<u8, 65536> buffer_{};
  std::size_t used_ = 0;
};

std::string input_digest(const std::vector<InputPoint>& input) {
  DenseHash hash; hash.tag("mhgp7-streaming-bench-input-order-v1"); hash.u64v(input.size());
  for (const auto& p : input) {
    hash.u64v(p.id); hash.u64v(static_cast<u64>(p.position.x));
    hash.u64v(static_cast<u64>(p.position.y)); hash.u64v(static_cast<u64>(p.position.z));
  }
  return hash.hex();
}
std::string payload_digest(const FullBallTowerResult& tower) {
  need(tower.status == FullBallStatus::kCompleteRelative && !tower.orders.empty(), "digest.complete_tower");
  DenseHash hash; hash.tag("mhgp7-graph-FULL-dense-raw-level-bank-v1"); hash.u64v(tower.orders.size());
  const auto& bank = tower.orders.front().forest.populations();
  need(static_cast<bool>(bank), "digest.population_bank");
  hash.integers(bank->domain()); hash.u64v(bank->rows().size());
  for (const auto& row : bank->rows()) { hash.integers(row.interior); hash.integers(row.shell); }
  for (const auto& order : tower.orders) {
    const auto& f = order.forest;
    need(f.populations().get() == bank.get(), "digest.single_shared_bank");
    hash.u64v(f.order()); hash.u64v(f.nodes().size());
    for (const auto& node : f.nodes()) {
      hash.level(node.level); hash.u64v(node.first); hash.u64v(node.parent_count);
    }
    hash.integers(f.parents()); hash.integers(f.successors());
    hash.u64v(f.contributions().size());
    for (const auto& row : f.contributions()) {
      hash.level(row.level); hash.u64v(row.segment); hash.u64v(row.ref.population);
      hash.u64v(row.ref.shell_mask); hash.u64v(row.ref.include_interior);
    }
    hash.integers(order.lower_nodes);
  }
  return hash.hex();
}

// Linear, allocation-free comparison: no descendant labels or point-set union.
void same_payload(const FullBallTowerResult& a, const FullBallTowerResult& b) {
  need(a.status == FullBallStatus::kCompleteRelative && a.status == b.status &&
       !a.orders.empty() && a.orders.size() == b.orders.size(), "compare.tower_shape");
  const auto& bank_a = a.orders.front().forest.populations();
  const auto& bank_b = b.orders.front().forest.populations();
  need(bank_a && bank_b && bank_a->domain() == bank_b->domain() && bank_a->rows().size() == bank_b->rows().size(),
       "compare.bank_shape");
  for (size_t j = 0; j < bank_a->rows().size(); ++j)
    need(bank_a->rows()[j].interior == bank_b->rows()[j].interior && bank_a->rows()[j].shell == bank_b->rows()[j].shell,
         "compare.bank_row");
  for (size_t k = 0; k < a.orders.size(); ++k) {
    const auto& x = a.orders[k].forest; const auto& y = b.orders[k].forest;
    need(x.populations().get() == bank_a.get() && y.populations().get() == bank_b.get() &&
        x.order() == y.order() && x.nodes().size() == y.nodes().size() && x.parents() == y.parents() &&
        x.successors() == y.successors() && a.orders[k].lower_nodes == b.orders[k].lower_nodes,
        "compare.structure_and_verticals");
    for (size_t i = 0; i < x.nodes().size(); ++i)
      need(x.nodes()[i].level == y.nodes()[i].level && x.nodes()[i].first == y.nodes()[i].first &&
           x.nodes()[i].parent_count == y.nodes()[i].parent_count, "compare.node");
    need(x.contributions().size() == y.contributions().size(), "compare.contribution_shape");
    for (size_t i = 0; i < x.contributions().size(); ++i) {
      const auto& u = x.contributions()[i]; const auto& v = y.contributions()[i];
      need(u.level == v.level && u.segment == v.segment && u.ref.population == v.ref.population &&
           u.ref.shell_mask == v.ref.shell_mask && u.ref.include_interior == v.ref.include_interior,
           "compare.dated_contribution");
    }
  }
}

template<class T> u64 capacity_bytes(const std::vector<T>& values) {
  return static_cast<u64>(values.capacity()) * sizeof(T);
}
u64 extraction_capacity(const ag::Extraction& extraction) {
  u64 bytes = extraction.atlas.capacity_bytes();
  for (u64 part : {capacity_bytes(extraction.phi), capacity_bytes(extraction.targets), capacity_bytes(extraction.orders)})
    full_ball_detail::add(bytes, part);
  for (const auto& order : extraction.orders)
    for (u64 part : {capacity_bytes(order.graph.births), capacity_bytes(order.graph.edges), capacity_bytes(order.graph.marks)})
      full_ball_detail::add(bytes, part);
  return bytes;
}
u64 histories_capacity(const std::vector<gf::History>& histories) {
  u64 bytes = capacity_bytes(histories);
  for (const auto& history : histories)
    for (u64 part : {capacity_bytes(history.nodes), capacity_bytes(history.parents), capacity_bytes(history.successors),
                    capacity_bytes(history.roots), capacity_bytes(history.births), capacity_bytes(history.marks)})
      full_ball_detail::add(bytes, part);
  return bytes;
}
u64 tower_capacity(const FullBallTowerResult& tower) {
  u64 bytes = capacity_bytes(tower.orders);
  const auto& bank = tower.orders.front().forest.populations();
  full_ball_detail::add(bytes, capacity_bytes(bank->domain()));
  full_ball_detail::add(bytes, capacity_bytes(bank->rows()));
  for (const auto& row : bank->rows()) {
    full_ball_detail::add(bytes, capacity_bytes(row.interior)); full_ball_detail::add(bytes, capacity_bytes(row.shell));
  }
  for (const auto& order : tower.orders)
    for (u64 part : {capacity_bytes(order.forest.nodes()), capacity_bytes(order.forest.parents()),
                    capacity_bytes(order.forest.successors()), capacity_bytes(order.forest.contributions()),
                    capacity_bytes(order.lower_nodes)}) full_ball_detail::add(bytes, part);
  return bytes;
}

class Json {
 public:
  explicit Json(std::ostream& out) : out_(out) { out_ << '{'; }
  ~Json() { out_ << '}'; }
  void key(const char* name) {
    if (comma_) out_ << ',';
    comma_ = true; out_ << std::quoted(name) << ':';
  }
  template<class T> void field(const char* name, const T& value) { key(name); out_ << value; }
  void field(const char* name, const char* value) { key(name); out_ << std::quoted(value); }
  void field(const char* name, const std::string& value) { key(name); out_ << std::quoted(value); }
  void field(const char* name, std::string_view value) { field(name, std::string(value)); }
  template<class Function> void object(const char* name, Function&& function) {
    key(name); Json child(out_); function(child);
  }
 private:
  std::ostream& out_;
  bool comma_ = false;
};

struct Route {
  FullBallTowerResult tower;
  FullBallStats geometry;
  gf::Work historical_work;
  double extraction_s = 0, certificate_s = 0, history_s = 0, export_s = 0, release_s = 0, route_s = 0, digest_s = 0;
  u64 atlas_logical_bytes = 0, atlas_capacity_bytes = 0, extraction_capacity_bytes = 0;
  u64 histories_capacity_bytes = 0, full_capacity_bytes = 0, export_mapping_capacity_bytes = 0;
  u64 request_capacity_peak_bytes = 0, ordinal_capacity_peak_bytes = 0, occurrences = 0;
  u64 native_edges = 0, native_births = 0, marks = 0, certificate_edges = 0;
  std::array<u64, kFacetMaxK + 1> window_counts{}, occurrence_counts{}, unique_counts{}, initial_seed_counts{};
  std::optional<sg::Stats> streaming_stats;
  u64 certificate_capacity_bytes = 0;
  std::string digest;
};

void account_extraction(Route& route, const ag::Extraction& extraction) {
  route.geometry = extraction.work;
  route.atlas_logical_bytes = extraction.atlas.logical_bytes();
  route.atlas_capacity_bytes = extraction.atlas.capacity_bytes();
  route.extraction_capacity_bytes = extraction_capacity(extraction);
  for (const auto& order : extraction.orders) {
    full_ball_detail::add(route.native_edges, order.graph.edges.size());
    full_ball_detail::add(route.native_births, order.graph.births.size());
    full_ball_detail::add(route.marks, order.graph.marks.size());
  }
}
void export_history(Route& route, ag::Extraction& extraction, std::vector<gf::History>& histories,
                    const Options& opt, const char* label) {
  route.histories_capacity_bytes = histories_capacity(histories);
  route.export_s = phase(label, [&] {
    auto exported = gf::build(extraction, histories, static_cast<size_t>(opt.history_threads));
    route.historical_work = exported.work;
    for (const auto* matrix : {&exported.history_to_full, &exported.descendant_native}) {
      full_ball_detail::add(route.export_mapping_capacity_bytes, capacity_bytes(*matrix));
      for (const auto& row : *matrix) full_ball_detail::add(route.export_mapping_capacity_bytes, capacity_bytes(row));
    }
    route.tower = std::move(exported.tower);
  });
  route.full_capacity_bytes = tower_capacity(route.tower);
}

void reconstruct_histories(Route& route, std::vector<fc::Certificate<u32>>& certificates,
                           std::vector<gf::History>& histories, const char* label) {
  route.certificate_capacity_bytes = capacity_bytes(certificates);
  for (const auto& certificate : certificates) {
    full_ball_detail::add(route.certificate_edges, certificate.edges.size());
    for (u64 part : {capacity_bytes(certificate.births), capacity_bytes(certificate.edges),
                    capacity_bytes(certificate.marks)}) full_ball_detail::add(route.certificate_capacity_bytes, part);
  }
  route.history_s = phase(label, [&] {
    histories.reserve(certificates.size());
    for (auto& certificate : certificates) {
      histories.push_back(fc::reconstruct(certificate, std::less<u32>{}));
      certificate = {};  // This certificate's last consumer has completed.
    }
    std::vector<fc::Certificate<u32>>().swap(certificates);
  });
}
Route reference_route(const CloudIndex& index, std::span<const BallData> balls, const Options& opt) {
  Route route;
  const auto start = Clock::now();
  {
    std::optional<ag::Extraction> extraction;
    route.extraction_s = phase("reference_extract", [&] {
      extraction.emplace(ag::extract(index, balls, static_cast<unsigned>(opt.kmax)));
    });
    account_extraction(route, *extraction);
    route.occurrences = extraction->stats.representatives;
    route.request_capacity_peak_bytes = extraction->stats.peak_request_capacity_bytes;
    route.ordinal_capacity_peak_bytes = extraction->stats.peak_slot_map_capacity_bytes;
    u64 higher_occurrences = 0;
    for (unsigned k = 2; k <= extraction->atlas.kmax; ++k) {
      route.occurrence_counts[k] = extraction->work.static_requests[k];
      route.unique_counts[k] = extraction->work.static_unique[k];
      route.initial_seed_counts[k] = extraction->work.static_seeded[k];
      full_ball_detail::add(higher_occurrences, route.occurrence_counts[k]);
    }
    need(higher_occurrences <= route.occurrences, "reference.occurrence_accounting");
    route.occurrence_counts[1] = route.occurrences - higher_occurrences;
    route.release_s += phase("reference_release_targets", [&] { std::vector<u32>().swap(extraction->targets); });
    std::vector<fc::Certificate<u32>> certificates;
    route.certificate_s = phase("reference_certificates", [&] {
      certificates.reserve(extraction->orders.size());
      for (auto& order : extraction->orders) {
        certificates.push_back(fc::spanning_certificate(order.graph, std::less<u32>{}));
        std::vector<fc::Edge<u32>>().swap(order.graph.edges);
      }  // Per-order dead edges are released here, within certificate_s.
    });
    std::vector<gf::History> histories;
    reconstruct_histories(route, certificates, histories, "reference_histories");
    export_history(route, *extraction, histories, opt, "reference_export");
    route.release_s += phase("reference_release_metadata", [&] {
      std::vector<gf::History>().swap(histories); extraction.reset();
    });
  }
  route.route_s = elapsed(start);  // Includes final temporary destruction.
  return route;
}
Route streaming_route(const CloudIndex& index, std::span<const BallData> balls, const Options& opt) {
  Route route;
  const auto start = Clock::now();
  {
    std::optional<sg::Streaming> streaming;
    route.extraction_s = phase("streaming_atlas_geometry_msf_projection", [&] {
      streaming.emplace(sg::build(index, balls, static_cast<unsigned>(opt.kmax), static_cast<size_t>(opt.window)));
    });
    account_extraction(route, streaming->extraction);
    route.streaming_stats.emplace(streaming->stats);
    need(!sg::Streaming::has_terminal_tape && streaming->extraction.targets.capacity() == 0,
         "streaming.retained_terminal_tape");
    for (const auto& order : streaming->extraction.orders)
      need(order.graph.edges.capacity() == 0, "streaming.retained_full_graph");
    for (unsigned k = 1; k <= streaming->extraction.atlas.kmax; ++k) {
      const auto& order = streaming->stats.orders[k];
      route.occurrence_counts[k] = order.occurrences;
      route.unique_counts[k] = order.window_unique;
      route.initial_seed_counts[k] = order.initial_seed_hits;
      route.window_counts[k] = order.windows;
      full_ball_detail::add(route.occurrences, order.occurrences);
    }
    std::vector<gf::History> histories;
    reconstruct_histories(route, streaming->certificates, histories, "streaming_histories");
    export_history(route, streaming->extraction, histories, opt, "streaming_export");
    route.release_s = phase("streaming_release_metadata", [&] {
      std::vector<gf::History>().swap(histories); streaming.reset();
    });
  }
  route.route_s = elapsed(start);
  return route;
}

