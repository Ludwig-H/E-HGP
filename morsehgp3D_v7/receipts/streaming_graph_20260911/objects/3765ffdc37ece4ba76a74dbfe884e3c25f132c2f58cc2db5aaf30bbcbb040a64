void route_json(Json& json, const Route& route, double common_s) {
  const bool streaming = route.streaming_stats.has_value();
  json.field("whole_s", common_s + route.route_s); json.field("route_s", route.route_s);
  json.field("extract_or_stream_s", route.extraction_s); json.field("certificate_s", route.certificate_s);
  json.field("certificate_included_in_stream", streaming); json.field("history_s", route.history_s);
  json.field("export_s", route.export_s); json.field("other_release_s", route.release_s);
  json.field("digest_s_excluded", route.digest_s); json.field("payload_digest", route.digest);
  json.field("full_status", "complete_relative"); json.field("orders", route.tower.orders.size());
  u64 nodes = 0, parents = 0, contributions = 0, verticals = 0;
  for (const auto& order : route.tower.orders) {
    full_ball_detail::add(nodes, order.forest.nodes().size());
    full_ball_detail::add(parents, order.forest.parents().size());
    full_ball_detail::add(contributions, order.forest.contributions().size());
    full_ball_detail::add(verticals, order.lower_nodes.size());
  }
  json.field("nodes", nodes); json.field("parent_refs", parents);
  json.field("contributions", contributions); json.field("vertical_refs", verticals);
  json.field("occurrences", route.occurrences); json.field("native_births", route.native_births);
  json.field("marks", route.marks); json.field("materialized_native_edges", route.native_edges);
  json.field("retained_certificate_edges", route.certificate_edges);
  json.field("global_unique_measured_K_ge_2", !streaming);
  json.field("unique_accounting", streaming ? "sum_distinct_keys_per_window_including_K1" : "whole_order_distinct_K_ge_2_K1_unmeasured");
  json.object("geometry_work", [&](Json& child) { geometry_json(child, route.geometry); });
  json.object("history_work", [&](Json& child) {
    const auto& w = route.historical_work;
    child.field("contribution_queries", w.contribution_queries); child.field("lower_queries", w.lower_queries);
    child.field("naturality_queries", w.naturality_queries); child.field("light_steps", w.light_steps);
    child.field("binary_steps", w.binary_steps);
  });
  json.object("sampled_capacities_not_RSS", [&](Json& child) {
    child.field("atlas_logical_bytes", route.atlas_logical_bytes); child.field("atlas_capacity_bytes", route.atlas_capacity_bytes);
    child.field("extraction_capacity_bytes", route.extraction_capacity_bytes);
    child.field("certificates_capacity_bytes", route.certificate_capacity_bytes);
    child.field("histories_capacity_bytes", route.histories_capacity_bytes);
    child.field("export_mapping_capacity_bytes", route.export_mapping_capacity_bytes);
    child.field("retained_full_capacity_bytes", route.full_capacity_bytes);
    child.field("reference_request_peak_bytes", route.request_capacity_peak_bytes);
    child.field("reference_ordinal_peak_bytes", route.ordinal_capacity_peak_bytes);
    if (streaming) child.object("streaming", [&](Json& memory) { streaming_memory_json(memory, *route.streaming_stats); });
  });
  json.key("per_order"); std::cout << '[';
  for (unsigned k = 1; k <= route.tower.orders.size(); ++k) {
    if (k != 1) std::cout << ',';
    Json child(std::cout);
    child.field("K", k); child.field("occurrences", route.occurrence_counts[k]);
    child.field("windows", route.window_counts[k]); child.field("unique_measured", streaming || k >= 2);
    child.field("unique", route.unique_counts[k]); child.field("initial_seed_hits", route.initial_seed_counts[k]);
    child.field("Q", route.geometry.static_post_seed_queries[k]); child.field("H", route.geometry.static_post_seed_hits[k]);
    child.field("T", route.geometry.static_post_seed_terminals[k]);
    if (streaming) {
      const auto& stats = *route.streaming_stats; const auto& order = stats.orders[k];
      child.field("seed_rows", order.seed_rows); child.field("pivots", order.pivots);
      child.field("hub_certificate_edges", order.hub_certificate_edges); child.field("projected_edges", order.projected_edges);
      child.field("projected_loops", order.projected_loops); child.field("native_certificate_edges", order.native_certificate_edges);
      child.object("geometry_work", [&](Json& work) { geometry_json(work, order.geometry_work); });
      child.object("hub_msf_work", [&](Json& work) { msf_json(work, stats.hub_work[k]); });
      child.object("native_msf_work", [&](Json& work) { msf_json(work, stats.native_work[k]); });
    }
  }
  std::cout << ']';
}
}  // namespace

int main(int argc, char** argv) {
  Options opt;
  if (!options(argc, argv, opt)) return 2;
  const auto process_start = Clock::now();
  try {
    std::vector<InputPoint> input;
    const double input_s = phase("synthetic_input", [&] {
      input = make_family_input(CloudFamily::kUniform, static_cast<int>(opt.n), 65536, 3);
      need(input.size() == static_cast<size_t>(opt.n), "bench.incomplete_input");
    });
    std::string input_hash;
    const double input_digest_s = phase("input_digest", [&] { input_hash = input_digest(input); });
    const auto common_start = Clock::now();
    CloudIndex index;
    const double index_s = phase("index", [&] { index = build_cloud_index(input); });
    need(index.valid && !index.has_duplicate_positions(), "bench.invalid_index");
    const unsigned kmax = static_cast<unsigned>(std::min<i64>(opt.kmax, opt.n));
    const u64 smax = std::min<u64>(kmax + 1, index.input_count);
    std::vector<BallCandidate> candidates;
    GenerateOptions generation; generation.s = opt.s; generation.smax = smax;
    generation.threads = static_cast<int>(opt.threads);
    GenerateStats generated;
    const double generate_s = phase("generate", [&] { generate_candidates(index, generation, &candidates, &generated); });
    need(generated.cap_refus == kCapRefusNone && !generated.invariant_jneg, "bench.generation_refused");
    const u128 mass = expected_pair_mass(index);
    for (size_t q = 0; q < 3; ++q)
      need(generated.ledger_emitted_mass[q] + generated.ledger_killed_mass[q] == mass, "bench.pair_mass_ledger");
    const u64 raw_candidates = candidates.size();
    const double sort_s = phase("sort_rle", [&] { rle_candidates(&candidates, static_cast<int>(opt.threads)); });
    need(candidates_capacity_ok(candidates.size()), "bench.candidate_representation");
    const u64 unique_candidates = candidates.size(), candidate_capacity = capacity_bytes(candidates);
    std::vector<Survivor> survivors;
    std::vector<BallData> balls;
    ExpandStats census_stats;
    const double prefilter_s = phase("prefilter", [&] {
      prefilter_balls(index, candidates, smax, static_cast<int>(opt.threads), &survivors, &census_stats);
    });
    const double census_s = phase("census", [&] {
      need(census_balls(index, candidates, survivors, smax, kBallShellMax, static_cast<int>(opt.threads),
                       &balls, &census_stats) == PipelineStatus::kCompleteRegular, "bench.census_refused");
    });
    const u64 survivor_count = survivors.size(), survivor_capacity = capacity_bytes(survivors);
    const double upstream_release_s = phase("release_upstream", [&] {
      std::vector<InputPoint>().swap(input);
      std::vector<Survivor>().swap(survivors); std::vector<BallCandidate>().swap(candidates);
    });
    FullBallStats validation;
    const double validation_s = phase("common_validate_catalogue", [&] {
      full_ball_detail::RankAtlasReference::validate(index, balls, kmax, validation);
    });
    const double common_s = elapsed(common_start);
    std::optional<Route> reference, streaming;
    if (opt.mode != "streaming") reference.emplace(reference_route(index, balls, opt));
    if (opt.mode != "reference") streaming.emplace(streaming_route(index, balls, opt));
    if (reference) reference->digest_s = phase("reference_digest", [&] { reference->digest = payload_digest(reference->tower); });
    if (streaming) streaming->digest_s = phase("streaming_digest", [&] { streaming->digest = payload_digest(streaming->tower); });
    double compare_s = 0;
    if (reference && streaming) compare_s = phase("direct_physical_compare", [&] {
      same_payload(reference->tower, streaming->tower);
      need(reference->digest == streaming->digest, "bench.digest_agreement");
      need(reference->occurrence_counts == streaming->occurrence_counts, "bench.occurrence_agreement");
    });
    const double process_s = elapsed(process_start);
    std::cout << std::boolalpha << std::fixed << std::setprecision(9);
    {
      Json json(std::cout);
      json.field("status", "passed"); json.field("scope", "private_real_census_graph_FULL_probe");
      json.field("backend", "cpu_reference"); json.field("public_status", "not_claimed");
      json.field("mode", opt.mode); json.field("n", opt.n); json.field("s", opt.s);
      json.field("requested_K", opt.kmax); json.field("effective_K", kmax); json.field("smax", smax);
      json.field("window", opt.window); json.field("generation_threads", opt.threads);
      json.field("geometry_threads", 1); json.field("history_query_threads", opt.history_threads);
      json.field("family", "uniform"); json.field("coord", 65536); json.field("seed", 3);
      json.field("input_digest", input_hash); json.field("physical_comparison_executed", opt.mode == "compare");
      json.field("geometric_oracle_executed", false);
      json.field("digest_convention", "mhgp7-graph-FULL-dense-raw-level-bank-v1");
      json.field("RSS_protocol", opt.mode == "compare" ? "external_process_peak_two_retained_towers" : "external_process_peak_single_arm_including_validation");
      json.field("whole_protocol", "common_index_through_validation_plus_route_until_retained_FULL_excludes_synthetic_input_digests_comparison");
      json.field("release_protocol", "targets_after_extraction_edges_after_each_certificate_certificates_after_each_history_debug_maps_after_export_metadata_after_FULL");
      json.field("sampled_memory_not_additive_peak", true);
      json.field("synthetic_input_s_excluded", input_s); json.field("input_digest_s_excluded", input_digest_s);
      json.field("comparison_s_excluded", compare_s); json.field("observed_process_s_before_json", process_s);
      json.object("common", [&](Json& child) {
        child.field("common_s", common_s); child.field("index_s", index_s); child.field("generate_s", generate_s);
        child.field("sort_s", sort_s); child.field("prefilter_s", prefilter_s); child.field("census_s", census_s);
        child.field("upstream_release_s", upstream_release_s); child.field("validation_s", validation_s);
        child.field("raw_candidates", raw_candidates); child.field("unique_candidates", unique_candidates);
        child.field("survivors", survivor_count); child.field("balls", balls.size());
        child.field("candidate_capacity_bytes_after_rle", candidate_capacity);
        child.field("survivor_capacity_bytes", survivor_capacity); child.field("ball_capacity_bytes", capacity_bytes(balls));
        child.field("declared_support_checks", validation.declared_support_checks);
        child.object("validation_meb", [&](Json& work) { meb_json(work, validation.validation_work); });
      });
      if (reference) json.object("reference", [&](Json& child) { route_json(child, *reference, common_s); });
      if (streaming) json.object("streaming", [&](Json& child) { route_json(child, *streaming, common_s); });
    }
    std::cout << '\n'; std::cout.flush();
    return std::cout.good() ? 0 : 1;
  } catch (const full_ball_detail::Failure& error) {
    std::fprintf(stderr, "bench_failure=%s\n", error.reason);
  } catch (const std::exception& error) {
    std::fprintf(stderr, "bench_exception=%s\n", error.what());
  }
  return 1;
}
