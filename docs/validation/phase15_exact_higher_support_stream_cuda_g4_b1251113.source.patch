+            compact.forest.equal_level_batches.size() + 1U &&
+        output.stream.exact_merge_node_count ==
+            compact.forest.merge_nodes.size() &&
+        output.stream.exact_child_reference_count ==
+            compact.forest.child_ids.size() &&
