@@ -0,0 +1,89 @@
+#!/usr/bin/env python3
+"""Portes JSON de GAPP2 ; aucune sonde, compilation ou donnee de scene."""
+import copy
+import json
+
+BON = {'census': .09, 'sondes': .05, 'propositions': .70,
+       'propositions_l4': .40, 'propositions_l4f32': .08, 'neutre': 1.0}
+ADOPTE = {'D1': 'adopte', 'D2': 'adopte'}
+REFUSE = {'D1': 'refuse', 'D2': 'refuse'}
+
+
+def cas(pg):
+    def base():
+        c = pg.campagne_synthetique(BON)
+        c['processus'] = 1
+        for nom in c['trames']:
+            c['trames'][nom] = c['trames'][nom][:1]
+        # Schema reel egal pour les deux versions du juge testees.
+        for p in [v[0] for v in c['trames'].values()] + [c['mutants']['l4']]:
+            rows = p['lignes']
+            if not any(json.loads(x)['phase'] == 'transferts' for x in rows):
+                rows.insert(-1, json.dumps({'phase': 'transferts'}))
+        c['mutants']['l4']['lignes'] = [s for s in c['mutants']['l4']['lignes']
+                                             if json.loads(s)['phase'] != 'passe' or json.loads(s)['passe'] <= 1]
+        return c
+    def prise(c):return c['trames']['ng00'][0]
+    def rows(c):return prise(c)['lignes']
+    def change(c, phase, key, value):
+        r = rows(c);i = next(i for i,s in enumerate(r) if json.loads(s)['phase'] == phase)
+        d = json.loads(r[i]);d[key] = value;r[i] = json.dumps(d)
+    def duplicate(c, phase):
+        r = rows(c);i = next(i for i,s in enumerate(r) if json.loads(s)['phase'] == phase)
+        r.insert(i,r[i])
+    def overwritten(c):
+        d = json.loads(rows(c)[-1]);d['identite'] = False;d['census']['ecarts_appareil'] = 1
+        rows(c).insert(-1,json.dumps(d))
+    cases = [('nominal',base(),ADOPTE)]
+    def add(name,mut,expected=REFUSE):
+        c=base();mut(c);cases.append((name,c,expected))
+    add('identite_ecrasee',overwritten)
+    add('phase_inconnue',lambda c:rows(c).insert(-1,json.dumps({'phase':'inconnue'})))
+    add('surplus_processus',lambda c:c['trames']['ng00'].append(copy.deepcopy(prise(c))))
+    add('code_bool',lambda c:prise(c).__setitem__('code',False))
+    add('passe_bool',lambda c:change(c,'passe','passe',False))
+    for phase in ('recolte','appareil','transferts'):
+        add('double_'+phase,lambda c,p=phase:duplicate(c,p))
+    add('transferts_absents',lambda c:rows(c).__delitem__(-2))
+    add('code1_identite_vraie',lambda c:prise(c).__setitem__('code',1))
+    add('drapeau_incoherent',lambda c:change(c,'identite','identite',False))
+    add('effectif_bool',lambda c:c.__setitem__('processus',True))
+    add('trame_surnumeraire',lambda c:c['trames'].__setitem__('autre',copy.deepcopy(c['trames']['ng00'])))
+    add('mutant_code_bool',lambda c:c['mutants']['cote_nul'].__setitem__('code',True))
+    add('mutant_l4_incomplet',lambda c:c['mutants']['l4']['lignes'].pop(2))
+    add('cle_json_repetee',lambda c:rows(c).__setitem__(2,rows(c)[2].replace('"ok": true','"ok": false, "ok": true')))
+    def difference(c,block):
+        d=json.loads(rows(c)[-1]);d[block]['issues_differentes_p64']=1;d['identite']=False
+        rows(c)[-1]=json.dumps(d);prise(c)['code']=1
+    add('d2_seul_ecart_code1',lambda c:difference(c,'propositions_l4f32'),{'D1':'adopte','D2':'rejete'})
+    add('d1_seul_ecart_code1',lambda c:difference(c,'propositions_l4'),{'D1':'rejete','D2':'adopte'})
+    def bad_zero(c):difference(c,'propositions_l4f32');prise(c)['code']=0
+    add('code0_ecart',bad_zero)
+    def informative(c):
+        p=copy.deepcopy(prise(c));p['code']=False
+        p['lignes']=[s for s in p['lignes'] if json.loads(s)['phase'] != 'passe' or json.loads(s)['passe'] <= 2]
+        c['information_k10']=p
+    add('k10_invalide_informatif',informative,ADOPTE)
+    return cases
+
+
+def jouer(pg):
+    out=[]
+    for name,c,expected in cas(pg):
+        try:
+            r=pg.juger(c);actual=r['verdicts']
+            ok=actual==expected
+            if name=='k10_invalide_informatif':ok=ok and 'refus' in r['information_k10']
+        except Exception as exc:
+            actual={'exception':type(exc).__name__};ok=False
+        out.append({'cas':name,'attendu':expected,'rendu':actual,'ok':ok})
+    # La voie CPU informative reste lisible sans lignes appareil ni transferts.
+    lines=pg.journal_synthetique(BON)
+    ds=[json.loads(s) for s in lines if json.loads(s)['phase'] not in ('appareil','transferts')]
+    ds[-1]['appareil']=False
+    try:
+        pg.resumer_processus(pg.lire_journal([json.dumps(d) for d in ds]),3,False)
+        out.append({'cas':'cpu_sans_appareil','ok':True})
+    except Exception as exc:
+        out.append({'cas':'cpu_sans_appareil','ok':False,'exception':type(exc).__name__})
+    return out
