+def check_cohort(errors):
+    # Critere complet : deux voies, K5/W48 ; les essais CPU seuls ne le qualifient pas.
+    config = {'cpu:5:48': {'droites': {'reel': {'fixe_ns': 1e6, 'par_site_ns': 2000}}}}
