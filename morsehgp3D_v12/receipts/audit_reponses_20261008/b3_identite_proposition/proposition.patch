+def lire_resolution(code, sortie, sites, fils):
+    """Une passe G liee a sa commande, ordres 1..K, digest et exit ; schema de bench/tower_probe.cpp."""
+    try:
+        exiger(type(code) is int and code == 0, "code de resolution non nul ou non entier")
+        exiger(lf.is_int(sites) and 0 < sites < 1 << 32 and lf.is_int(fils) and fils > 0,
+               "configuration de resolution invalide")
+        lignes = [json.loads(x, object_pairs_hook=lf.unique_object, parse_constant=lf.reject_constant)
+                  for x in sortie.splitlines()]
+        kmax, ordres = 5, min(5, sites)
+        exiger(len(lignes) == ordres + 3 and all(type(x) is dict for x in lignes),
