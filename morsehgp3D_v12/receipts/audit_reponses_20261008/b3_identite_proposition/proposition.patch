+                    p.update(r)
+                else:
+                    r = lire_resolution(p['code'], texte, sites, fils)
+                    exiger(r['valide'], "resolution d'identite illisible : " + r.get('raison', ''))
+                    exiger(p.get('resolution') == r['resolution'], "resume de resolution different du brut")
+                    p.update(r)
 
 
