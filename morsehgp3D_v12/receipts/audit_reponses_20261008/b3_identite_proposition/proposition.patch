+def relire_preuve(prise, sortie, vus):
+    """Fichier local distinct, SHA et code exacts, stderr vide ferme ; aucun resume ne vaut preuve."""
+    exiger(type(prise) is dict and prise.get('valide') is True and type(prise.get('code')) is int and
+           prise['code'] == 0 and type(prise.get('journal')) is str, "preuve ou code absent/invalide")
+    racine = os.path.realpath(sortie)
+    chemin = os.path.realpath(os.path.join(racine, prise['journal']))
+    err = os.path.realpath(chemin + '.err')
+    exiger(os.path.commonpath((racine, chemin)) == racine and chemin not in vus and
+           os.path.commonpath((racine, err)) == racine and err not in vus and err != chemin,
+           "journal externe ou reutilise")
+    vus.update((chemin, err))
+    exiger(bf.sha256_file(chemin) == prise.get('journal_sha256') and
+           bf.sha256_file(err) == prise.get('stderr_sha256'), "preuve absente ou empreinte differente")
+    with open(err, 'rb') as f:
+        exiger(f.read() == b'', "stderr non vide")
+    with open(chemin, encoding='utf-8') as f:
+        return f.read()
+
