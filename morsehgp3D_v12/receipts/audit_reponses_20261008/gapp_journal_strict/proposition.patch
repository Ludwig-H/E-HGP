+#!/usr/bin/env python3
+"""Porte JSON seule du juge MES-G-APP ; aucune sonde ni construction."""
+import copy
+import importlib.util
+import json
+from pathlib import Path
+import sys
+import tempfile
+from types import SimpleNamespace
+from unittest.mock import patch
+
+
+def charger(path):
+    spec = importlib.util.spec_from_file_location('juge_g_app_test', path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+def cas(module):
+    bon = {'census': .05, 'sondes': .08, 'propositions': .2}
+    def base():
+        c = module.campagne_synthetique(bon)
+        # Un processus suffit pour les gardes ; la vraie campagne reste jugee avec ses cinq.
+        c['processus'] = 1
+        for nom in c['trames']:
+            c['trames'][nom] = c['trames'][nom][:1]
+            lignes = c['trames'][nom][0]['lignes']
+            if not any(json.loads(s)['phase'] == 'transferts' for s in lignes):
+                lignes.insert(-1, json.dumps({'phase': 'transferts'}))
+        return c
+    tests = [('nominal', base(), 'adopte')]
+    def ajouter(nom, mutation, attendu='refuse'):
+        c = base()
+        mutation(c)
+        tests.append((nom, c, attendu))
+    def prise(c):
+        return c['trames']['ng00'][0]
+    def lignes(c):
+        return prise(c)['lignes']
+    def changer(c, phase, cle, valeur):
+        rows = lignes(c)
+        i = next(i for i,s in enumerate(rows) if json.loads(s)['phase']==phase)
+        d = json.loads(rows[i]); d[cle] = valeur; rows[i] = json.dumps(d)
+    def doubler(c, phase):
+        rows = lignes(c); i = next(i for i,s in enumerate(rows) if json.loads(s)['phase']==phase)
+        rows.insert(i, rows[i])
+    def mauvaise_identite_avant(c):
+        d=json.loads(lignes(c)[-1]); d['identite']=False; d['census']['ecarts_appareil']=1
+        lignes(c).insert(-1,json.dumps(d))
+    ajouter('identite_ecrasee', mauvaise_identite_avant)
+    for phase in ('recolte', 'appareil', 'transferts'):
+        ajouter('double_'+phase, lambda c, p=phase: doubler(c,p))
+    ajouter('phase_inconnue', lambda c: lignes(c).insert(-1,json.dumps({'phase':'future'})))
+    ajouter('phases_inversees', lambda c: lignes(c).__setitem__(slice(0,2),list(reversed(lignes(c)[:2]))))
+    ajouter('transferts_manquants', lambda c: lignes(c).__delitem__(-2))
+    ajouter('contenu_apres_identite', lambda c: lignes(c).append(lignes(c)[0]))
+    ajouter('code_bool', lambda c: prise(c).__setitem__('code',False))
+    ajouter('code_float', lambda c: prise(c).__setitem__('code',0.0))
+    ajouter('passe_bool', lambda c: changer(c,'passe','passe',False))
+    ajouter('passe_float', lambda c: changer(c,'passe','passe',0.0))
+    ajouter('surplus_processus', lambda c: c['trames']['ng00'].append(copy.deepcopy(prise(c))))
+    ajouter('trame_inconnue', lambda c: c['trames'].__setitem__('surplus',copy.deepcopy(c['trames']['ng00'])))
+    ajouter('effectif_bool', lambda c: c.__setitem__('processus',True))
+    ajouter('passes_float', lambda c: c.__setitem__('passes',3.0))
+    ajouter('code1_identite_vraie', lambda c: prise(c).__setitem__('code',1))
+    ajouter('drapeau_incoherent', lambda c: changer(c,'identite','identite',False))
+    ajouter('mutant_code_bool', lambda c: c['mutant'].__setitem__('code',True))
+    ajouter('cle_json_repetee', lambda c: lignes(c).__setitem__(2,lignes(c)[2].replace('"ok": true','"ok": false, "ok": true')))
+    ajouter('constante_non_json', lambda c: lignes(c).__setitem__(1,lignes(c)[1][:-1]+', "diagnostic": NaN}'))
+    def ecart(c):
+        d=json.loads(lignes(c)[-1]); d['identite']=False; d['census']['ecarts_appareil']=1
+        lignes(c)[-1]=json.dumps(d); prise(c)['code']=1
+    ajouter('ecart_mesure',ecart,'rejete')
+    def code0_ecart(c):
+        ecart(c); prise(c)['code']=0
+    ajouter('code0_identite_fausse',code0_ecart)
+    def lent(c):
+        for prises in c['trames'].values():
+            rows=prises[0]['lignes']
+            for i,s in enumerate(rows):
+                d=json.loads(s)
+                if d['phase']=='passe':
+                    d['propositions']['appareil_ms']=d['propositions']['hote_ms']
+                    rows[i]=json.dumps(d)
+    ajouter('temps_rejete',lent,'rejete')
+    return tests
+
+
+def jouer(module):
+    sorties=[]
+    for nom,campagne,attendu in cas(module):
+        try:
+            rendu=module.juger(campagne)['verdict']
+        except Exception as erreur:
+            rendu='exception:'+type(erreur).__name__
+        sorties.append({'cas':nom,'attendu':attendu,'rendu':rendu,'ok':rendu==attendu})
+    # La forme hote seule reste lisible ; elle n'est pas une adoption appareil.
+    c=cas(module)[0][1]
+    rows=[s for s in c['trames']['ng00'][0]['lignes'] if json.loads(s)['phase'] not in ('appareil','transferts')]
+    try:
+        module.resumer_processus(module.lire_journal(rows),c['passes'],False)
+        ok=True
+    except Exception:
+        ok=False
+    sorties.append({'cas':'journal_hote_seul','ok':ok})
+    # Integration du lecteur dans la recolte du mutant : capturer/gpu/sha sont des doubles Python.
+    normal=cas(module)[0][1]['trames']['ng00'][0]['lignes']
+    mutant=list(normal)
+    identite=json.loads(mutant[-1]);identite['identite']=False;identite['census']['ecarts_appareil']=1
+    mutant[-1]=json.dumps(identite)
+    for ambigu in (False,True):
+        flux=list(mutant)
+        if ambigu: flux.insert(-1,normal[-1])
+        def faux_capturer(argv,delai,cwd=None):
+            est_mutant=argv[0].endswith('mes_g_app_mutant')
+            return (1 if est_mutant else 0), '\n'.join(flux if est_mutant else normal)+'\n', ''
+        h='0'*64
+        construction={'appareil':True,'binaires':{'mes_g_app':h,'mes_g_app_mutant':h},
+                      'sources':{nom:h for nom in module.SOURCES}}
+        with tempfile.TemporaryDirectory(prefix='gapp-faux-') as td:
+            args=SimpleNamespace(travail=td,sortie=td,donnees=td,fils=48,passes=3,processus=1,delai=1)
+            with patch.object(module,'capturer',faux_capturer), patch.object(module,'gpu_isole',return_value=(True,'')), \
+                    patch.object(module,'sha256',return_value=h):
+                camp=module.campagne(args,construction)
+        rendu=module.juger(camp)['verdict'];attendu='refuse' if ambigu else 'adopte'
+        sorties.append({'cas':'mutant_collecte_ambigu' if ambigu else 'mutant_collecte_nominal',
+                        'attendu':attendu,'rendu':rendu,'ok':rendu==attendu})
+    return sorties
+
+
+if __name__=='__main__':
+    module=charger(Path(sys.argv[1]) if len(sys.argv)>1 else Path(__file__).with_name('pilote_g_appareil.py'))
+    sorties=jouer(module)
+    print(json.dumps(sorties,ensure_ascii=False,sort_keys=True))
+    sys.exit(0 if all(x['ok'] for x in sorties) else 1)
