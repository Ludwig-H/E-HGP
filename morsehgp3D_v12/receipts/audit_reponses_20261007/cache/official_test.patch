+// Sous cache (CST-0007) : une allocation de classe en echec ne laisse ni reservation ni octets tenus ; les blocs
+// inactifs restent tenus sous la limite jusqu'a leur reprise ou leur restitution.
+MHGP12_TEST(alloc_fault_cache, 10) {
+  constexpr u64 kClass300 = 315392;  // classe de 300 Kio : 77 pages de 4 Kio
+  MemoryBudget budget(u64{1} << 22, u64{1} << 22);
+  Buffer<u8> a;
+  fail_nothrow_new = true;
+  const Outcome refused = a.allocate(300 * 1024, budget);
+  fail_nothrow_new = false;
+  CHECK_EQ(refused.reason, Reason::memory_budget);
+  CHECK_EQ(budget.used(), 0u);
+  CHECK_EQ(budget.cache_stats().held, 0u);
+  CHECK_EQ(budget.peak(), kClass300);  // la reservation a existe, a sa taille physique
+  REQUIRE(a.allocate(300 * 1024, budget).ok());
+  a.reset();
+  CHECK_EQ(budget.cache_stats().held, kClass300);  // bloc inactif, tenu
+  Buffer<u8> b;
+  fail_nothrow_new = true;
+  const Outcome refused_class = b.allocate(600 * 1024, budget);  // autre classe : bloc neuf, refuse
+  fail_nothrow_new = false;
+  CHECK_EQ(refused_class.reason, Reason::memory_budget);
+  CHECK_EQ(budget.used(), 0u);
+  CHECK_EQ(budget.cache_stats().held, kClass300);
+  CHECK_EQ(budget.cache_stats().idle, kClass300);
+}
+
+// Course d'eviction (CST-0007, contre-lectures du 7 octobre) : budget et cache de 1 Mio, un bloc inactif de 1 Mio
+// tenu, etage admis pour 300 Kio puis `second_bytes`. Le premier fil rend l'inactif au systeme, lentement ; le second
+// ne doit pas etre refuse pendant cette restitution (avant correction : refus memory_budget, cache vide et held encore
+// plein). Deux bras : 300 Kio (le second fil attend le verrou dans la reprise du cache) et 200 Kio (sous le seuil du
+// cache : il lit held plein, attend le verrou, puis la relecture de held decide ; seul ce bras tue le mutant qui la
+// retire, observation de l'auditeur Codex).
+namespace {
+
+struct RaceArm {
+  bool admitted = false, first_ok = false, second_ok = false, paused = false;
+  u64 used = 0, held = 0, evicted = 0, peak = 0, limit = 0;
+};
+
+RaceArm race_arm(u64 second_bytes) {
+  constexpr u64 kMib = u64{1} << 20, kRequest = 300 * 1024;
+  delete_paused.store(false);
+  second_started.store(false);
+  RaceArm arm;
+  MemoryBudget budget(kMib, kMib);
+  Buffer<u8> cached;
+  if (!cached.allocate(kMib, budget).ok()) return arm;
+  slow_delete.store(cached.data());
+  cached.reset();
+  arm.admitted = budget.admit(kRequest + second_bytes).ok();
+  Buffer<u8> first, second;
+  std::thread evicting([&] { arm.first_ok = first.allocate(kRequest, budget).ok(); });
+  const auto limit = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+  while (!delete_paused.load() && std::chrono::steady_clock::now() < limit) std::this_thread::yield();
+  arm.paused = delete_paused.load();
+  std::thread waiting([&] {
+    second_started.store(true);
+    arm.second_ok = second.allocate(second_bytes, budget).ok();
+  });
+  waiting.join();
+  evicting.join();
+  slow_delete.store(nullptr);
+  const auto stats = budget.cache_stats();
+  arm.used = budget.used();
+  arm.held = stats.held;
+  arm.evicted = stats.evicted;
+  arm.peak = budget.peak();
+  arm.limit = budget.limit();
+  return arm;
+}
+
+}  // namespace
+
+MHGP12_TEST(eviction_admise, 12) {
+  constexpr u64 kClass300 = 315392, k200 = 200 * 1024;
+  const RaceArm cached_arm = race_arm(300 * 1024);
+  CHECK(cached_arm.admitted && cached_arm.first_ok && cached_arm.paused);
+  CHECK(cached_arm.second_ok);
+  CHECK_EQ(cached_arm.used, 2 * kClass300);
+  CHECK_EQ(cached_arm.held, 2 * kClass300);
+  CHECK_EQ(cached_arm.evicted, 1u);
+  CHECK(cached_arm.peak <= cached_arm.limit);
+  const RaceArm small_arm = race_arm(k200);
+  CHECK(small_arm.admitted && small_arm.first_ok && small_arm.paused);
+  CHECK(small_arm.second_ok);
+  CHECK_EQ(small_arm.used, kClass300 + k200);
+  CHECK_EQ(small_arm.held, kClass300 + k200);
+  CHECK_EQ(small_arm.evicted, 1u);
+  CHECK(small_arm.peak <= small_arm.limit);
 }
 
