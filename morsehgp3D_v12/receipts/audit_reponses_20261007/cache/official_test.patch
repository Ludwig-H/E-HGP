+// Restitution lente d'un bloc designe (temoin de course de l'auditeur Codex, 7 octobre) : le delete de ce bloc attend
+// que le second fil ait commence sa demande, puis lui laisse 200 ms ; au plus 5 s d'attente en tout.
+std::atomic<void*> slow_delete{nullptr};
+std::atomic<bool> delete_paused{false}, second_started{false};
+
+void pause_if_slow(void* block) noexcept {
+  if (block == nullptr || block != slow_delete.load()) return;
+  delete_paused.store(true);
+  const auto limit = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+  while (!second_started.load() && std::chrono::steady_clock::now() < limit) std::this_thread::yield();
+  const auto until = std::chrono::steady_clock::now() + std::chrono::milliseconds(200);
+  while (std::chrono::steady_clock::now() < until) std::this_thread::yield();
+}
 
