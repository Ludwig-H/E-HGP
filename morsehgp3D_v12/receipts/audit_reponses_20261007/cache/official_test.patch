+// Etat de test, pilote par un seul fil ; atomique parce que eviction_admise alloue depuis deux fils.
+std::atomic<bool> fail_nothrow_new{false};
+std::atomic<long> throwing_countdown{-1};  // >= 0 : nombre d'allocations encore admises avant que new leve
