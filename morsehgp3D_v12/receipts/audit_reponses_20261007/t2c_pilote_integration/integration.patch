+def prise_catalogue(binaire, entree_, fils, passes, journal):
+    """Un processus neuf de la sonde du catalogue : passes ordonnees reussies, mur strictement positif, sortie ok ;
+    temps du catalogue = mediane des passes 2..P (publie, jamais juge)."""
+    code, lignes = jouer([binaire] + entree_ + ["--k=5", "--threads=%d" % fils, "--passes=%d" % passes], journal)
+    murs = []
+    try:
+        exiger(code == 0 and len(lignes) == passes + 1, "processus en echec ou sortie incomplete")
+        for p, row in enumerate(lignes[:passes]):
+            exiger(type(row) is dict and row.get("phase") == "catalogue" and row.get("pass") == p and
+                   row.get("status") == "ok", "passe du catalogue invalide")
+            murs.append(naturel(row.get("wall_ns"), minimum=1))
+        exiger(lignes[-1] == {"phase": "exit", "status": "ok", "reason": "none"}, "sortie du catalogue invalide")
+    except ValueError as error:
+        return {"valide": False, "admission": str(error), "journal_sha256": sha256(journal)}
+    return {"valide": True, "catalogue_ns": mediane(murs[1:]), "murs_ns": murs, "journal_sha256": sha256(journal)}
+
+
+def campagne_catalogue(args, binaires):
+    """Catalogue de la base et du produit (table S* a fiches contigues) en processus alternes, 3 tours par trame ;
+    catalogue + G par tour : mediane chaude du catalogue plus celle de G du meme tour et du meme bras de la campagne
+    K5 (processus distincts : appariement par tour seulement)."""
+    out = {}
+    for trame in TRAMES:
+        dossier = os.path.join(args.sortie, "journaux", "catalogue_k5", trame)
+        os.makedirs(dossier, exist_ok=True)
+        tours = []
+        for t in range(3):
+            ordre = ("avant", "apres") if t % 2 == 0 else ("apres", "avant")
+            tours.append({b: prise_catalogue(binaires["catalogue_" + b], entree(args, trame), args.fils, args.passes,
+                                             os.path.join(dossier, "%s_t%02d.jsonl" % (b, t))) for b in ordre})
+        out[trame] = tours
+    return out
 
 
