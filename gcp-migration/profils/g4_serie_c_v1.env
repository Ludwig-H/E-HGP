# PROFIL `g4_serie_c_v1` — BROUILLON POUR VERROU AUDITEUR (1er septembre
# 2026, NOTE_CLAUDE_GO_G4_SERIE_C). Trois blocs : (1) reçu DEVICE de la
# série C (premier nvcc/device jamais exercé : build MHGP6_ENABLE_CUDA puis
# label `gpu` complet, 17 portes) ; (2) MESURE du pilote mhgp6_cuda (parité
# de tous les digests exigée à chaque run, coûts wire/H2D/kernels/D2H
# séparés) ; (3) MATRICE CPU DÉCISIONNELLE fils × inflight × join,
# avec/sans digest — murs au Release NON instrumenté, attribution
# mhgp6_profile aux points clefs (arbre § 5.10 pré-enregistré :
# CompactDelta / budget de workers / layout).
# Les clés GPUV6_*, MATRICE_* et ATTRIB_* sont NOUVELLES : le runner
# (v6_campaign_remote.sh) et le validateur ne les consomment pas encore —
# extension à écrire APRÈS le verrou auditeur (questions a/b/c de la note).
PROFIL_NOM="g4_serie_c_v1"
# Porte d'entrée inchangée : accord différentiel v5≡v6 aux tailles du
# contrat (échec = session invalide avant toute mesure).
CONF_SPECS="uniform:32000 terrain:32000 eight_clusters:32000 scanline_single_pass:32000 uniform:50000 terrain:50000 eight_clusters:50000 scanline_single_pass:50000"
BENCH_SPECS="aucun"
QUEUE_FAMILIES="aucun"
QUEUE_N="64000"
QUEUE_SEEDS="3"
RUN_TIMEOUT=2400
THREADS_VM=48
V5_GATE_MIN=40
V6_GATE_MIN=60
# Phase GPU v5 historique : RETIRÉE (le reçu existe, d98f4729) — remplacée
# par le bloc série C v6 ci-dessous.
GPU_SPECS="aucun"
SWEEP_SPECS="aucun"
SWEEP_REPEATS=1
FRONTIER_SPECS="aucun"
FRONTIER_TIMEOUT=3600
GPU_BUILD_TIMEOUT=900
FRONTIER_ULIMIT_KB=0
# ---- BLOC 1 : reçu device série C (NOUVEAU — verrou sollicité).
# Build CUDA (sm_120, -fmad=false) puis ctest -L gpu --output-on-failure :
# témoin ×5, census device ×8 (relecture intégrale d'index), pilote ×4 —
# chaque porte à code exact ; arch compilée + device observé gravés au reçu.
GPUV6_BUILD_TIMEOUT=1800
GPUV6_GATE_TIMEOUT=3600
GPUV6_GATE_MIN=17
# ---- BLOC 2 : mesure du pilote (NOUVEAU). name=family:n:repeat ; chaque
# run exige parite=OUI (sinon phase invalide) ; --lot par défaut (2^21) +
# un run --lot=17 --min-lots=2 de contrôle multi-lots à 50000 uniform.
GPUV6_PILOT_SPECS="uniform:50000:3 terrain:50000:3 eight_clusters:50000:3 scanline_single_pass:50000:3 uniform:200000:1"
GPUV6_PILOT_TIMEOUT=2400
# ---- BLOC 3 : matrice CPU décisionnelle (NOUVEAU) : famille:n:fils:inflight:join:digest
# Murs = binaire Release NON instrumenté ; ordre contrebalancé ABBA ;
# répétitions ×2.
MATRICE_SPECS="uniform:16000:16,24,32,48:1,2,4:0,1:avec,sans uniform:50000:48:2:0,1:avec"
MATRICE_REPEATS=2
MATRICE_TIMEOUT=2400
# Attribution (mhgp6_profile, jamais un mur) aux points clefs.
ATTRIB_SPECS="uniform:16000:16:2:0 uniform:16000:48:2:0 uniform:16000:48:2:1 uniform:50000:48:2:1"
ATTRIB_TIMEOUT=2400
