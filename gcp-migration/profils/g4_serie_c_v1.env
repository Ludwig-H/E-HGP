# PROFIL `g4_serie_c_v1` — v2 conforme au § 5.12 (GO conditionnel f97ed226).
# ORDRE DES PHASES sur la VM (doctrine du runner, fail-fast) :
#   conf (porte d'entree v5≡v6) → MATRICE CPU + ATTRIBUTION (avant tout
#   build nvcc) → build CUDA → `ctest -V -L gpu` sur l'INVENTAIRE EXACT des
#   16 noms (premier rouge = aucun pilote) → PILOTE 4 familles 50k
#   (echauffement exclu + 4 repetitions ABBA, parite exigee a chacune).
# PAS de point 200k (differe, § 5.12 Q2) ; JAMAIS --lot=17 a 50k (reserve a
# la porte n=400) — le controle multi-lots passe par le lot produit par
# defaut + --min-lots=2 (~21,6 M candidats => plusieurs lots naturels).
# Chaque run conserve : commande, code, stdout/stderr, GNU time/RSS, hashes
# binaires, charge/AFFINITE REELLE (taskset/numactl graves — --threads seul
# ne prouve rien)/NUMA, versions driver/nvcc, UUID + compute capability,
# temperature/horloges avant-apres, chronos bruts + fermeture contre le mur.
PROFIL_NOM="g4_serie_c_v1"
# Porte d'entree inchangee : accord differentiel v5≡v6 aux tailles du contrat.
CONF_SPECS="uniform:32000 terrain:32000 eight_clusters:32000 scanline_single_pass:32000 uniform:50000 terrain:50000 eight_clusters:50000 scanline_single_pass:50000"
BENCH_SPECS="aucun"
QUEUE_FAMILIES="aucun"
QUEUE_N="64000"
QUEUE_SEEDS="3"
RUN_TIMEOUT=2400
THREADS_VM=48
V5_GATE_MIN=40
V6_GATE_MIN=60
GPU_SPECS="aucun"
SWEEP_SPECS="aucun"
SWEEP_REPEATS=1
FRONTIER_SPECS="aucun"
FRONTIER_TIMEOUT=3600
GPU_BUILD_TIMEOUT=900
FRONTIER_ULIMIT_KB=0
# ---- MATRICE CPU DECISIONNELLE : CONTRASTES PRE-ENREGISTRES (§ 5.12, pas
# un produit cartesien). 16 points, format famille:n:fils:inflight:join:digest.
# P01-P04 fils, P05-P08 inflight, P09-P10 join, P11-P12 digest, P13-P16 le
# point de contrat 50k (les deux bras digest, sequence NON ambigue).
MATRICE_POINTS="uniform:16000:16:2:0:sans uniform:16000:24:2:0:sans uniform:16000:32:2:0:sans uniform:16000:48:2:0:sans uniform:16000:24:1:0:sans uniform:16000:24:4:0:sans uniform:16000:48:1:0:sans uniform:16000:48:4:0:sans uniform:16000:16:2:1:sans uniform:16000:48:2:1:sans uniform:16000:48:2:0:avec uniform:16000:48:2:1:avec uniform:50000:48:2:0:sans uniform:50000:48:2:1:sans uniform:50000:48:2:0:avec uniform:50000:48:2:1:avec"
# Trois repetitions par point, SEQUENCE GLOBALE pre-enregistree : passage 1 =
# P01..P16 (aller), passage 2 = P16..P01 (retour), passage 3 = P01..P16.
MATRICE_SEQUENCE="aller retour aller"
MATRICE_TIMEOUT=2400
# Attribution (mhgp6_profile — ATTRIBUTION seulement, jamais un mur) :
# famille:n:fils:inflight:join, une execution chacune, apres la matrice.
ATTRIB_POINTS="uniform:16000:16:2:0 uniform:16000:48:2:0 uniform:16000:48:2:1 uniform:50000:48:2:1"
ATTRIB_TIMEOUT=2400
# ---- Recu DEVICE : build CUDA puis l'inventaire EXACT (le validateur exige
# ces 16 noms, jamais un plancher).
GPUV6_BUILD_TIMEOUT=1800
GPUV6_GATE_TIMEOUT=3600
GPUV6_GATE_NAMES="mhgp6_device_witness mhgp6_device_witness_mutant_carry mhgp6_device_witness_mutant_skip_write mhgp6_device_witness_mutant_skip_native mhgp6_census_device mhgp6_census_device_mutant_range_le mhgp6_census_device_mutant_stack mhgp6_census_device_mutant_swap mhgp6_census_device_mutant_nonstrict mhgp6_census_device_mutant_skip_write mhgp6_census_device_mutant_nshell mhgp6_census_device_mutant_skip_count mhgp6_pilote_parite_400 mhgp6_pilote_refus_n mhgp6_pilote_lot17 mhgp6_pilote_mutant_base"
# ---- PILOTE (mesure du gain) : famille:n — echauffement non retenu + 4
# repetitions ABBA par le binaire (--repeat=4, defaut), lot produit par
# defaut, --min-lots=2 ; le validateur exige les indices de repetition,
# retenue=OUI x4, parite=OUI a chacune, et recalcule
# H2D = index + 212*nb_total, D2H = 100*nb_total.
GPUV6_PILOT_SPECS="uniform:50000 terrain:50000 eight_clusters:50000 scanline_single_pass:50000"
GPUV6_PILOT_MIN_LOTS=2
GPUV6_PILOT_TIMEOUT=3600
# ---- Enveloppe session (§ 5.12) : une seule VM g4-standard-48 SPOT,
# instanceTerminationAction=STOP ; PREFERENCE 5 h GCE (maxRunDuration=18000)
# / 270 min invite ; plafond EXCEPTIONNEL 7 h (25200) / 415 min ; >= 30 min
# reservees au rapatriement/arret ; demarrage par script garde seulement ;
# arret certifie TERMINATED sur la generation exacte, succes ou echec.
SESSION_MAX_RUN_SECONDS=18000
SESSION_INVITE_MINUTES=270
