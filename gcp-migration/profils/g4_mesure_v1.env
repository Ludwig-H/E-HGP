# PROFIL CANONIQUE `g4_mesure_v1` — campagne de MESURE G4 v6 (31 aout 2026) :
# gain de parallelisme CPU (phase FILS, bit-identite entre fils), gain GPU
# (phase GPU v5 : temoin + lanes + mutant + contrats CPU/--gpu/adaptatif/
# wire=index a digests identiques), frontiere memoire (phase FRONTIERE :
# RSS graves, l'echec est une donnee). La conformite v5≡v6 aux tailles 32000
# et 50000 reste la porte d'entree ; queue et bench reduits (les campagnes
# locales replication/confirmation portent deja les pentes).
PROFIL_NOM="g4_mesure_v1"
CONF_SPECS="uniform:32000 terrain:32000 eight_clusters:32000 scanline_single_pass:32000 uniform:50000 terrain:50000 eight_clusters:50000 scanline_single_pass:50000"
BENCH_SPECS="uniform:50000 eight_clusters:50000"
QUEUE_FAMILIES="aucun"
QUEUE_N="64000"
QUEUE_SEEDS="3"
RUN_TIMEOUT=2400
THREADS_VM=48
V5_GATE_MIN=40
V6_GATE_MIN=60
# FILS : courbe complete a 16000 (deux familles, 1..48), points de controle
# a 50000 (8/16/48). Ordre contrebalance par repetition (ABBA).
SWEEP_SPECS="uniform:16000:1,2,4,8,16,32,48 eight_clusters:16000:1,2,4,8,16,32,48 uniform:50000:8,16,48"
SWEEP_REPEATS=2
# GPU (moteur v5, seule ligne CUDA) : les quatre familles au contrat 50k.
GPU_SPECS="uniform:50000 terrain:50000 eight_clusters:50000 scanline_single_pass:50000"
# FRONTIERE : v6 a 48 fils, tailles croissantes jusqu'au mur des 180 GiB ;
# scanline_stationnaire = le regime surface a l'echelle (queue d'ancres).
FRONTIER_SPECS="uniform:200000 scanline_stationnaire:200000 uniform:400000 uniform:800000"
FRONTIER_TIMEOUT=3600
# Duree maximale des DEUX runs de build CUDA (temoin, lanes) ; toute duree
# appartient au profil (cinquieme tour).
GPU_BUILD_TIMEOUT=3600
# Plafond de memoire virtuelle (kB) des runs de frontiere : transforme un
# OOM muet en std::bad_alloc TYPE (175 GiB sur 180 GiB de VM ; 0 = aucun).
FRONTIER_ULIMIT_KB=183500800
