# PROFIL g4_echelle_v1 (2 septembre 2026) — SESSION « ECHELLE » : ou est le
# mur de la v6 EN MEMOIRE sur une g4-standard-48 (48 fils, 180 Gio), a K=5 et
# a K=10, avec quelle pente, et que coute la couture hote de la route device
# au-dela de 50k. Directive exploitant du 2 septembre : « concentre-toi sur
# l'implementation multi-CPU et GPU pour nuages de dizaines de milliers de
# points jusqu'a des dizaines de millions ; feu vert pour la GCP G4 ».
#
# REVISION APRES LE PREFLIGHT STATIQUE DES AUDITEURS
# (audits/ALERTE_G4_ECHELLE_V6_20260902.md, coupe 8afd1057, verdict NO START) :
#   - les six specs `famille:n:6` exigent le portage de `smax` de bout en bout
#     (plan v2, argv, .status, resume, validateur) et le raccord du profil aux
#     listes PROTOCOL_FILES du pin ET du lifecycle — livres a part ;
#   - le layout de stockage est GRAVE (baseline `classic`) : depuis le pin
#     KeyCSR `8afd1057` un reçu qui le laisserait implicite serait ambigu ;
#   - un code 124 (timeout) reste une OBSERVATION CENSUREE pour le validateur,
#     jamais une donnee de frontiere : la conclusion honnete d'une session
#     tronquee est « frontiere de completion + dernier profil reussi » ;
#   - un `bad_alloc` generique n'identifie pas l'etage qui deborde (les RSS par
#     etage ne sont imprimes qu'apres succes) : cette session mesure la
#     frontiere de completion, pas l'etage coupable ;
#   - budget resserre (l'estimateur credite AU PLAFOND toute taille inconnue).
#
# QUESTIONS DECISIONNELLES :
#   Q1 (frontiere, obligatoire) : plus grand n complet en memoire sous
#       RLIMIT_AS, a K=5 (smax=6) et a K=10 (smax=11), et PENTE du mur et du
#       RSS sur au moins quatre tailles par famille et par K. Faits acquis :
#       reçu 1788245493 (K=10 : 200k = 225 s / 78,8 Go, 400k = 479 s /
#       153,9 Go, 800k = bad_alloc) ; reçu 1788312873 (K=5 ≈ 5 fois moins cher
#       que K=10 en temps et en memoire sur les familles denses) ; mesure
#       locale du 2 septembre a 8 fils (uniform, K=5) : 100k = 5,21 Go /
#       109 s, 200k = 10,37 Go / 256 s, soit 0,052 Mo/point et 83 boules par
#       point — a 48 fils la residence est superieure (plus de shards), ce que
#       cette session mesure. Le point K=10 a 600k est place ENTRE le dernier
#       succes connu (400k) et le refus connu (800k) : il encadre le mur.
#   Q2 (pilote serie C) : DESARME DANS CE PROFIL. Le runner execute la phase
#       device AVANT la frontiere (qui est « EN DERNIER ») : promettre Q1 en
#       prefixe obligatoire et Q2 en suffixe optionnel etait donc faux
#       (retour auditeur). Q2 part dans une session separee, avec son propre
#       profil, apres le palier C6. Ce qui suit reste le cahier des charges
#       de cette session-la :
#       fenetre) : au reçu 1788293187 (50k) l'etage device est domine par
#       l'HOTE (wire 2,6 s + reconstruction 4,1 s sur 7,7 s, kernels 154 ms).
#       Le TEMOIN 50k est reexecute SOUS CE COMMIT ET CE BINAIRE, apparie au
#       point 100k : sans lui, aucune croissance « depuis 50k » ne serait
#       opposable (exigence des auditeurs). Entree du palier C6
#       (QUESTION_CLAUDE_CONCEPTION_C6_20260902.md).
# Aucun benchmark ne promeut public_status ; not_claimed.
PROFIL_NOM="g4_echelle_v1"
CONF_SPECS="aucun"
BENCH_SPECS="aucun"
QUEUE_FAMILIES="aucun"
QUEUE_N="64000"
QUEUE_SEEDS="3"
RUN_TIMEOUT=2400
THREADS_VM=48
V5_GATE_MIN=40
V6_GATE_MIN=60
GPU_SPECS="aucun"
SWEEP_SPECS="aucun"
SWEEP_REPEATS=1
# ---- FRONTIERE (executee EN DERNIER) : famille:n[:smax], plan v2, layout
# grave. Neuf points : quatre tailles K=5 sur uniform (pente + mur), trois
# tailles K=5 sur terrain (pente 200k -> 2M, jamais une secante 1M -> 2M), et
# deux points K=10 (200k = reproductibilite inter-sessions contre le reçu
# 1788245493 ; 600k = encadrement du mur entre 400k reussi et 800k refuse).
FRONTIER_SPECS="uniform:200000:6 uniform:500000:6 uniform:1000000:6 uniform:2000000:6 terrain:200000:6 terrain:1000000:6 terrain:2000000:6 uniform:200000 uniform:600000"
FRONTIER_LAYOUT="classic"
FRONTIER_TIMEOUT=1200
# Plafond de memoire VIRTUELLE : 168 Gio. Le reçu anterieur de cette G4 grave
# MemTotal = 185 463 908 Kio (176,87 Gio) ; RLIMIT_AS ne borne pas le RSS du
# systeme, donc la limite est posee ~9 Gio sous MemTotal pour que le refus
# soit un bad_alloc TYPE du processus et non l'OOM killer (exigence de marge
# des auditeurs). MemTotal, MemAvailable et la charge sont graves par le
# protocole et doivent etre rapportes.
FRONTIER_ULIMIT_KB=176160768
GPU_BUILD_TIMEOUT=900
MATRICE_POINTS="aucun"
MATRICE_SEQUENCE="aller"
MATRICE_TIMEOUT=2400
ATTRIB_POINTS="aucun"
ATTRIB_TIMEOUT=2400
# ---- Device : build CUDA (arch 120 contractuelle), inventaire exact des
# portes gpu, puis le pilote serie C sur DEUX points APPARIES sous le meme
# commit et le meme binaire : 50000 (temoin, comparable au reçu 1788293187)
# et 100000. Echauffement + 4 repetitions ABBA, parite recalculee par le juge
# embarque apres chaque famille.
# Device DESARME dans cette session (ni build CUDA, ni portes gpu, ni
# pilote) : la frontiere est la seule question, et le runner la place en
# dernier. Un profil qui armerait le pilote sans l'inventaire exact des
# portes gpu serait de toute facon refuse avant tout run.
GPUV6_BUILD_TIMEOUT=900
GPUV6_GATE_TIMEOUT=1800
GPUV6_GATE_NAMES="aucun"
GPUV6_PILOT_SPECS="aucun"
GPUV6_PILOT_MIN_LOTS=2
GPUV6_PILOT_TIMEOUT=2700
# Aucune fixture d'egalite gravee a 100000 (premier temoin) ; a 50000 la
# parite CPU/device de chaque record reste exigee et le digest_all doit egaler
# celui du reçu 1788293187 pour la meme entree — a verifier a la lecture, la
# fixture GPUV6_OBJET_DIGESTS sera gravee dans un profil v2 depuis CE reçu.
GPUV6_OBJET_DIGESTS="aucun"
MATRICE_OBJET_DIGESTS="aucun"
BIN_MATRICE="./build-v6/mhgp6"
BIN_ATTRIB="./build-v6/mhgp6_profile"
BIN_PILOTE="./build-v6-cuda/mhgp6_cuda"
# ---- Enveloppe : 5 h GCE / invite 285 min — predicat
# 285*60 + 300 + 120 + 480 = 18000 exactement. Credits DECLARES AVANT MESURE
# par l'estimateur du lifecycle (toute taille inconnue est creditee AU
# PLAFOND) : frontiere 9 x 1200 = 10 800 s, overhead ~90 s, device desarme.
# Total credite ~10 890 s pour une fenetre utile de ~13 195 s : marge
# ~2 305 s (~17 %). La session ne pose qu'une question, elle ne peut pas la
# perdre par troncature d'une autre phase.
SESSION_MAX_RUN_SECONDS=18000
SESSION_INVITE_MINUTES=285
