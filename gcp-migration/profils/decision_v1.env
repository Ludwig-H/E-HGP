# PROFIL CANONIQUE `decision_v1` — la matrice d'une campagne de DECISION G4
# v6 (audit GCP v6, deuxieme tour : le profil d'autorite est versionne et
# hashe, jamais fabrique par des variables d'environnement ; toute
# surcharge degrade le profil effectif en `custom`).
# Conformite : les QUATRE familles partagees a TOUTES les tailles mesurees.
CONF_SPECS="uniform:32000 terrain:32000 eight_clusters:32000 scanline_single_pass:32000 uniform:50000 terrain:50000 eight_clusters:50000 scanline_single_pass:50000 uniform:100000 terrain:100000 eight_clusters:100000 scanline_single_pass:100000 uniform:200000 terrain:200000 eight_clusters:200000 scanline_single_pass:200000"
# Bench apparie ABBA : quatre familles a 32000 ; uniform et eight_clusters
# aux tailles d'extension (les deux familles dont la conformite ET le bench
# partagent la couverture complete).
BENCH_SPECS="uniform:32000 terrain:32000 eight_clusters:32000 scanline_single_pass:32000 uniform:100000 eight_clusters:100000 uniform:200000 eight_clusters:200000"
QUEUE_FAMILIES="terrain_stationnaire scanline_stationnaire"
QUEUE_N="64000 128000 256000"
QUEUE_SEEDS="3 4 5"
RUN_TIMEOUT=2400
THREADS_VM=48
V5_GATE_MIN=40
V6_GATE_MIN=60
