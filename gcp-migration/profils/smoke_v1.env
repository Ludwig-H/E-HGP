# PROFIL CANONIQUE `smoke_v1` — fumee courte (verification de plomberie,
# jamais une decision) : une famille par phase, petites tailles.
PROFIL_NOM="smoke_v1"
CONF_SPECS="uniform:8000"
BENCH_SPECS="uniform:8000"
QUEUE_FAMILIES="terrain_stationnaire"
QUEUE_N="16000"
QUEUE_SEEDS="3"
RUN_TIMEOUT=1200
THREADS_VM=48
V5_GATE_MIN=40
V6_GATE_MIN=60
# Phases de mesure (fils / GPU / frontiere) : ABSENTES de ce profil
# (sentinelle `aucun` = plan runs=0, phase sautee).
SWEEP_SPECS="aucun"
SWEEP_REPEATS=2
GPU_SPECS="aucun"
FRONTIER_SPECS="aucun"
FRONTIER_TIMEOUT=3600
