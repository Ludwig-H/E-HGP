# PROFIL `g4_tests_v1` — PHASE DE TESTS aux tailles cibles (directive :
# « une fois que tu auras le GPU, fais les tests », « des tests aussi pour
# K=5 (moins lourd) ») : murs CPU du pipeline complet a K=10 (smax=11) ET
# K=5 (smax=6), quatre familles, n in {8000, 16000, 32000, 50000}, reglage de
# debit retenu par le recu serie C (48 fils, inflight 2, join 0), deux
# passages (aller, retour). Fixtures d'egalite : bras --digest a 32000 pour
# les deux K (l'objet K=5 est le prefixe exact de l'objet K=10 — porte
# tower_scope=prefix_k5). Aucune phase differentielle v5 (acquise), aucun
# pilote device (mesure au recu 1788293187) — seulement le build CUDA et
# l'inventaire exact des 16 portes gpu pour garder le device exerce.
PROFIL_NOM="g4_tests_v1"
CONF_SPECS="aucun"
BENCH_SPECS="aucun"
QUEUE_FAMILIES="aucun"
QUEUE_N="64000"
QUEUE_SEEDS="3"
RUN_TIMEOUT=2400
THREADS_VM=48
V5_GATE_MIN=40
V6_GATE_MIN=60
GPU_SPECS="aucun"
SWEEP_SPECS="aucun"
SWEEP_REPEATS=1
FRONTIER_SPECS="aucun"
FRONTIER_TIMEOUT=3600
GPU_BUILD_TIMEOUT=900
FRONTIER_ULIMIT_KB=0
# ---- MATRICE DE TESTS : famille:n:fils:inflight:join:digest[:smax].
# 32 murs (4 familles x 4 tailles x {K=10, K=5}) sans digest, puis 8 bras
# --digest a 32000 (fixtures d'egalite pour les deux K).
MATRICE_POINTS="uniform:8000:48:2:0:sans uniform:16000:48:2:0:sans uniform:32000:48:2:0:sans uniform:50000:48:2:0:sans terrain:8000:48:2:0:sans terrain:16000:48:2:0:sans terrain:32000:48:2:0:sans terrain:50000:48:2:0:sans eight_clusters:8000:48:2:0:sans eight_clusters:16000:48:2:0:sans eight_clusters:32000:48:2:0:sans eight_clusters:50000:48:2:0:sans scanline_single_pass:8000:48:2:0:sans scanline_single_pass:16000:48:2:0:sans scanline_single_pass:32000:48:2:0:sans scanline_single_pass:50000:48:2:0:sans uniform:8000:48:2:0:sans:6 uniform:16000:48:2:0:sans:6 uniform:32000:48:2:0:sans:6 uniform:50000:48:2:0:sans:6 terrain:8000:48:2:0:sans:6 terrain:16000:48:2:0:sans:6 terrain:32000:48:2:0:sans:6 terrain:50000:48:2:0:sans:6 eight_clusters:8000:48:2:0:sans:6 eight_clusters:16000:48:2:0:sans:6 eight_clusters:32000:48:2:0:sans:6 eight_clusters:50000:48:2:0:sans:6 scanline_single_pass:8000:48:2:0:sans:6 scanline_single_pass:16000:48:2:0:sans:6 scanline_single_pass:32000:48:2:0:sans:6 scanline_single_pass:50000:48:2:0:sans:6 uniform:32000:48:2:0:avec terrain:32000:48:2:0:avec eight_clusters:32000:48:2:0:avec scanline_single_pass:32000:48:2:0:avec uniform:32000:48:2:0:avec:6 terrain:32000:48:2:0:avec:6 eight_clusters:32000:48:2:0:avec:6 scanline_single_pass:32000:48:2:0:avec:6"
MATRICE_SEQUENCE="aller retour"
MATRICE_TIMEOUT=2400
# Attribution (mhgp6_profile, K=10 seulement — l'attribution n'a pas d'axe
# smax) : le point 32000 uniform et eight_clusters au reglage retenu.
ATTRIB_POINTS="uniform:32000:48:2:0 eight_clusters:32000:48:2:0"
ATTRIB_TIMEOUT=2400
# ---- Device : build CUDA + inventaire exact des 16 portes gpu, sans pilote.
GPUV6_BUILD_TIMEOUT=900
GPUV6_GATE_TIMEOUT=1800
GPUV6_GATE_NAMES="mhgp6_device_witness mhgp6_device_witness_mutant_carry mhgp6_device_witness_mutant_skip_write mhgp6_device_witness_mutant_skip_native mhgp6_census_device mhgp6_census_device_mutant_range_le mhgp6_census_device_mutant_stack mhgp6_census_device_mutant_swap mhgp6_census_device_mutant_nonstrict mhgp6_census_device_mutant_skip_write mhgp6_census_device_mutant_nshell mhgp6_census_device_mutant_skip_count mhgp6_pilote_parite_400 mhgp6_pilote_refus_n mhgp6_pilote_lot17 mhgp6_pilote_mutant_base"
GPUV6_PILOT_SPECS="aucun"
GPUV6_PILOT_MIN_LOTS=2
GPUV6_PILOT_TIMEOUT=3600
GPUV6_OBJET_DIGESTS="aucun"
BIN_MATRICE="./build-v6/mhgp6"
BIN_ATTRIB="./build-v6/mhgp6_profile"
BIN_PILOTE="./build-v6-cuda/mhgp6_cuda"
# ---- Enveloppe : 5 h GCE (preference § 5.12) / invite 285 min — predicat
# 285*60 + 300 + 120 + 480 = 18000 exactement (budget d'armement 480 s
# apres tolerance) ; fenetre utile 13195 s pour ~8300 s estimes.
SESSION_MAX_RUN_SECONDS=18000
SESSION_INVITE_MINUTES=285
